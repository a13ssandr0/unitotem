#!/bin/bash
# Reports what has changed on the ROOT partition since the image was built, so
# an OTA can say what it is about to destroy instead of destroying it silently.
#
# One file does both halves on purpose. `baseline` runs at build time
# (kiosk/stage3-image.sh, against the freshly assembled image) and `check`
# runs on the device; if the two used separate implementations of "which files
# count" or "how a path is normalised", any drift between them would surface as
# phantom changes on every single device. Same code, same answer.
#
# Scope: only what an OTA actually replaces AND the operator can actually see.
# /etc, /var and /root are excluded because they are overlays backed by DATA
# (kiosk/files/overlayfs-hook.sh) and follow their own rules at deploy time -
# /etc through the ota-preserve.list whitelist, /var reset wholesale. Including
# them would be worse than useless: at build time /var is an ordinary directory
# and at runtime it is an overlay, so every file under it would be reported
# missing on every device.
#
# /var/lib/dpkg is the deliberate exception to that exclusion, and it is not
# scanned as files but read as a database: it is pinned back onto ROOT (see
# overlayfs-hook.sh) precisely so that the package inventory travels with the
# packages.
set -uo pipefail

BASELINE_DIR_DEFAULT=/usr/lib/unitotem/baseline
PROGRESS_FILE=/run/unitotem-ota-changes.progress

# Directories on ROOT that are not overlay-backed. /bin, /sbin and /lib are
# absent because usr-merge makes them symlinks into /usr, which is scanned.
# /mnt is included but -xdev keeps DATA out of it, same for /boot/firmware.
SCAN_DIRS="usr boot opt srv home media mnt"

progress() {
    [ -n "${OTA_CHANGES_PROGRESS:-}" ] || return 0
    printf '%s\n' "$1" > "$PROGRESS_FILE" 2>/dev/null || true
}

die() { echo "unitotem-ota-changes: $*" >&2; exit 2; }

# usr-merge: dpkg records /bin/bash while the file lives at /usr/bin/bash.
# Without this the two sides never line up - measured on hardware, 6681 files
# looked unowned instead of the real 3042.
norm_paths() { sed -E 's#^/(bin|sbin|lib|lib64)/#/usr/\1/#'; }

# Every path any installed package claims, normalised and deduplicated.
owned_paths() {
    local root="$1"
    cat "$root"/var/lib/dpkg/info/*.list 2>/dev/null | norm_paths | sort -u
}

# Every regular file in scope, as an image-absolute path.
scan_files() {
    local root="$1" d
    for d in $SCAN_DIRS; do
        [ -d "$root/$d" ] || continue
        find "$root/$d" -xdev -type f 2>/dev/null
    done | sed "s#^${root}##" | norm_paths | sort -u
}

# Files in scope that belong to no package. These are what stage2 installs by
# hand (units, helper scripts) plus anything an operator later drops in.
unowned_files() {
    local root="$1"
    comm -23 <(scan_files "$root") <(owned_paths "$root")
}

sha_of() {
    local root="$1" rel
    while IFS= read -r rel; do
        [ -f "$root$rel" ] || continue
        # TAB, not spaces: a path with a space in it was being truncated at
        # the first one, so a tampered "/opt/x/file con spazi" was reported as
        # "/opt/x/file". Everything after the first TAB is the path.
        printf '%s\t%s\n' "$(sha256sum "$root$rel" 2>/dev/null | cut -d' ' -f1)" "$rel"
    done
}

pkg_list() {
    local root="$1"
    dpkg-query --admindir="$root/var/lib/dpkg" -W \
        -f '${Package}\t${Version}\t${Architecture}\n' 2>/dev/null | sort
}

# ---------------------------------------------------------------------------
# baseline: run at build time against the assembled image.
# ---------------------------------------------------------------------------
cmd_baseline() {
    # have_root, not [ -n "$root" ]: stripping the trailing slash turns the
    # perfectly valid "--root /" into an empty string, which is also exactly
    # the value the internals use to mean "the running system".
    local root="" out="" have_root=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --root) root="${2%/}"; have_root=1; shift 2 ;;
            --out)  out="${2%/}"; shift 2 ;;
            *) die "opzione sconosciuta: $1" ;;
        esac
    done
    [ "$have_root" = 1 ] || die "--root richiesto"
    [ -n "$out" ] || die "--out richiesto"
    [ -d "$root/var/lib/dpkg" ] || die "$root non sembra un rootfs Debian"

    mkdir -p "$out"
    pkg_list "$root" > "$out/packages"

    # The baseline cannot contain its own hashes: the files are written into
    # the very tree being hashed, so anything under $out is excluded here and
    # the check side excludes it too.
    local outrel="${out#"$root"}"
    unowned_files "$root" | grep -v "^${outrel}/" | sha_of "$root" > "$out/unowned.sha256"

    # Deviations already present in a pristine image - stage2 overwrites a few
    # conffiles that packages also ship, so dpkg considers them modified from
    # the moment the image is built. Captured here so the check subtracts them
    # instead of blaming an operator for them. Best-effort: on a cross-arch
    # build the chroot may not run, and an empty file simply means nothing is
    # subtracted (the scope filter alone already removed /etc and /var noise).
    if chroot "$root" dpkg -V > "$out/verify-expected.raw" 2>/dev/null; then
        scope_filter < "$out/verify-expected.raw" > "$out/verify-expected"
    else
        : > "$out/verify-expected"
    fi
    rm -f "$out/verify-expected.raw"

    {
        echo "format=1"
        echo "packages=$(wc -l < "$out/packages")"
        echo "unowned=$(wc -l < "$out/unowned.sha256")"
        echo "scan_dirs=${SCAN_DIRS}"
    } > "$out/meta"

    echo "baseline: $(wc -l < "$out/packages") pacchetti, $(wc -l < "$out/unowned.sha256") file non posseduti"
}

# dpkg -V prints "<flags> <path>" or "<flags> c <path>" for conffiles. Keep
# only paths inside the scanned scope: that alone discards the /etc conffile
# noise and the /var/cache entries that read as "missing" because those are
# tmpfs at runtime.
scope_filter() {
    local d pattern=""
    for d in $SCAN_DIRS; do pattern="${pattern}|^/${d}/"; done
    pattern="${pattern#|}"
    # Strip dpkg -V's leading flag column (and the "c" conffile marker) rather
    # than taking the last field: $NF would cut a path containing spaces.
    sed -E 's/^[^ ]+ +(c +)?//' | norm_paths | grep -E "$pattern" | sort -u
}

# ---------------------------------------------------------------------------
# check: run on the device.
# ---------------------------------------------------------------------------
cmd_check() {
    local as_json=0 baseline="$BASELINE_DIR_DEFAULT"
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) as_json=1; shift ;;
            --baseline) baseline="${2%/}"; shift 2 ;;
            *) die "opzione sconosciuta: $1" ;;
        esac
    done
    [ -d "$baseline" ] || die "baseline assente in $baseline (immagine costruita senza?)"

    # Global, not local: the EXIT trap fires after the function has returned,
    # when a local would be out of scope - and under `set -u` that turns the
    # cleanup into an "unbound variable" error on every successful run.
    CHECK_TMP=$(mktemp -d) || die "mktemp fallito"
    trap 'rm -rf "${CHECK_TMP:-}"' EXIT
    local tmp="$CHECK_TMP"

    progress "Confronto i pacchetti installati"
    pkg_list "" > "$tmp/packages.now"
    # Added/removed by name; upgraded = same name, different version.
    cut -f1 "$baseline/packages" | sort -u > "$tmp/names.base"
    cut -f1 "$tmp/packages.now"  | sort -u > "$tmp/names.now"
    comm -13 "$tmp/names.base" "$tmp/names.now" > "$tmp/pkg.added"
    comm -23 "$tmp/names.base" "$tmp/names.now" > "$tmp/pkg.removed"
    awk -F'\t' 'NR==FNR{v[$1]=$2; next} ($1 in v) && v[$1]!=$2 {print $1"\t"v[$1]"\t"$2}' \
        "$baseline/packages" "$tmp/packages.now" | sort > "$tmp/pkg.changed"

    progress "Verifico l'integrita' dei file di pacchetto"
    dpkg -V 2>/dev/null | scope_filter > "$tmp/verify.now"
    comm -23 "$tmp/verify.now" "$baseline/verify-expected" > "$tmp/pkgfiles.modified"

    progress "Confronto i file non appartenenti a pacchetti"
    local outrel="${baseline}"
    unowned_files "" | grep -v "^${outrel}/" | sha_of "" > "$tmp/unowned.now"
    # Compare by path first so added/removed/modified are distinguishable.
    cut -f2- "$baseline/unowned.sha256" | sort > "$tmp/un.base.paths"
    cut -f2- "$tmp/unowned.now"         | sort > "$tmp/un.now.paths"
    comm -13 "$tmp/un.base.paths" "$tmp/un.now.paths" > "$tmp/unowned.added"
    comm -23 "$tmp/un.base.paths" "$tmp/un.now.paths" > "$tmp/unowned.removed"
    awk -F'\t' 'NR==FNR{h[$2]=$1; next} ($2 in h) && h[$2]!=$1 {print $2}' \
        "$baseline/unowned.sha256" "$tmp/unowned.now" | sort > "$tmp/unowned.modified"

    # Attribution. A file that belongs to a package which was itself added or
    # upgraded is explained by that operation; the same file changing under a
    # package that did not move is not. Without this split, a routine
    # `apt install` would look identical to someone editing a binary in place,
    # which is exactly the distinction the confirmation prompt is built on.
    progress "Attribuisco le modifiche"
    cat "$tmp/pkg.added" <(cut -f1 "$tmp/pkg.changed") | sort -u > "$tmp/pkg.touched"
    : > "$tmp/paths.touched"
    if [ -s "$tmp/pkg.touched" ]; then
        local p
        while IFS= read -r p; do
            [ -f "/var/lib/dpkg/info/${p}.list" ] && cat "/var/lib/dpkg/info/${p}.list"
            [ -f "/var/lib/dpkg/info/${p}:$(dpkg --print-architecture).list" ] \
                && cat "/var/lib/dpkg/info/${p}:$(dpkg --print-architecture).list"
        done < "$tmp/pkg.touched" | norm_paths | sort -u > "$tmp/paths.touched"
    fi
    # Regenerating the initramfs is what `kiosk-update exit --initramfs` does,
    # so it is a consequence of the package work rather than an unexplained
    # edit. Same for the linker cache.
    side_effect() { grep -Eq '^/boot/(initrd\.img|vmlinuz)|^/usr/lib/modules/' <<< "$1"; }

    : > "$tmp/unexplained"
    local f
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        if grep -qxF "$f" "$tmp/paths.touched" 2>/dev/null || side_effect "$f"; then continue; fi
        printf '%s\n' "$f" >> "$tmp/unexplained"
    done < <(cat "$tmp/pkgfiles.modified" "$tmp/unowned.added" "$tmp/unowned.removed" "$tmp/unowned.modified" | sort -u)

    local n_pkg n_unexp verdict
    n_pkg=$(( $(wc -l < "$tmp/pkg.added") + $(wc -l < "$tmp/pkg.removed") + $(wc -l < "$tmp/pkg.changed") ))
    n_unexp=$(wc -l < "$tmp/unexplained")
    if [ "$n_pkg" -eq 0 ] && [ "$n_unexp" -eq 0 ]; then verdict=clean
    elif [ "$n_unexp" -eq 0 ]; then verdict=packages-only
    else verdict=mixed
    fi

    # The digest covers exactly what gets shown to the operator, so a deploy
    # confirmed against it cannot silently proceed over a different set of
    # changes than the one that was approved.
    local digest
    digest=$( { cat "$tmp/pkg.added" "$tmp/pkg.removed" "$tmp/pkg.changed" "$tmp/unexplained"; } \
        | sha256sum | cut -d' ' -f1)

    progress "Fatto"
    if [ "$as_json" = 1 ]; then
        emit_json "$tmp" "$verdict" "$digest"
    else
        emit_text "$tmp" "$verdict" "$digest"
    fi
    [ "$verdict" = clean ] && return 0 || return 1
}

json_str() {
    local s="$1"
    s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
    printf '"%s"' "$s"
}

json_array_from_file() {
    local first=1 line
    printf '['
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        [ "$first" = 1 ] || printf ','
        first=0
        json_str "$line"
    done < "$1"
    printf ']'
}

json_pkg_array() {
    local first=1 name from to
    printf '['
    while IFS=$'\t' read -r name from to; do
        [ -n "$name" ] || continue
        [ "$first" = 1 ] || printf ','
        first=0
        printf '{"name":%s' "$(json_str "$name")"
        [ -n "${from:-}" ] && printf ',"from":%s' "$(json_str "$from")"
        [ -n "${to:-}" ] && printf ',"to":%s' "$(json_str "$to")"
        printf '}'
    done < "$1"
    printf ']'
}

emit_json() {
    local t="$1" verdict="$2" digest="$3"
    printf '{"verdict":%s,"digest":%s,"packages":{' "$(json_str "$verdict")" "$(json_str "$digest")"
    printf '"added":%s,' "$(json_array_from_file "$t/pkg.added")"
    printf '"removed":%s,' "$(json_array_from_file "$t/pkg.removed")"
    printf '"changed":%s},' "$(json_pkg_array "$t/pkg.changed")"
    printf '"files":{"unexplained":%s,' "$(json_array_from_file "$t/unexplained")"
    printf '"package_files_modified":%s,' "$(json_array_from_file "$t/pkgfiles.modified")"
    printf '"unowned_added":%s,' "$(json_array_from_file "$t/unowned.added")"
    printf '"unowned_removed":%s,' "$(json_array_from_file "$t/unowned.removed")"
    printf '"unowned_modified":%s}}\n' "$(json_array_from_file "$t/unowned.modified")"
}

emit_text() {
    local t="$1" verdict="$2" digest="$3"
    echo "Esito: $verdict"
    echo "Digest: $digest"
    if [ -s "$t/pkg.added" ];   then echo; echo "Pacchetti installati:"; sed 's/^/  + /' "$t/pkg.added"; fi
    if [ -s "$t/pkg.removed" ]; then echo; echo "Pacchetti rimossi:";    sed 's/^/  - /' "$t/pkg.removed"; fi
    if [ -s "$t/pkg.changed" ]; then echo; echo "Pacchetti aggiornati:";
        awk -F'\t' '{printf "  ~ %s (%s -> %s)\n", $1, $2, $3}' "$t/pkg.changed"; fi
    if [ -s "$t/unexplained" ]; then echo; echo "File modificati NON spiegati da operazioni sui pacchetti:";
        sed 's/^/  ! /' "$t/unexplained"; fi
    [ "$verdict" = clean ] && { echo; echo "Nessuna modifica rispetto all'immagine."; }
}

case "${1:-}" in
    baseline) shift; cmd_baseline "$@" ;;
    check)    shift; cmd_check "$@" ;;
    *) echo "Uso: unitotem-ota-changes {baseline --root DIR --out DIR | check [--json]}" >&2; exit 2 ;;
esac
