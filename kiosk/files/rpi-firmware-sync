#!/bin/sh
# Kernel postinst hook (arm64 only): keeps /boot/firmware/kernel8.img,
# initramfs8 and the bcm27*.dtb files in sync with whatever kernel is
# actually installed. Without this, the *next* kiosk-update (which runs
# `update-initramfs -u -k all`, see kiosk/files/kiosk-update) would silently
# leave the OLD kernel8.img/initramfs8 in place while /boot/vmlinuz-*
# advances - putting the Pi right back into the exact "kernel present,
# firmware doesn't know about it" state the OTA redesign plan's Step 0
# fixed by hand. See that plan's "avviabilita' del Pi" section.
set -e

kernel_version="$1"
image_path="$2"

case "$DEB_MAINT_PARAMS" in
    *configure*) ;;
    *) exit 0 ;;
esac

case "$kernel_version" in *-arm64) ;; *) exit 0 ;; esac
[ -d /boot/firmware ] || exit 0

cp "$image_path" /boot/firmware/kernel8.img

initrd="/boot/initrd.img-${kernel_version}"
[ -f "$initrd" ] && cp "$initrd" /boot/firmware/initramfs8

dtb_dir="/usr/lib/linux-image-${kernel_version}/broadcom"
if [ -d "$dtb_dir" ]; then
    cp "$dtb_dir"/bcm27*.dtb /boot/firmware/ 2>/dev/null || true
fi

sync
