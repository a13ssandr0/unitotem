# iocharset=iso8859-1 explicit: without it, vfat falls back to the kernel's
# default ("ascii") iocharset, which needs the separate nls_ascii module
# on-demand-loaded - confirmed failing for real on real hardware
# (boot-firmware.mount stuck "failed", dropping to the emergency shell,
# "FAT-fs: IO charset ascii not found" in dmesg), even though the module
# exists in the kernel package - this is the real rootfs's own fstab-driven
# mount, a different context from the initramfs's copy (already fixed
# separately via manual_add_modules in kiosk/files/ota-hook, which only
# covers the initramfs module set, not this).
LABEL=FIRMWARE /boot/firmware vfat  defaults,noatime,iocharset=iso8859-1 0 2
LABEL=ROOT     /              ext4  defaults,noatime,ro                 0 1
tmpfs          /tmp           tmpfs defaults,noatime,nosuid,nodev,size=256M  0 0
tmpfs          /run           tmpfs defaults,noatime,nosuid,nodev,mode=0755  0 0
tmpfs          /var/cache     tmpfs defaults,noatime,nosuid,nodev,size=512M  0 0
tmpfs          /var/tmp       tmpfs defaults,noatime,nosuid,nodev,size=64M   0 0
# See fstab-amd64 for why this is NOT a blanket /var/lib tmpfs (dpkg's
# database would come up empty every boot) - only the runtime state
# directories confirmed broken by the read-only root in a real boot test.
tmpfs          /var/lib/NetworkManager tmpfs defaults,noatime,nosuid,nodev,size=16M  0 0
tmpfs          /var/lib/dhcp           tmpfs defaults,noatime,nosuid,nodev,size=8M   0 0
tmpfs          /var/lib/systemd        tmpfs defaults,noatime,nosuid,nodev,size=16M  0 0
tmpfs          /var/lib/haproxy        tmpfs defaults,noatime,nosuid,nodev,size=8M   0 0
