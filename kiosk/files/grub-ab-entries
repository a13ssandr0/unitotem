#!/bin/sh
exec tail -n +3 "$0"
# UniTotem A/B: two static entries, one per ROOT slot, found by filesystem label (the label is
# set per slot, see unitotem-update; partclone copies the label with the data so the update
# tool relabels after writing). Installed by kiosk/stage2-configure.sh at
# /etc/grub.d/10_unitotem_ab. 'saved_entry' in grubenv picks the default; grub-reboot sets a
# one-shot trial entry that GRUB clears before booting it, so a power cut or a crash during a
# trial returns to the default slot with no software involved.
# Low resolution for every OTA entry (the screens must be readable from far away on 1080p/4K monitors): GRUB switches the
# firmware framebuffer (UEFI GOP / BIOS VBE) to the first mode of gfxmode that exists and gfxpayload=keep hands exactly that to
# the kernel; nomodeset stops the DRM drivers (i915, amdgpu, nouveau, ...) from taking over at the monitor's native size, so
# the console and /dev/fb0 stay at that mode. The OTA environment needs only a console and the network. 640x480 first, so a
# firmware without it lands on the next smallest instead of the native mode.
function unitotem_lowres {
    insmod all_video
    insmod gfxterm
    set gfxmode=640x480x32,640x480,800x600x32,800x600,1024x768x32,1024x768,auto
    terminal_output gfxterm
    set gfxpayload=keep
}
menuentry 'UniTotem slot A' --id slot-a {
    insmod part_gpt
    insmod ext2
    search --no-floppy --set=root --label ROOT_A
    linux /vmlinuz root=LABEL=ROOT_A ro quiet splash loglevel=3 console=tty0 console=ttyS0,115200n8 rd.systemd.show_status=false systemd.show_status=false unitotem.slot=a
    initrd /initrd.img
}
menuentry 'UniTotem slot B' --id slot-b {
    insmod part_gpt
    insmod ext2
    search --no-floppy --set=root --label ROOT_B
    linux /vmlinuz root=LABEL=ROOT_B ro quiet splash loglevel=3 console=tty0 console=ttyS0,115200n8 rd.systemd.show_status=false systemd.show_status=false unitotem.slot=b
    initrd /initrd.img
}
menuentry 'UniTotem slot A (OTA recovery)' --id slot-a-recover {
    insmod part_gpt
    insmod ext2
    unitotem_lowres
    search --no-floppy --set=root --label ROOT_A
    linux /vmlinuz root=LABEL=ROOT_A ro quiet nomodeset unitotem.ota=recover unitotem.slot=a
    initrd /initrd.img
}
menuentry 'UniTotem slot B (OTA recovery)' --id slot-b-recover {
    insmod part_gpt
    insmod ext2
    unitotem_lowres
    search --no-floppy --set=root --label ROOT_B
    linux /vmlinuz root=LABEL=ROOT_B ro quiet nomodeset unitotem.ota=recover unitotem.slot=b
    initrd /initrd.img
}
# The resident fallback on the ESP. Deliberately LAST: when grubenv is unreadable (a torn write) GRUB
# falls back to entry 0, and a working slot is a far better outcome than a fallback that waits for a host.
# Deploys select it explicitly through saved_entry=ota-recovery, so its position does not matter there. During a deploy saved_entry points here, and the system under test is
# booted one-shot through next_entry, so any failure of that boot lands in the fallback by itself.
menuentry 'UniTotem OTA fallback' --id ota-recovery {
    insmod part_gpt
    insmod fat
    unitotem_lowres
    search --no-floppy --set=root --label EFI
    linux /unitotem/recovery-vmlinuz nomodeset unitotem.ota=1 console=tty0 console=ttyS0,115200
    initrd /unitotem/recovery-initrd.img
}
