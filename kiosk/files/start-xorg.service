[Unit]
Description=X11 session (kiosk)
After=multi-user.target

[Service]
TTYPath=/dev/tty8
StandardInput=tty
StandardOutput=journal
UnsetEnvironment=TERM
# startx/xinit only fall back to $HOME/.Xauthority when $XAUTHORITY isn't
# already set - and $HOME/.Xauthority is unwritable on this image's
# read-only root, which made xinit retry X connections forever with no
# valid cookie and never launch xinitrc (start-xorg.service looked
# "active" the whole time - only unitotem-manager.service, unable to
# connect, crash-looped with SIGABRT). Pointing XAUTHORITY at this fixed
# tmpfs path makes xinit populate it directly; it's the same path
# unitotem-manager.service's own Environment=XAUTHORITY= reads (see
# unitotem-manager.service and xinitrc), so no copy step is needed.
Environment=XAUTHORITY=/run/unitotem-x11.auth

ExecStartPre=/usr/bin/chvt 8
ExecStart=/usr/bin/startx /etc/kiosk/xinitrc -- vt8 -keeptty -nocursor -verbose 3 -logfile /dev/null
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
