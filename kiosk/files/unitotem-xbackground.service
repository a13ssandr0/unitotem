[Unit]
Description=UniTotem placeholder screen (X root window)
After=start-xorg.service
# Restarted together with the X server (its window/pixmap die with it).
PartOf=start-xorg.service
StartLimitIntervalSec=0

[Service]
Environment=DISPLAY=:0
Environment=XAUTHORITY=/run/unitotem-x11.auth
# Wait (up to 2 minutes) for the X socket; the program itself exits if it cannot connect, and Restart= tries again.
ExecStartPre=/bin/sh -c 'i=0; while [ ! -S /tmp/.X11-unix/X0 ] && [ $i -lt 600 ]; do sleep 0.2; i=$((i+1)); done'
ExecStart=/usr/bin/python3 /usr/sbin/unitotem-xbackground
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
