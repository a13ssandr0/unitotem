#!/usr/bin/env python3
"""UniTotem X11 background: the placeholder screen that is visible whenever nothing covers the X root window - above all when
the manager is missing, not running, or not showing anything. It is the X background itself, so there is no mode to switch and
nothing to start: the manager's viewer window simply hides it when it works.

It is unmistakable on purpose (the UniTotem logo and a green banner "BOOT OK - VIDEO OUTPUT WORKS", then the facts one needs on
site: manager state, health, addresses, slot, release, uptime) so that "the board booted and the display works" cannot be
confused with the boot animation, the OTA screen or a black screen. Started by /etc/kiosk/xinitrc.

Standard library only: libX11 through ctypes, the pre-rendered logo blobs (tools/gen-logo.py), and the console PSF fonts for the
text (DejaVu Bold, picked from the screen width so the text spans ~60 columns on 1080p and 4K alike).
"""
import ctypes, ctypes.util, gzip, os, ssl, struct, subprocess, sys, time, urllib.request

LOGO_DIR = os.environ.get("XBG_LOGO_DIR", "/usr/lib/unitotem")
FONT_DIR = os.environ.get("XBG_FONT_DIR", "/usr/share/consolefonts")
HEALTH_URL = os.environ.get("XBG_HEALTH_URL", "https://localhost/health")
POLL = int(os.environ.get("XBG_POLL", "5"))

BLACK = (0, 0, 0); WHITE = (255, 255, 255); GREY = (190, 190, 190); GREEN = (0, 170, 0)
FONT_SIZES = ((16, 30), (20, 36), (24, 43), (28, 51), (32, 59), (40, 74), (48, 89), (64, 118))   # (cell width, cell height)


def load_psf(path):
    """-> (glyph dict: char code -> list of row bitmasks, width, height). Glyph N is char N for ASCII in the Lat15 fonts."""
    data = gzip.open(path).read() if path.endswith(".gz") else open(path, "rb").read()
    if data[:4] == b"\x72\xb5\x4a\x86":                                   # PSF2
        _, _, hdr, _, count, charsize, height, width = struct.unpack("<8I", data[:32])
        rowb = (width + 7) // 8
        glyphs = {}
        for c in range(32, 127):
            off = hdr + c * charsize
            glyphs[c] = [int.from_bytes(data[off + r * rowb: off + (r + 1) * rowb], "big") for r in range(height)]
        return glyphs, width, height, rowb
    if data[:2] == b"\x36\x04":                                           # PSF1 (8 px wide)
        charsize = data[3]
        glyphs = {c: [data[4 + c * charsize + r] for r in range(charsize)] for c in range(32, 127)}
        return glyphs, 8, charsize, 1
    raise ValueError("not a PSF font: " + path)


class Screen:
    def __init__(self):
        x = ctypes.CDLL(ctypes.util.find_library("X11") or "libX11.so.6")
        self.x = x
        x.XOpenDisplay.restype = ctypes.c_void_p; x.XOpenDisplay.argtypes = [ctypes.c_char_p]
        self.dpy = x.XOpenDisplay(None)
        if not self.dpy:
            raise SystemExit("unitotem-xbackground: cannot open the X display")
        d = ctypes.c_void_p(self.dpy)
        x.XDefaultScreen.argtypes = [ctypes.c_void_p]; scr = x.XDefaultScreen(d)
        x.XDefaultRootWindow.restype = ctypes.c_ulong; x.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
        self.root = x.XDefaultRootWindow(d)
        for fn in ("XDisplayWidth", "XDisplayHeight", "XDefaultDepth"):
            getattr(x, fn).argtypes = [ctypes.c_void_p, ctypes.c_int]
        self.w, self.h, self.depth = x.XDisplayWidth(d, scr), x.XDisplayHeight(d, scr), x.XDefaultDepth(d, scr)
        x.XDefaultVisual.restype = ctypes.c_void_p; x.XDefaultVisual.argtypes = [ctypes.c_void_p, ctypes.c_int]
        self.visual = x.XDefaultVisual(d, scr)
        x.XCreatePixmap.restype = ctypes.c_ulong
        x.XCreatePixmap.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_uint, ctypes.c_uint, ctypes.c_uint]
        self.pix = x.XCreatePixmap(d, self.root, self.w, self.h, self.depth)
        x.XCreateGC.restype = ctypes.c_void_p; x.XCreateGC.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_void_p]
        self.gc = x.XCreateGC(d, self.pix, 0, None)
        self.buf = (ctypes.c_ubyte * (self.w * self.h * 4))()               # B, G, R, X per pixel, filled black
        x.XCreateImage.restype = ctypes.c_void_p
        x.XCreateImage.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_uint, ctypes.c_int, ctypes.c_int, ctypes.c_void_p,
                                   ctypes.c_uint, ctypes.c_uint, ctypes.c_int, ctypes.c_int]
        self.img = x.XCreateImage(d, ctypes.c_void_p(self.visual), self.depth, 2, 0, ctypes.cast(self.buf, ctypes.c_void_p),
                                  self.w, self.h, 32, 0)
        x.XPutImage.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int, ctypes.c_int,
                                ctypes.c_int, ctypes.c_int, ctypes.c_uint, ctypes.c_uint]
        x.XSetWindowBackgroundPixmap.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong]
        x.XClearWindow.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
        x.XFlush.argtypes = [ctypes.c_void_p]
        self.mv = memoryview(self.buf).cast("B")

    # ---- drawing into the shared buffer -------------------------------------------------------------------------
    def rect(self, x0, y0, w, h, rgb):
        px = bytes((rgb[2], rgb[1], rgb[0], 0)) * w
        for y in range(y0, min(y0 + h, self.h)):
            o = (y * self.w + x0) * 4
            self.mv[o:o + w * 4] = px

    def blit_rows(self, x0, y0, w, data, h):    # data: h rows of w*4 bytes
        for r in range(h):
            o = ((y0 + r) * self.w + x0) * 4
            self.mv[o:o + w * 4] = data[r * w * 4:(r + 1) * w * 4]

    def push(self, x0, y0, w, h):               # send a rectangle to the pixmap and make it the root background
        d = ctypes.c_void_p(self.dpy)
        self.x.XPutImage(d, self.pix, ctypes.c_void_p(self.gc), ctypes.c_void_p(self.img), x0, y0, x0, y0, w, h)
        self.x.XSetWindowBackgroundPixmap(d, self.root, self.pix)
        self.x.XClearWindow(d, self.root)
        self.x.XFlush(d)


class Text:
    def __init__(self, scr, font):
        self.scr = scr
        self.glyphs, self.gw, self.gh, self.rowb = load_psf(font)
        self.cache = {}

    def cols(self):
        return self.scr.w // self.gw

    def glyph_rows(self, c, fg, bg):
        k = (c, fg, bg)
        if k not in self.cache:
            on = bytes((fg[2], fg[1], fg[0], 0)); off = bytes((bg[2], bg[1], bg[0], 0)); rows = []
            for mask in self.glyphs.get(c, self.glyphs[32]):
                rows.append(b"".join(on if mask >> (self.rowb * 8 - 1 - i) & 1 else off for i in range(self.gw)))
            self.cache[k] = rows
        return self.cache[k]

    def line(self, row_px, text, fg, bg=BLACK, bar=False):
        """Centered text on the pixel row; the whole row is repainted (bar: full width in bg colour). Returns the rect pushed."""
        scr = self.scr
        scr.rect(0, row_px, scr.w, self.gh, bg if bar else BLACK)
        x0 = max(0, (scr.w - len(text) * self.gw) // 2)
        for i, ch in enumerate(text):
            rows = self.glyph_rows(ord(ch) if 32 <= ord(ch) < 127 else 63, fg, bg if bar else BLACK)
            for r in range(self.gh):
                o = ((row_px + r) * scr.w + x0 + i * self.gw) * 4
                scr.mv[o:o + self.gw * 4] = rows[r]
        return (0, row_px, scr.w, self.gh)


def facts():
    def run(*a):
        try:
            return subprocess.run(a, capture_output=True, text=True, timeout=4).stdout.strip()
        except Exception:
            return ""
    ver = run("dpkg-query", "-W", "-f=${Version}", "unitotem-manager")
    state = run("systemctl", "is-active", "unitotem-manager") if ver else "not installed"
    try:
        ctx = ssl.create_default_context(); ctx.check_hostname = False; ctx.verify_mode = ssl.CERT_NONE
        health = "ok" if urllib.request.urlopen(HEALTH_URL, timeout=3, context=ctx).status == 200 else "no answer"
    except Exception:
        health = "no answer"
    ips = " ".join(l.split()[3].split("/")[0] for l in run("ip", "-4", "-o", "addr", "show", "scope", "global").splitlines() if l.split()[3:]) or "none"
    slot = next((t.split("=")[1] for t in open("/proc/cmdline").read().split() if t.startswith("unitotem.slot=")), "?")
    try: rel = open("/usr/share/unitotem/release-version").read().strip()
    except OSError: rel = "?"
    up = int(float(open("/proc/uptime").read().split()[0]))
    return ver, state, health, ips, slot, rel, up


def main():
    scr = Screen()
    if scr.depth not in (24, 32):
        raise SystemExit("unitotem-xbackground: unsupported X depth %d" % scr.depth)
    cw, ch = next(((w, h) for w, h in reversed(FONT_SIZES) if scr.w // w >= 56), FONT_SIZES[0])
    try:
        txt = Text(scr, os.path.join(FONT_DIR, "Lat15-DejaVuBold%dx%d.psf.gz" % (ch, cw)))
    except Exception as e:
        raise SystemExit("unitotem-xbackground: no usable font (%s)" % e)
    lw, lh = (1280, 365) if scr.w >= 3000 else ((640, 182) if scr.w >= 1500 else (256, 73))
    logo_y = txt.gh
    try:
        blob = open(os.path.join(LOGO_DIR, "unitotem-logo-%dx%d.bgrx" % (lw, lh)), "rb").read()
        scr.blit_rows((scr.w - lw) // 2, logo_y, lw, blob, lh)
    except OSError:
        pass                                                         # no logo file: the text alone still identifies the screen
    row0 = (logo_y + lh) // txt.gh + 3
    y = lambda n: (row0 + n) * txt.gh
    txt.line(y(0), "BOOT OK  -  VIDEO OUTPUT WORKS", WHITE, GREEN, bar=True)
    scr.push(0, 0, scr.w, scr.h)
    last = None
    while True:
        ver, state, health, ips, slot, rel, up = facts()
        lines = [(y(2), "The system started correctly and the display works.", WHITE),
                 (y(3), "The UniTotem manager is not installed." if not ver else "The UniTotem manager is not showing anything yet.", WHITE),
                 (y(5), "manager: %s    health: %s" % (state or "unknown", health), GREY),
                 (y(6), "address: %s" % ips, GREY),
                 (y(7), "slot %s    release %s    uptime %ds" % (slot, rel, up), GREY)]
        for ypx, text, fg in lines:
            txt.line(ypx, text, fg)
        scr.push(0, y(2), scr.w, y(8) - y(2))
        time.sleep(POLL)


if __name__ == "__main__":
    main()
