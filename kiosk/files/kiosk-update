#!/bin/bash
set -e

# The units that actually own the screen on this image. This used to be a
# single `pkill -x sway`, which stopped nothing at all: there is no sway here
# (bare Xorg, no window manager - see kiosk/stage1-packages.sh for why), so
# the kiosk kept running through the whole update while this script reported
# "Fermo il kiosk...". Confirmed on hardware: Xorg was still up after `enter`.
#
# systemctl stop, not pkill: start-xorg.service is Restart=always, so killing
# the process just brings it straight back. Stopping the unit is the only
# thing that holds.
KIOSK_UNITS="unitotem-manager.service start-xorg.service"

_enter() {
    echo "[kiosk-update] Fermo il kiosk..."
    local u failed=""
    for u in $KIOSK_UNITS; do
        systemctl stop "$u" 2>/dev/null || true
    done
    # Verified rather than assumed: an update that runs while the kiosk still
    # holds the display is exactly the situation this step exists to prevent,
    # and it failed silently for as long as the pkill was there.
    for u in $KIOSK_UNITS; do
        if systemctl is-active --quiet "$u"; then
            failed="${failed} ${u}"
        fi
    done
    if [ -n "$failed" ]; then
        echo "[kiosk-update] ERRORE: non sono riuscito a fermare:${failed}" >&2
        echo "[kiosk-update] Interrompo: aggiornare con il kiosk attivo non e' sicuro." >&2
        exit 1
    fi

    echo "[kiosk-update] Rimonto rootfs in rw..."
    mount -o remount,rw /
    # /var/lib/dpkg is a bind mount back onto ROOT (see
    # kiosk/files/overlayfs-hook.sh) and a bind carries its OWN flags: it stays
    # read-only when / is remounted rw. Without this, apt reports "Not using
    # locking for read only lock file /var/lib/dpkg/lock" and dpkg cannot
    # update the database at all - confirmed on hardware, where / showed rw
    # and /var/lib/dpkg showed ro at the same moment.
    mountpoint -q /var/lib/dpkg && mount -o remount,rw /var/lib/dpkg
    mount -o remount,size=1G /var/cache

    # The package lists live on the DATA overlay and an OTA resets them, so a
    # freshly deployed device has none and every install fails with "Unable to
    # locate package". Refreshing here costs one download and removes a
    # confusing first-use failure.
    echo "[kiosk-update] Aggiorno gli elenchi dei pacchetti..."
    apt-get update -qq || echo "[kiosk-update] ATTENZIONE: apt-get update fallito, gli elenchi potrebbero essere incompleti" >&2

    echo "[kiosk-update] Pronti."
    echo "  /etc  /root       → overlay su DATA (sempre persistente)"
    echo "  /usr  /lib  /bin  → rootfs (ora scrivibile)"
    echo ""
    echo "Eseguire: apt-get update && apt-get upgrade"
    echo "Al termine: kiosk-update exit [--initramfs]"
}

_exit() {
    local regen_initramfs=0
    [ "$1" = "--initramfs" ] && regen_initramfs=1

    if [ $regen_initramfs -eq 1 ]; then
        echo "[kiosk-update] Rigenero initramfs..."
        update-initramfs -u -k all
    fi

    if command -v update-grub &>/dev/null; then
        update-grub 2>/dev/null || true
    fi

    echo "[kiosk-update] Rimonto rootfs in ro..."
    sync
    # Same asymmetry as on the way in: the bind has to be told separately, or
    # the package database would stay writable on an otherwise read-only root.
    mountpoint -q /var/lib/dpkg && mount -o remount,ro /var/lib/dpkg 2>/dev/null || true
    mount -o remount,ro / 2>/dev/null || true

    echo "[kiosk-update] Riavvio in 5 secondi..."
    sleep 5
    systemctl reboot
}

case "$1" in
    enter) _enter ;;
    exit)  _exit "${2:-}" ;;
    *)
        echo "Uso: $0 enter | exit [--initramfs]"
        exit 1
        ;;
esac
