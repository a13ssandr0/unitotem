# iocharset=iso8859-1 explicit: avoids depending on the kernel's on-demand
# nls_ascii module load for the default iocharset - confirmed failing for
# real on arm64 (kiosk/files/fstab-arm64 has the full incident detail);
# not yet observed here, but the same latent gap applies equally to amd64's
# EFI mount, so fixed preemptively rather than waiting to hit it live.
LABEL=EFI   /boot/efi  vfat  defaults,noatime,iocharset=iso8859-1        0 2
LABEL=BOOT  /boot      ext4  defaults,noatime                           0 2
LABEL=ROOT  /          ext4  defaults,noatime,ro                        0 1
tmpfs       /tmp       tmpfs defaults,noatime,nosuid,nodev,size=256M    0 0
tmpfs       /run       tmpfs defaults,noatime,nosuid,nodev,mode=0755    0 0
tmpfs       /var/cache tmpfs defaults,noatime,nosuid,nodev,size=512M    0 0
tmpfs       /var/tmp   tmpfs defaults,noatime,nosuid,nodev,size=64M     0 0
# NOT a blanket /var/lib tmpfs: /var/lib/dpkg's database is populated at
# build time and must reflect the real installed-package set (OTA updates
# replace whole partitions, never `apt install` at runtime, so dpkg's state
# never needs to be *written* here - but it does need to still be *readable*,
# which a blank tmpfs would break). Only the specific runtime state
# directories that were confirmed broken by the read-only root (real boot
# test: NetworkManager couldn't persist its secret key or DHCP lease,
# staying network-unreachable every boot) get their own tmpfs.
tmpfs       /var/lib/NetworkManager tmpfs defaults,noatime,nosuid,nodev,size=16M  0 0
tmpfs       /var/lib/dhcp           tmpfs defaults,noatime,nosuid,nodev,size=8M   0 0
tmpfs       /var/lib/systemd        tmpfs defaults,noatime,nosuid,nodev,size=16M  0 0
tmpfs       /var/lib/haproxy        tmpfs defaults,noatime,nosuid,nodev,size=8M   0 0
