# Whitelist of paths re-imported from DATA's old /etc overlay after an OTA
# update - read by deploy/ota-engine.sh's migrate-etc-overlay subcommand.
# Additive only: the new image's own /etc always wins by default (see the
# OTA redesign plan, DATA-preservation risk section); only what's listed
# here gets pulled back in from the previous install. Never list structural
# files here (fstab, systemd units, initramfs-tools config, PAM) - those
# must always come from the new image.
OTA_PRESERVE_LIST_VERSION=1

hostname
hosts
machine-id
ssh/ssh_host_*
NetworkManager/system-connections/*
netplan/*
localtime
timezone
vconsole.conf
default/keyboard
unitotem*
unitotem*/**
