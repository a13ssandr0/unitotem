#!/bin/sh
# initramfs-tools init-premount script for the RESIDENT FALLBACK initrd only
# (installed straight into the throwaway chroot by
# kiosk/stage1-recovery-initrd.sh - deliberately NOT part of stage1.tar.gz,
# since the real system's own initramfs needs the conditional dispatcher in
# kiosk/files/ota-init-premount instead, not this one). This initrd never
# boots a real root at all - unconditionally serve OTA, always.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac

exec /usr/sbin/unitotem-ota-engine serve-fallback --reason "avvio da immagine di fallback residente"
