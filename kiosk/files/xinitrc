#!/bin/sh
# X session for the unitotem kiosk. No window manager: unitotem-manager's own
# Qt6+CEF viewer (started independently as a systemd service, see
# start-xorg.service + unitotem-manager.service's Environment=DISPLAY=:0)
# already sets its own window to exact fullscreen geometry with no
# decorations, so nothing here needs to manage windows - just tune the X
# server (cursor hiding is handled by Xorg's own -nocursor flag) and keep
# the session alive.

xset -dpms
xset s off
xset s noblank
# The root window is the placeholder screen ("BOOT OK - VIDEO OUTPUT WORKS", logo, manager state, address, slot, release): it is
# what is seen whenever nothing covers it - above all when the manager is missing, not running or not showing anything. The
# manager's viewer window hides it when it works. A plain colour first (instant, and the fallback if the program cannot run);
# the program then paints the real thing and keeps its facts up to date.
xsetroot -solid "#000000"
/usr/sbin/unitotem-xbackground &

# $XAUTHORITY is already the fixed /run/unitotem-x11.auth path here (see
# start-xorg.service's Environment=) - both this X session and unitotem-
# manager.service (a separate systemd unit) point at the same file, so no
# handoff/copy step is needed.

exec sleep infinity
