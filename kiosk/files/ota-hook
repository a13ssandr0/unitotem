#!/bin/sh
# initramfs-tools hook: pulls every binary/module ota-engine.sh needs into an
# initrd. Installed at /etc/initramfs-tools/hooks/unitotem-ota in the rootfs
# by kiosk/stage1-packages.sh (stage1, not stage2 - see that file), so it is
# picked up both by kiosk/stage1-recovery-initrd.sh (the resident fallback
# kernel+initrd, built straight from the stage1 rootfs before any
# kiosk-specific configuration is layered on) and by the real system's own
# `update-initramfs` (stage2's `update-initramfs -u -k all`) - one hook, two
# consumers, always in sync with whatever ota-engine.sh actually needs.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac

. /usr/share/initramfs-tools/hook-functions

# ota-engine.sh is bash (needs pipefail, arrays are not used but associative
# patterns and process substitution style redirects are - dash can't do
# either); copy_exec resolves its shared libs too.
copy_exec /bin/bash /bin

# root login for dropbear (deploy/ota-engine.sh's cmd_serve_fallback), fixed
# password - same value as kiosk/common.sh's ROOT_PASSWORD default and
# deploy/lib.sh's OTA_PASSWORD default (keep all three in sync if this ever
# changes). This is NOT optional cleanup: /etc/passwd already ships in the
# initrd (part of the standard initramfs-tools skeleton) with root's entry
# pointing at shadow ("root:x:0:0:..."), but /etc/shadow itself is absent
# entirely - confirmed by extracting a real built initrd and checking.
# Without this, root's password is neither "empty" nor "some other value",
# it plainly doesn't exist anywhere dropbear (or chpasswd, if invoked at
# runtime instead) could read it, so password auth cannot work at all,
# regardless of what password is presented. Baking the hash in at build
# time (rather than chpasswd at boot) avoids needing chpasswd/PAM's own
# runtime dependencies in the initrd for something with one fixed, known
# outcome anyway. Hash is `openssl passwd -6 -salt unitotemota unitotem` -
# SHA-512 crypt, deterministic for a fixed salt+password, verified against
# a real shadow-auth stack before being pasted in here.
mkdir -p "${DESTDIR}/etc"
cat > "${DESTDIR}/etc/shadow" << 'EOF'
root:$6$unitotemota$dDLHj98s/O9CVUWeDgxAoILrb/ZKm4bbv2Lf/X3GbkR4I2mk1rbcfYUWbOStbVbfxmU2UquFNHQokKcsHU6Cy0:19000:0:99999:7:::
EOF
chmod 600 "${DESTDIR}/etc/shadow"
# /etc/group: not a secret, just copy the real one so any getgrgid(0)
# lookup during login resolves cleanly instead of silently missing.
copy_file file /etc/group /etc/group

# ota-engine.sh itself, plus the /usr/sbin/unitotem-ota-engine symlink that
# stage1-packages.sh points at it - what the init-premount/local-bottom
# wrappers below and every SSH-driven subcommand actually invoke.
copy_file file /usr/lib/unitotem/ota-engine.sh /usr/lib/unitotem/ota-engine.sh
mkdir -p "${DESTDIR}/usr/sbin"
ln -sf /usr/lib/unitotem/ota-engine.sh "${DESTDIR}/usr/sbin/unitotem-ota-engine"

for bin in \
    partclone.extfs partclone.fat partclone.dd partclone.restore partclone.info \
    sgdisk parted sfdisk partx blockdev blkid mountpoint \
    e2fsck resize2fs dumpe2fs mke2fs e2label mkfs.fat fatlabel mkfs.ext4 \
    xz unxz pv whiptail \
    dropbear dropbearkey dbclient scp \
    wpa_supplicant wpa_passphrase \
    sha256sum base64 awk cut paste readlink mkfifo cp grep head tail \
    rm chmod tar \
    ip udevadm \
    setsid \
; do
    p=$(command -v "$bin" 2>/dev/null) && copy_exec "$p" || echo "unitotem-ota hook: '$bin' non trovato, salto" >&2
done

# nc is a Debian alternatives symlink (nc -> /etc/alternatives/nc ->
# nc.traditional) - copy_exec on the symlink itself is unreliable (it can
# end up copying the symlink but not chasing it into the initrd), so resolve
# it explicitly and recreate the symlink by hand.
NC_REAL=$(readlink -f "$(command -v nc)" 2>/dev/null)
if [ -n "$NC_REAL" ]; then
    copy_exec "$NC_REAL"
    mkdir -p "${DESTDIR}/bin"
    ln -sf "$NC_REAL" "${DESTDIR}/bin/nc"
fi

# reboot -> /bin/systemctl -> /usr/bin/systemctl on this rootfs (confirmed by
# resolving it directly, not assumed). Needed as the real binary, not
# BusyBox's: run_ota_sequence's final step (deploy/remote-deploy.sh) needs
# `reboot -f "0 tryboot"` to actually trigger the Pi's tryboot mechanism for
# the next boot, and BusyBox's reboot applet does not support passing that
# argument through to the kernel's reboot(2) syscall at all (confirmed via
# targeted research - a known, long-standing BusyBox limitation). Verified
# empirically (not just from systemd's source) that systemd's own reboot
# binary handles this correctly with zero systemd actually running - not
# just "should work per the source": ran `reboot -f "0 tryboot"` for real in
# a container with PID 1 = bash (no systemd, matching this initrd exactly)
# and confirmed both that /run/systemd/reboot-param ends up containing
# "0 tryboot" and that it reaches an actual reboot(2) syscall attempt
# (blocked only by the container's own capability restrictions, which don't
# apply to an initramfs running with real kernel privileges).
REBOOT_REAL=$(readlink -f "$(command -v reboot)" 2>/dev/null)
if [ -n "$REBOOT_REAL" ]; then
    copy_exec "$REBOOT_REAL"
    mkdir -p "${DESTDIR}/usr/sbin"
    ln -sf "$REBOOT_REAL" "${DESTDIR}/usr/sbin/reboot"
fi

# initramfs-tools-core hard-depends on busybox-initramfs (confirmed: not an
# optional Recommends, no build-time flag avoids it), and its zz-busybox-
# initramfs hook - which always runs last - hardlinks busybox onto every
# name busybox claims to implement that isn't already present when it runs.
# Two confirmed-broken cases: mke2fs ("applet not found" at runtime despite
# the file existing - mkfs.ext4 is a symlink to mke2fs, reached only
# indirectly) and dd (busybox's dd rejects the conv=/oflag=/status=progress
# flags ota-engine.sh needs). copy_exec's own "skip if the target already
# exists" dedup is not a reliable guarantee of winning that race, especially
# through a symlink - force a direct copy of the real binaries instead.
# klibc-utils sorts *before* this hook and does the same "copy if the name
# doesn't exist yet" thing for its own /usr/lib/klibc/bin/* set (which
# includes mount, umount, losetup, mkfifo) - GNU-only flags on those are not
# guaranteed under klibc either, so they get the same treatment.
for forced in mke2fs dd mount umount losetup mkfifo; do
    real=$(command -v "$forced" 2>/dev/null)
    [ -n "$real" ] || continue
    dest="${DESTDIR}${real}"
    rm -f "$dest"
    mkdir -p "$(dirname "$dest")"
    cp -a "$real" "$dest"
    # A plain cp, unlike copy_exec, does not resolve shared library
    # dependencies - confirmed missing at runtime (mount/umount/losetup
    # failing with "cannot open shared object file: No such file or
    # directory" for libmount.so.1 in a real boot test) until this was
    # added. ldd's own path column is enough here (these are all dynamic
    # ELF binaries, not static).
    ldd "$real" 2>/dev/null | grep -oE '/[^ ]+' | while read -r lib; do
        [ -f "$lib" ] || continue
        copy_file file "$lib" "$lib"
    done
done

# terminfo + TERM: this initrd previously shipped no terminfo at all, so
# whiptail (via slang) could not draw and its "missing binary" fallback
# never triggered because the binary WAS present - only the terminfo lookup
# failed. Ship both the framebuffer console entry and the two serial
# terminal types ota-engine.sh's console selection can pick (see its
# TERM= logic: "linux" for tty*/fbcon, "vt220" for ttyS*/ttyAMA*).
for tif in l/linux v/vt220 v/vt100; do
    src="/lib/terminfo/${tif}"
    [ -f "$src" ] && copy_file file "$src" "$src"
done

manual_add_modules vfat nls_iso8859-1 nls_cp437 overlay
manual_add_modules brcmfmac brcmutil

# nls_ascii: this kernel's default vfat iocharset ("ascii") is a separate
# loadable module, not built in - without it, EVERY plain `mount -t vfat`
# (no explicit iocharset=) fails with "FAT-fs: IO charset ascii not found" /
# "wrong fs type, bad option, bad superblock". Confirmed live on real
# hardware: cmd_set_trial_boot's rpi-legacy branch (a plain `mount -t vfat`,
# no iocharset override) failed this way; loading nls_ascii.ko manually
# (self-contained, no deps) fixed it immediately, same mount command,
# nothing else changed. nls_iso8859-1/nls_cp437 (already listed below) cover
# *filename* charset conversion, not this - a different codepath in FAT-fs.
manual_add_modules nls_ascii

# bcm2835_wdt is what actually implements the reset on a Pi - MODULES=most
# does not pull it in (it targets storage/network hardware detection, not
# platform watchdog drivers), so without it there is no restart_handler
# registered at all and *any* reboot(2), tryboot argument or not, ends in
# "Reboot failed -- System halted" instead of an actual reset. Confirmed on
# real hardware: /sys/class/watchdog/ was empty and bcm2835_wdt absent from
# /proc/modules after a failed "reboot -f '0 tryboot'" that otherwise reached
# the kernel correctly (kernel log showed "Restarting system with command
# '0 tryboot'" right before halting). No module dependencies (self-contained
# per modules.dep).
manual_add_modules bcm2835_wdt

if [ "$(uname -m)" != "aarch64" ] || [ -f /usr/sbin/efibootmgr ]; then
    p=$(command -v efibootmgr 2>/dev/null) && copy_exec "$p"
    p=$(command -v grub-install 2>/dev/null) && copy_exec "$p"
    manual_add_modules efivarfs
    for d in /usr/lib/grub/i386-pc /usr/lib/grub/x86_64-efi; do
        [ -d "$d" ] && copy_file directory "$d" "$d"
    done
fi

exit 0
