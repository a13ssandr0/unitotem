#!/bin/bash
# Reboots into OTA mode when the machine is cabled but has no usable address,
# so a device that is up yet unreachable can still be recovered remotely
# instead of needing someone to walk to it.
#
# It fires only when a link has CARRIER but no global address. A unit that is simply not plugged
# in (offline on local content) has no carrier and is never touched.
#
# Link-local-only counts as "no usable address": the rescue channel is up but the device is
# misconfigured, and arming OTA gives the operator the full recovery toolset. The threshold is long
# enough that someone fixing things over link-local is not rebooted.
set -euo pipefail

CONF=/etc/unitotem/net-watchdog.conf
THRESHOLD_MIN=15
ENABLED=1
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

[ "${ENABLED}" = 1 ] || exit 0

STATE=/run/unitotem-net-watchdog.count   # /run: the count resets every boot

CARRIER_IFACES=()
for c in /sys/class/net/*/carrier; do
    [ -r "$c" ] || continue
    iface=${c%/carrier}; iface=${iface##*/}
    [ "$iface" = lo ] && continue
    if [ "$(cat "$c" 2>/dev/null || echo 0)" = 1 ]; then CARRIER_IFACES+=("$iface"); fi
done

if [ "${#CARRIER_IFACES[@]}" -eq 0 ]; then
    rm -f "$STATE"
    exit 0
fi

# scope global is the right test: a link-local-only interface reports scope
# link, and loopback reports scope host, so neither masks a broken config.
if [ -n "$(ip -o addr show scope global 2>/dev/null)" ]; then
    rm -f "$STATE"
    exit 0
fi

# Cabled but with no usable address. Before counting towards a reboot, make sure the rescue
# channel exists: NetworkManager sets disable_ipv6=1 on an interface with no active connection,
# and without IPv6 there is no link-local address, so the device is unreachable by every channel.
# Re-enabling is idempotent and non-destructive and restores reachability without a reboot;
# NetworkManager may turn it off again, and this runs every minute. The NM fallback profile
# prevents the state, this recovers from it.
for iface in "${CARRIER_IFACES[@]}"; do
    d="/proc/sys/net/ipv6/conf/${iface}/disable_ipv6"
    if [ -w "$d" ] && [ "$(cat "$d" 2>/dev/null || echo 0)" = 1 ]; then
        if echo 0 > "$d" 2>/dev/null; then
            logger -t unitotem-net-watchdog "IPv6 was disabled on ${iface}: re-enabled to restore the rescue link-local address"
        fi
    fi
    # An interface can also be simply down, which likewise means no
    # link-local. Harmless when it is already up.
    ip link set "$iface" up 2>/dev/null || true
done

n=$(( $(cat "$STATE" 2>/dev/null || echo 0) + 1 ))
echo "$n" > "$STATE"

if [ "$n" -lt "$THRESHOLD_MIN" ]; then
    logger -t unitotem-net-watchdog "cable connected but no usable address (${n}/${THRESHOLD_MIN})"
    exit 0
fi

logger -t unitotem-net-watchdog "no usable address for ${THRESHOLD_MIN} minutes with cable connected: rebooting into OTA mode"
rm -f "$STATE"
exec unitotem-ota-arm --port 2222
