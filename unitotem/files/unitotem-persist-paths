#!/bin/bash
# Runs once per boot, before cron, the manager and ssh: bind-mounts user-data directories from DATA over their place under
# /var (an OTA resets /var's overlay upper layer, so the data must live on DATA), and over /home (user home
# directories of administrators: ROOT is read-only, so home cannot live there).
# Whole directories, never single files: crontab(1) replaces its file with a rename, which fails on a bind-mounted file.
# First boot on a DATA with no copy yet: seed it from whatever is at the target.
set -euo pipefail

PERSIST=/mnt/data/unitotem/persist

[ -d /mnt/data ] || { echo "unitotem-persist-paths: /mnt/data not mounted, skipping" >&2; exit 0; }

# name | target | mode | group
persist() {
    local name=$1 target=$2 mode=$3 group=$4 src="$PERSIST/$1"
    mkdir -p "$target"
    if [ ! -d "$src" ]; then
        mkdir -p "$src"
        cp -a "$target"/. "$src"/ 2>/dev/null || true
    fi
    chown "root:$group" "$src"
    chmod "$mode" "$src"
    mountpoint -q "$target" || mount --bind "$src" "$target"
}

persist uploaded /var/lib/unitotem/uploaded 755 root
persist crontabs /var/spool/cron/crontabs  1730 crontab
persist browser  /var/lib/unitotem/browser  700 root
persist home     /home                      755 root
