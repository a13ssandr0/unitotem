#!/bin/sh
# First boot: derives the device suffix (last three bytes of the machine id, six capital hex digits), stores it in
# /etc/unitotem/device-suffix (the first-boot hotspot is named unitotem-<suffix> from it) and names the device unitotem-<suffix> in
# lower case. A host name the owner already chose is left alone. The machine id is generated by systemd on the first boot (the image ships an
# empty /etc/machine-id) and lives in DATA through the /etc overlay, so it and the suffix stay the same for the life of the DATA partition.
set -eu
DEFAULT=unitotem
FILE=/etc/unitotem/device-suffix
[ ! -e "$FILE" ] || exit 0

id=$(tr -d '\n' < /etc/machine-id 2>/dev/null || true)
case "$id" in *[!0-9a-f]*|"") id="" ;; esac
[ "${#id}" = 32 ] || { echo "unitotem-hostname: no valid machine id, nothing changed" >&2; exit 0; }
suffix=$(printf '%s' "${id#"${id%??????}"}" | tr 'a-f' 'A-F')

current=$(tr -d '\n' < /etc/hostname 2>/dev/null || true)
if [ -z "$current" ] || [ "$current" = "$DEFAULT" ]; then
    new="${DEFAULT}-$(printf '%s' "$suffix" | tr 'A-F' 'a-f')"
    printf '%s\n' "$new" > /etc/hostname
    hostname "$new"
    if grep -q "^127\.0\.1\.1[[:space:]]" /etc/hosts 2>/dev/null; then
        sed -i "s/^\(127\.0\.1\.1[[:space:]]\+\).*/\1${new}/" /etc/hosts
    else
        printf '127.0.1.1\t%s\n' "$new" >> /etc/hosts
    fi
fi
mkdir -p /etc/unitotem
printf '%s\n' "$suffix" > "$FILE"
