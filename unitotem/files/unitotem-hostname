#!/bin/sh
# First boot: derives the device suffix (last three bytes of the machine UUID, six capital hex digits), stores it in
# /etc/unitotem/device-suffix (the first-boot hotspot is named unitotem-<suffix> from it) and names the device unitotem-<suffix> in
# lower case. A host name the owner already chose is left alone. The UUID is the DMI product UUID; a Raspberry Pi has no DMI and uses the
# serial number of its device tree; a machine id is the last resort. Placeholder DMI values (all zeros, all ones, vendor defaults) are skipped.
set -eu
DEFAULT=unitotem
FILE=/etc/unitotem/device-suffix
[ ! -e "$FILE" ] || exit 0

hex_tail() {   # last six hex digits of the hex digits in $1, capitals; fails when there are fewer than 12
    h=$(printf '%s' "$1" | tr -d '\n-' | tr 'a-f' 'A-F')
    case "$h" in *[!0-9A-F]*|"") return 1 ;; esac
    [ "${#h}" -ge 12 ] || return 1
    printf '%s' "${h#"${h%??????}"}"
}

placeholder() {   # the DMI values that identify no machine
    case "$(printf '%s' "$1" | tr 'A-F' 'a-f')" in
        00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff|\
        03000200-0400-0500-0006-000700080009|12345678-1234-5678-90ab-cddeefaabbcc|\
        11111111-1111-1111-1111-111111111111|01234567-89ab-cdef-fedc-ba9876543210) return 0 ;;
    esac
    return 1
}

suffix=""
uuid=$(cat /sys/class/dmi/id/product_uuid 2>/dev/null || true)
if [ -n "$uuid" ] && ! placeholder "$uuid"; then suffix=$(hex_tail "$uuid" || true); fi
if [ -z "$suffix" ]; then
    serial=$(tr -d '\0\n' < /proc/device-tree/serial-number 2>/dev/null || true)
    [ -z "$serial" ] || suffix=$(hex_tail "$serial" || true)
fi
if [ -z "$suffix" ]; then
    suffix=$(hex_tail "$(cat /etc/machine-id 2>/dev/null || true)" || true)
fi
[ -n "$suffix" ] || { echo "unitotem-hostname: no machine identity found, nothing changed" >&2; exit 0; }

current=$(tr -d '\n' < /etc/hostname 2>/dev/null || true)
if [ -z "$current" ] || [ "$current" = "$DEFAULT" ]; then
    new="${DEFAULT}-$(printf '%s' "$suffix" | tr 'A-F' 'a-f')"
    printf '%s\n' "$new" > /etc/hostname
    hostname "$new"
    if grep -q "^127\.0\.1\.1[[:space:]]" /etc/hosts 2>/dev/null; then
        sed -i "s/^\(127\.0\.1\.1[[:space:]]\+\).*/\1${new}/" /etc/hosts
    else
        printf '127.0.1.1\t%s\n' "$new" >> /etc/hosts
    fi
fi
mkdir -p /etc/unitotem
printf '%s\n' "$suffix" > "$FILE"
