# Hardware video decode for the kiosk browser.
#
# Chromium leaves video decode acceleration OFF by default on Linux (--enable-gpu-rasterization covers compositing
# only), so without these flags 1080p H.264 is decoded on the CPU.
# Feature names were checked against the binary (a misspelled one is silently ignored): present are
# AcceleratedVideoDecodeLinuxGL, AcceleratedVideoDecodeLinuxZeroCopyGL, VaapiVideoDecoder. Absent, so not
# requested: VaapiVideoDecodeLinuxGL, V4L2FlatVideoDecoder, PlatformHEVCDecoderSupport (HEVC does not play).
# --ignore-gpu-blocklist: the blocklist forces software fallback, the wrong trade for a video appliance.

export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --ignore-gpu-blocklist"
export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --enable-features=@UNITOTEM_ACCEL_FEATURES@"
