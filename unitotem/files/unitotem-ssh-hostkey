#!/bin/bash
# Runs once per boot, Before=ssh.service: keeps this device's SSH host key unique and persisted on DATA instead of
# the key the image carries (identical on every device). Two idempotent branches:
#   - DATA has a saved key: restore it into /etc/ssh.
#   - DATA has none: discard the image's key, run ssh-keygen -A and save the new keys to DATA (survives every OTA
#     that preserves DATA; --wipe-data starts over).
set -euo pipefail

DATA_DIR=/mnt/data/unitotem/ssh-host-keys
SSH_DIR=/etc/ssh

[ -d /mnt/data ] || { echo "unitotem-ssh-hostkey: /mnt/data not mounted, skipping" >&2; exit 0; }

mkdir -p "$DATA_DIR"

if ls "$DATA_DIR"/ssh_host_*_key >/dev/null 2>&1; then
    cp -a "$DATA_DIR"/ssh_host_* "$SSH_DIR"/
else
    rm -f "$SSH_DIR"/ssh_host_*
    ssh-keygen -A >/dev/null
    cp -a "$SSH_DIR"/ssh_host_* "$DATA_DIR"/
fi

chmod 600 "$SSH_DIR"/ssh_host_*_key
chmod 644 "$SSH_DIR"/ssh_host_*_key.pub
