#!/bin/bash
# Runs once per boot, Before=ssh.service (see unitotem-ssh-hostkey.service):
# ensures this device's SSH host key is unique per-device and persisted on
# DATA, rather than the one baked into the build image at build time by
# openssh-server's own postinst (ssh-keygen -A during the chroot install) -
# which is the *same* key on every device built from that image until this
# runs. Two branches, both idempotent:
#   - DATA already has a saved key (every boot after the first on this
#     DATA, and any reinstall that preserves DATA): restore it into
#     /etc/ssh, overwriting whatever the image shipped.
#   - DATA has no saved key yet (first boot ever on this DATA): the image's
#     baked-in key would be shared across devices, so discard it and force
#     ssh-keygen -A to generate fresh ones, then save those to DATA - from
#     here on this device keeps the same key across every future OTA that
#     preserves DATA (--wipe-data starts over, by design).
set -euo pipefail

DATA_DIR=/mnt/data/unitotem/ssh-host-keys
SSH_DIR=/etc/ssh

[ -d /mnt/data ] || { echo "unitotem-ssh-hostkey: /mnt/data non montato, salto" >&2; exit 0; }

mkdir -p "$DATA_DIR"

if ls "$DATA_DIR"/ssh_host_*_key >/dev/null 2>&1; then
    cp -a "$DATA_DIR"/ssh_host_* "$SSH_DIR"/
else
    rm -f "$SSH_DIR"/ssh_host_*
    ssh-keygen -A >/dev/null
    cp -a "$SSH_DIR"/ssh_host_* "$DATA_DIR"/
fi

chmod 600 "$SSH_DIR"/ssh_host_*_key
chmod 644 "$SSH_DIR"/ssh_host_*_key.pub
