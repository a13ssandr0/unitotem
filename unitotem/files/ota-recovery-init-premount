#!/bin/sh
# initramfs-tools init-premount script for the resident fallback initrd only (installed into the
# throwaway chroot by unitotem/stage1-recovery-initrd.sh; the system's own initramfs uses the
# conditional dispatcher unitotem/files/ota-init-premount). This initrd never boots a real root:
# it always serves OTA.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac

exec /usr/sbin/unitotem-ota-engine serve-fallback --reason "booted from the resident fallback image"
