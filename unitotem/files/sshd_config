Port 22
Protocol 2

PermitRootLogin prohibit-password
PasswordAuthentication yes
ChallengeResponseAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys

PermitEmptyPasswords no
MaxAuthTries 5
LoginGraceTime 30
ClientAliveInterval 300
ClientAliveCountMax 2

X11Forwarding no
AllowTcpForwarding no
PrintMotd no

# Locale of every session: the image's UTF-8 locale, whatever the client sends (stage 2 sets it from UNITOTEM_LOCALE).
SetEnv LANG=en_US.UTF-8

# First-access state: root in the marker group gets only the first-administrator script.
Match User root Group unitotem-first-admin
    PermitRootLogin yes
    PermitEmptyPasswords yes
    ForceCommand /usr/sbin/unitotem-first-admin
    DisableForwarding yes
    PermitTunnel no
    PermitUserRC no
