#!/bin/sh
exec tail -n +3 "$0"
# UniTotem: permanent (not one-shot) manual recovery entry - installed by
# unitotem/stage2-configure.sh at /etc/grub.d/45_unitotem_ota so update-grub
# always regenerates it. Boots the CURRENT system's own kernel/initrd (via
# the stable /vmlinuz, /initrd.img symlinks every Debian kernel package
# maintains) with unitotem.ota=recover appended - the real system's own
# initramfs (already OTA-capable, see unitotem/files/ota-init-premount) handles
# the rest. Needs GRUB_TIMEOUT>0 (see unitotem/files/grub-default) to actually
# be reachable - the previous GRUB_TIMEOUT=0 hid every menu entry, this one
# included.
menuentry 'UniTotem OTA recovery' {
    insmod part_gpt
    insmod part_msdos
    insmod ext2
    search --no-floppy --set=root --label ROOT
    # low resolution for the OTA screens (see unitotem/files/grub-ab-entries)
    insmod all_video
    insmod gfxterm
    set gfxmode=640x480x32,640x480,800x600x32,800x600,1024x768x32,1024x768,auto
    terminal_output gfxterm
    set gfxpayload=keep
    linux /vmlinuz root=LABEL=ROOT ro quiet nomodeset fbcon=font:TER16x32 unitotem.ota=recover
    initrd /initrd.img
}
