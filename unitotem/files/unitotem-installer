#!/bin/bash
# `install`: writes the UniTotem flash image from the installer ISO to a disk. Runs in the installer initramfs
# (tools/build-installer-iso.sh, docs/system/installer-iso.md), from the console or over ssh.
#   install                      pick the disk, two y/n questions (needs a terminal)
#   install --disk DEV           skip the picker, keep the questions (needs a terminal)
#   install --disk DEV -y        no questions, for unattended use over ssh
#   install --console            started by the console menu: closes ssh first, reopens it unless the disk is written
# Exit codes: 0 done, 1 failed, 2 usage, 3 no terminal, 4 refused disk, 5 cancelled (changes=none), 6 media not found,
# 7 already running. Nothing is written before the questions are answered y (or -y with a validated --disk).
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export TERMINFO=/lib/terminfo
LOG=/run/unitotem-installer.log
MEDIA=/run/installer-media
MEDIA_LABEL=UNITOTEM_ISO
T=/run/unitotem-installer
XZ_FILE='' XZ_SHA='' XZ_BYTES='' RAW_BYTES='' RAW_SHA='' MEDIA_DISK=''
DISK='' DISK_BYTES=0 DISK_MODEL='' OPT_DISK='' OPT_YES=0 OPT_CONSOLE=0 STATE=/run/unitotem-installer.state

# log LEVEL TEXT: INFO|WARNING|ERROR line to the log file and the kernel log (debug level)
log() { echo "$1 $2" >> "$LOG"; echo "<7>unitotem-installer: $1 $2" > /dev/kmsg 2>/dev/null || true; }
# say LEVEL TEXT: the same line on the console
say() { log "$1" "$2"; printf '%s %s\n' "$1" "$2"; }

usage() { echo "usage: install [--disk DEVICE [-y]]" >&2; exit 2; }
while [ $# -gt 0 ]; do
    case $1 in
        --disk) [ $# -ge 2 ] || usage; OPT_DISK=$2; shift 2 ;;
        -y) OPT_YES=1; shift ;;
        --console) OPT_CONSOLE=1; shift ;;
        *) usage ;;
    esac
done
[ "$OPT_YES" = 1 ] && [ -z "$OPT_DISK" ] && usage
if [ -n "$OPT_DISK" ] && ! [[ $OPT_DISK =~ ^/dev/[A-Za-z0-9]+$ ]]; then usage; fi
if [ "$OPT_YES" = 0 ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then
    say ERROR "a terminal is required, use ssh -t changes=none"
    exit 3
fi

mkdir -p "$MEDIA" "$T"
# one installation at a time; the state file tells the console menu who runs it
exec 9> /run/unitotem-installer.lock
if ! flock -n 9; then say ERROR "installation in progress changes=none"; exit 7; fi
if [ "$OPT_CONSOLE" = 1 ]; then echo console > "$STATE"; else echo remote > "$STATE"; fi
# end_run: clears the state; a console run that wrote nothing gives ssh back
end_run() {
    rm -f "$STATE"
    if [ "$OPT_CONSOLE" = 1 ] && [ "${WRITTEN:-0}" != 1 ]; then
        unitotem-ssh start 9>&- && log INFO "ssh reopened reason=install ended"
    fi
}
WRITTEN=0
trap end_run EXIT
if [ "$OPT_CONSOLE" = 1 ]; then
    unitotem-ssh stop
    say INFO "ssh closed reason=local install"
fi
# dirty pages never run ahead of the disk by more than 256 MiB: the progress follows the real write speed
echo 268435456 > /proc/sys/vm/dirty_bytes 2>/dev/null || true

# size_gib BYTES
size_gib() { awk -v s="$1" 'BEGIN { printf "%.1f GiB", s / 1073741824 }'; }

# disk_of DEVICE: name of the whole disk that holds DEVICE (/dev/sdb1 -> sdb)
disk_of() {
    local n p
    n=${1##*/}
    p=$(readlink -f "/sys/class/block/$n") || return 1
    if [ -e "$p/partition" ]; then p=${p%/*}; n=${p##*/}; fi
    echo "$n"
}

# Reads payload.info as data: every key and value fullmatch-validated.
read_info() {
    local f=$1 k v
    XZ_FILE='' XZ_SHA='' XZ_BYTES='' RAW_BYTES='' RAW_SHA=''
    while IFS='=' read -r k v; do
        case $k in
            image)      [[ $v =~ ^[A-Za-z0-9._-]+$ ]] && XZ_FILE=$v ;;
            xz_sha256)  [[ $v =~ ^[0-9a-f]{64}$ ]] && XZ_SHA=$v ;;
            raw_sha256) [[ $v =~ ^[0-9a-f]{64}$ ]] && RAW_SHA=$v ;;
            xz_bytes)   [[ $v =~ ^[0-9]{1,15}$ ]] && XZ_BYTES=$v ;;
            raw_bytes)  [[ $v =~ ^[0-9]{1,15}$ ]] && RAW_BYTES=$v ;;
        esac
    done < "$f"
    [ -n "$XZ_FILE" ] && [ -n "$XZ_SHA" ] && [ -n "$RAW_SHA" ] && [ -n "$XZ_BYTES" ] && [ -n "$RAW_BYTES" ]
}

# find_media: mounts the device labelled UNITOTEM_ISO that carries the payload (up to 90 s for slow USB)
find_media() {
    local i d
    for ((i = 0; i < 45; i++)); do
        udevadm settle --timeout=2 2>/dev/null
        for d in $(blkid -t "LABEL=$MEDIA_LABEL" -o device 2>/dev/null); do
            mountpoint -q "$MEDIA" && umount "$MEDIA" 2>/dev/null
            mount -t iso9660 -o ro -- "$d" "$MEDIA" 2>>"$LOG" || continue
            if [ -f "$MEDIA/unitotem/payload.info" ] && read_info "$MEDIA/unitotem/payload.info" \
               && [ -f "$MEDIA/unitotem/$XZ_FILE" ]; then
                MEDIA_DISK=$(disk_of "$d")
                log INFO "media $d disk=$MEDIA_DISK payload=$XZ_FILE raw=$RAW_BYTES"
                return 0
            fi
            umount "$MEDIA" 2>/dev/null
        done
        [ "$i" = 0 ] && echo "INFO searching the installation media"
        sleep 2
    done
    return 1
}

# disk_name_ok NAME: whole disks of known kinds only
disk_name_ok() { [[ $1 =~ ^(sd[a-z]+|hd[a-z]+|vd[a-z]+|xvd[a-z]+|nvme[0-9]+n[0-9]+|mmcblk[0-9]+)$ ]]; }

# disk_mounted NAME: the disk or one of its partitions is a mount source or swap area
disk_mounted() {
    local n=$1 p
    for p in "/dev/$n" /sys/block/"$n"/"$n"*; do
        p=${p##*/}
        grep -q "^/dev/$p " /proc/mounts /proc/swaps 2>/dev/null && return 0
    done
    return 1
}

# list_disks: "NAME<TAB>BYTES<TAB>MODEL" per candidate disk (not read-only, not the boot media)
list_disks() {
    local s n bytes model
    for s in /sys/block/*; do
        n=${s##*/}
        disk_name_ok "$n" || continue
        [ "$n" = "$MEDIA_DISK" ] && continue
        [ "$(cat "$s/ro" 2>/dev/null)" = 1 ] && continue
        bytes=$(( $(cat "$s/size" 2>/dev/null || echo 0) * 512 ))
        [ "$bytes" -gt 0 ] || continue
        model=$({ tr -s ' ' < "$s/device/model" | sed 's/^ //; s/ $//'; } 2>/dev/null)
        printf '%s\t%s\t%s\n' "$n" "$bytes" "${model:-unknown}"
    done
}

# ask_yn PROMPT [yellow]: y or n then Enter; anything else asks again; end of input counts as n
ask_yn() {
    local a pre='' post=''
    [ "${2:-}" = yellow ] && { pre=$'\033[33m'; post=$'\033[0m'; }
    while :; do
        printf '%s%s (y/n) %s' "$pre" "$1" "$post"
        read -r a || return 1
        case $a in y) return 0 ;; n) return 1 ;; esac
        echo "Invalid answer, type y or n"
    done
}

# set_disk NAME: DISK, DISK_BYTES, DISK_MODEL from sysfs
set_disk() {
    DISK=/dev/$1
    DISK_BYTES=$(( $(cat "/sys/block/$1/size") * 512 ))
    DISK_MODEL=$({ tr -s ' ' < "/sys/block/$1/device/model" | sed 's/^ //; s/ $//'; } 2>/dev/null)
    : "${DISK_MODEL:=unknown}"
}

# pick_disk: sets the disk; returns 1 on cancel or when there is none
pick_disk() {
    local -a names=() sizes=() models=()
    local n b m i ans
    while IFS=$'\t' read -r n b m; do names+=("$n"); sizes+=("$b"); models+=("$m"); done < <(list_disks)
    if [ "${#names[@]}" = 0 ]; then say ERROR "no disk found changes=none"; return 1; fi
    if [ "${#names[@]}" = 1 ]; then
        set_disk "${names[0]}"
    else
        for i in "${!names[@]}"; do
            printf '%d) /dev/%s  %s  %s%s\n' $((i + 1)) "${names[$i]}" "$(size_gib "${sizes[$i]}")" "${models[$i]}" \
                "$([ "${sizes[$i]}" -lt "$RAW_BYTES" ] && echo '  (too small)')"
        done
        while :; do
            printf 'Select the disk (1-%d, q to quit): ' "${#names[@]}"
            read -r ans || return 1
            [ "$ans" = q ] && return 1
            if [[ $ans =~ ^[0-9]{1,3}$ ]] && [ "$ans" -ge 1 ] && [ "$ans" -le "${#names[@]}" ]; then
                i=$((ans - 1))
                if [ "${sizes[$i]}" -lt "$RAW_BYTES" ]; then
                    say WARNING "disk=/dev/${names[$i]} too small"
                    continue
                fi
                set_disk "${names[$i]}"
                break
            fi
            echo "Invalid answer, type a number from 1 to ${#names[@]} or q"
        done
    fi
    [ "$DISK_BYTES" -ge "$RAW_BYTES" ] || { say WARNING "disk=$DISK too small changes=none"; return 1; }
}

# confirm_disk: shows the target and its partitions, two y/n questions; writing needs y to both
confirm_disk() {
    local parts
    parts=$(lsblk -nl -o NAME,SIZE,FSTYPE,LABEL "$DISK" 2>/dev/null | tail -n +2 | head -n 8)
    [ -n "$parts" ] || parts="no partitions"
    say INFO "target=$DISK model=$DISK_MODEL size=$(size_gib "$DISK_BYTES")"
    printf '%s\n\n' "$parts"
    ask_yn "Erase $DISK and install UniTotem?" || return 1
    ask_yn "Last chance: erase this disk?" yellow || return 1
}

# progress bars only when stderr is a terminal
if [ -t 2 ]; then PV=(pv -pterb); else PV=(pv -q); fi

stage_check() {
    local f=$MEDIA/unitotem/$XZ_FILE sum rc
    echo "INFO checking the media"
    sum=$("${PV[@]}" -N Checking -s "$XZ_BYTES" -- "$f" | sha256sum | cut -d' ' -f1; echo "${PIPESTATUS[*]}")
    rc=${sum#*$'\n'}; sum=${sum%%$'\n'*}
    [ "$rc" = "0 0 0" ] || [ "$rc" = "0 0 0 0" ] || return 1
    [ "$sum" = "$XZ_SHA" ]
}

stage_write() {
    local f=$MEDIA/unitotem/$XZ_FILE sectors mib
    echo "INFO writing disk=$DISK"
    sectors=$(blockdev --getsz "$DISK") || return 1
    # old backup GPT at the disk end and old signatures right after the image must not survive
    dd if=/dev/zero of="$DISK" bs=512 seek=$((sectors - 2048)) count=2048 conv=fsync 2>>"$LOG" || return 1
    mib=$(( (RAW_BYTES + 1048575) / 1048576 ))
    dd if=/dev/zero of="$DISK" bs=1M seek="$mib" count=16 conv=fsync 2>>"$LOG" || true
    xz -dc -- "$f" 2>>"$LOG" | "${PV[@]}" -N Writing -s "$RAW_BYTES" | dd of="$DISK" bs=4M iflag=fullblock conv=fsync 2>>"$LOG"
    [ "${PIPESTATUS[*]}" = "0 0 0" ]
}

stage_verify() {
    local sum rc
    echo "INFO verifying disk=$DISK"
    blockdev --flushbufs "$DISK" 2>/dev/null
    echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true
    sum=$(dd if="$DISK" bs=4M iflag=count_bytes,fullblock count="$RAW_BYTES" 2>>"$LOG" | "${PV[@]}" -N Verifying -s "$RAW_BYTES" \
          | sha256sum | cut -d' ' -f1; echo "${PIPESTATUS[*]}")
    rc=${sum#*$'\n'}; sum=${sum%%$'\n'*}
    [ "$rc" = "0 0 0 0" ] && [ "$sum" = "$RAW_SHA" ]
}

install_disk() {
    log INFO "writing disk=$DISK bytes=$DISK_BYTES"
    stage_check  || { say ERROR "media check failed"; return 1; }
    stage_write  || { say ERROR "write failed disk=$DISK"; return 1; }
    stage_verify || { say ERROR "verify failed disk=$DISK"; return 1; }
    say INFO "install ok disk=$DISK"
}

if ! find_media; then say ERROR "media not found changes=none"; exit 6; fi

if [ -n "$OPT_DISK" ]; then
    n=${OPT_DISK#/dev/}
    if ! disk_name_ok "$n" || [ ! -d "/sys/block/$n" ]; then say ERROR "disk=$OPT_DISK not a disk changes=none"; exit 4; fi
    if [ "$n" = "$MEDIA_DISK" ]; then say ERROR "disk=$OPT_DISK is the boot media changes=none"; exit 4; fi
    if disk_mounted "$n"; then say ERROR "disk=$OPT_DISK is mounted changes=none"; exit 4; fi
    set_disk "$n"
    if [ "$DISK_BYTES" -lt "$RAW_BYTES" ]; then say ERROR "disk=$DISK too small changes=none"; exit 4; fi
else
    pick_disk || { say INFO "cancelled changes=none"; exit 5; }
fi

if [ "$OPT_YES" = 1 ]; then
    say INFO "target=$DISK model=$DISK_MODEL size=$(size_gib "$DISK_BYTES")"
else
    confirm_disk || { say INFO "cancelled disk=$DISK changes=none"; exit 5; }
fi

WRITTEN=1
if ! install_disk; then WRITTEN=0; exit 1; fi
if [ "$OPT_YES" = 1 ]; then
    say INFO "remove the installation media, then run: reboot"
    exit 0
fi
echo "Remove the installation media, then press Enter to restart"
read -r _
sync
umount "$MEDIA" 2>/dev/null
reboot -f
