#!/bin/sh
# initramfs-tools hook: pulls every binary/module ota-engine.sh needs into an initrd. Installed at
# /etc/initramfs-tools/hooks/unitotem-ota in the rootfs by unitotem/stage1-packages.sh, so it is used
# both by unitotem/stage1-recovery-initrd.sh (the resident fallback kernel+initrd) and by the
# system's own `update-initramfs`.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac

. /usr/share/initramfs-tools/hook-functions

# ota-engine.sh is bash (it needs pipefail and process substitution, which dash lacks); copy_exec
# resolves its shared libs too.
copy_exec /bin/bash /bin

# /etc/passwd and /etc/shadow are generated at run time by fallback_auth_setup (deploy/ota-engine.sh): no password
# hash is baked into the initrd.
mkdir -p "${DESTDIR}/etc" "${DESTDIR}/root/.ssh"
chmod 700 "${DESTDIR}/root/.ssh"
# /etc/group: copied so getgrgid(0) lookups during login resolve.
copy_file file /etc/group /etc/group

# ota-engine.sh itself, plus the /usr/sbin/unitotem-ota-engine symlink that the init-premount/local-bottom
# wrappers and every SSH-driven subcommand invoke.
copy_file file /usr/lib/unitotem/ota-engine.sh /usr/lib/unitotem/ota-engine.sh
# the logo shown on the framebuffer by the deploy/recovery screen (see ota_logo in ota-engine.sh)
# the rounded frame around the progress dialog (see ota_frame in ota-engine.sh)
for _ext in bgrx bgr24 rgb565; do
    copy_file file "/usr/lib/unitotem/unitotem-frame-line.${_ext}" "/usr/lib/unitotem/unitotem-frame-line.${_ext}"
    for _r in 12 16 24 32 48 64; do
        copy_file file "/usr/lib/unitotem/unitotem-frame-corners-${_r}.${_ext}" "/usr/lib/unitotem/unitotem-frame-corners-${_r}.${_ext}"
    done
done
for _logo in unitotem-logo-256x73.bgrx unitotem-logo-640x182.bgrx unitotem-logo-256x73.rgb565 unitotem-logo-640x182.rgb565; do
    copy_file file "/usr/lib/unitotem/${_logo}" "/usr/lib/unitotem/${_logo}"
done
mkdir -p "${DESTDIR}/usr/sbin"
ln -sf /usr/lib/unitotem/ota-engine.sh "${DESTDIR}/usr/sbin/unitotem-ota-engine"

for bin in \
    partclone.extfs partclone.fat partclone.dd partclone.restore partclone.info \
    sgdisk parted sfdisk partx blockdev blkid mountpoint \
    e2fsck tune2fs resize2fs dumpe2fs mke2fs e2label mkfs.fat fsck.fat fatlabel mkfs.ext4 \
    xz unxz pv whiptail \
    dropbear dropbearkey scp \
    wpa_supplicant wpa_passphrase \
    sha256sum base64 awk cut paste readlink mkfifo cp grep head tail stty \
    tr cmp od sed lsblk partprobe \
    rm chmod tar \
    ip udevadm \
    setsid \
; do
    p=$(command -v "$bin" 2>/dev/null) && copy_exec "$p" || echo "unitotem-ota hook: '$bin' not found, skipping" >&2
done

# nc is a Debian alternatives symlink (nc -> /etc/alternatives/nc -> nc.traditional); copy_exec on the
# symlink is unreliable, so resolve it explicitly and recreate the symlink by hand.
NC_REAL=$(readlink -f "$(command -v nc)" 2>/dev/null)
if [ -n "$NC_REAL" ]; then
    copy_exec "$NC_REAL"
    mkdir -p "${DESTDIR}/bin"
    ln -sf "$NC_REAL" "${DESTDIR}/bin/nc"
fi

# reboot must be the real systemd binary, not BusyBox's: run_ota_sequence's final step needs
# `reboot -f "0 tryboot"`, and BusyBox's reboot applet cannot pass that argument to reboot(2).
# systemd's reboot works without systemd running as PID 1.
REBOOT_REAL=$(readlink -f "$(command -v reboot)" 2>/dev/null)
if [ -n "$REBOOT_REAL" ]; then
    copy_exec "$REBOOT_REAL"
    mkdir -p "${DESTDIR}/usr/sbin"
    ln -sf "$REBOOT_REAL" "${DESTDIR}/usr/sbin/reboot"
fi

# initramfs-tools-core's zz-busybox-initramfs hook (always last) hardlinks busybox onto every name that
# is not already present, and klibc-utils does the same for its own set. Broken cases: mke2fs
# (mkfs.ext4 is a symlink to it), dd (busybox's dd rejects the conv=/oflag=/status=progress flags
# ota-engine.sh needs), and mount/umount/losetup/mkfifo (GNU-only flags). copy_exec's "skip if exists"
# dedup does not reliably win that race, so the real binaries are copied directly.
for forced in mke2fs dd mount umount losetup mkfifo; do
    real=$(command -v "$forced" 2>/dev/null)
    [ -n "$real" ] || continue
    dest="${DESTDIR}${real}"
    rm -f "$dest"
    mkdir -p "$(dirname "$dest")"
    cp -a "$real" "$dest"
    # A plain cp, unlike copy_exec, does not resolve shared library dependencies; ldd's path column
    # is enough (these are dynamic ELF binaries).
    ldd "$real" 2>/dev/null | grep -oE '/[^ ]+' | while read -r lib; do
        [ -f "$lib" ] || continue
        copy_file file "$lib" "$lib"
    done
done

# terminfo: whiptail (via slang) cannot draw without it. Ship the framebuffer console entry and the two
# serial terminal types ota-engine.sh can select (TERM=linux for tty*/fbcon, vt220 for ttyS*/ttyAMA*).
for tif in l/linux v/vt220 v/vt100; do
    src="/lib/terminfo/${tif}"
    [ -f "$src" ] && copy_file file "$src" "$src"
done

manual_add_modules vfat nls_iso8859-1 nls_cp437 overlay
# Since the 6.18 kernels brcmfmac is split by chip vendor: the core module requests a vendor module
# (brcmfmac-cyw for the CYW4345x of the Pi 3B+/4/400/5, -wcc, -bca) when the chip probes, and without it
# the probe fails and there is no wlan0. modprobe resolves the names with underscores; kernels that
# lack them (older than 6.13) skip the loop.
manual_add_modules brcmfmac brcmutil
for _m in brcmfmac_cyw brcmfmac_wcc brcmfmac_bca; do
    modinfo -k "${version}" "$_m" >/dev/null 2>&1 && manual_add_modules "$_m"
done

# nls_ascii: the default vfat iocharset ("ascii") is a separate module; without it every `mount -t vfat`
# without an explicit iocharset= fails with "FAT-fs: IO charset ascii not found". nls_iso8859-1 and
# nls_cp437 only cover filename conversion.
manual_add_modules nls_ascii

# bcm2835_wdt implements the reset on a Pi; MODULES=most does not include it, and without it any
# reboot(2), tryboot argument or not, ends in "Reboot failed -- System halted".
manual_add_modules bcm2835_wdt

if [ "$(uname -m)" != "aarch64" ] || [ -f /usr/sbin/efibootmgr ]; then
    p=$(command -v efibootmgr 2>/dev/null) && copy_exec "$p"
    p=$(command -v grub-install 2>/dev/null) && copy_exec "$p"
    manual_add_modules efivarfs
    for d in /usr/lib/grub/i386-pc /usr/lib/grub/x86_64-efi; do
        [ -d "$d" ] && copy_file directory "$d" "$d"
    done
fi

exit 0
