#!/bin/sh
# initramfs-tools hook: pulls every binary/module ota-engine.sh needs into an initrd. Installed at
# /etc/initramfs-tools/hooks/unitotem-ota in the rootfs by unitotem/stage1-packages.sh, so it is used
# both by unitotem/stage1-recovery-initrd.sh (the resident fallback kernel+initrd) and by the
# system's own `update-initramfs`. The names it copies are listed in /usr/share/unitotem-ota/ota-initrd.list.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac

. /usr/share/initramfs-tools/hook-functions

LIST=/usr/share/unitotem-ota/ota-initrd.list
[ -r "$LIST" ] || { echo "unitotem-ota hook: ${LIST} not found" >&2; exit 1; }

# /etc/passwd and /etc/shadow are generated at run time by fallback_auth_setup (deploy/script/ota-engine.sh): no password
# hash is baked into the initrd.
mkdir -p "${DESTDIR}/etc" "${DESTDIR}/root/.ssh"
chmod 700 "${DESTDIR}/root/.ssh"

# x86 directives apply on every non-arm64 target, and on arm64 only when efibootmgr is installed.
X86=0
if [ "$(uname -m)" != "aarch64" ] || [ -f /usr/sbin/efibootmgr ]; then X86=1; fi

# Directives are read from fd 3 so that the copy functions cannot consume the list.
while read -r directive rest <&3; do
    case "$directive" in
        ''|'#'*) continue ;;
    esac
    # Names contain no glob characters (lists.py), but word splitting must not expand any pattern.
    set -f
    set -- $rest
    set +f
    case "$directive" in
        bin)
            for _n in "$@"; do
                p=$(command -v "$_n" 2>/dev/null) && copy_exec "$p" || echo "unitotem-ota hook: '$_n' not found, skipping" >&2
            done ;;
        real)
            # copy_exec's "skip if exists" does not win against the BusyBox applet hardlinks of
            # zz-busybox-initramfs, so the real binaries are copied directly.
            for _n in "$@"; do
                real=$(command -v "$_n" 2>/dev/null)
                [ -n "$real" ] || continue
                dest="${DESTDIR}${real}"
                rm -f "$dest"
                mkdir -p "$(dirname "$dest")"
                cp -a "$real" "$dest"
                # A plain cp does not resolve shared library dependencies; ldd's path column
                # is enough (these are dynamic ELF binaries).
                ldd "$real" 2>/dev/null | grep -oE '/[^ ]+' | while read -r lib; do
                    [ -f "$lib" ] || continue
                    copy_file file "$lib" "$lib"
                done
            done ;;
        file)
            copy_file file "$1" "${2:-$1}" ;;
        logo)
            for _b in "$@"; do
                for _ext in bgrx rgb565 spans; do
                    copy_file file "/usr/lib/unitotem/${_b}.${_ext}" "/usr/lib/unitotem/${_b}.${_ext}"
                done
            done ;;
        terminfo)
            # whiptail (via slang) draws in mono with ASCII borders without the entry. Debian 13 keeps the
            # database in /usr/share/terminfo (older releases in /lib/terminfo).
            for _t in "$@"; do
                for dir in /usr/share/terminfo /lib/terminfo /usr/lib/terminfo; do
                    if [ -f "${dir}/${_t}" ]; then copy_file file "${dir}/${_t}" "/usr/share/terminfo/${_t}"; break; fi
                done
            done ;;
        module)
            manual_add_modules "$@" ;;
        module-opt)
            # modprobe resolves the names with underscores; kernels that lack a module skip it.
            for _m in "$@"; do
                modinfo -k "${version}" "$_m" >/dev/null 2>&1 && manual_add_modules "$_m"
            done ;;
        x86-bin)
            if [ "$X86" = 1 ]; then
                for _n in "$@"; do
                    p=$(command -v "$_n" 2>/dev/null) && copy_exec "$p"
                done
            fi ;;
        x86-module)
            if [ "$X86" = 1 ]; then manual_add_modules "$@"; fi ;;
        x86-dir)
            if [ "$X86" = 1 ]; then
                for d in "$@"; do
                    [ -d "$d" ] && copy_file directory "$d" "$d"
                done
            fi ;;
        *)
            echo "unitotem-ota hook: unknown directive '${directive}' in ${LIST}" >&2
            exit 1 ;;
    esac
done 3< "$LIST"

# The ota-engine.sh symlink that the init-premount/local-bottom wrappers and every SSH-driven subcommand invoke.
mkdir -p "${DESTDIR}/usr/sbin"
ln -sf /usr/lib/unitotem/ota-engine.sh "${DESTDIR}/usr/sbin/unitotem-ota-engine"

# nc is a Debian alternatives symlink (nc -> /etc/alternatives/nc -> nc.traditional); copy_exec on the
# symlink is unreliable, so resolve it explicitly and recreate the symlink by hand.
NC_REAL=$(readlink -f "$(command -v nc)" 2>/dev/null)
if [ -n "$NC_REAL" ]; then
    copy_exec "$NC_REAL"
    mkdir -p "${DESTDIR}/bin"
    ln -sf "$NC_REAL" "${DESTDIR}/bin/nc"
fi

# reboot must be the real systemd binary, not BusyBox's: run_ota_sequence's final step needs
# `reboot -f "0 tryboot"`, and BusyBox's reboot applet cannot pass that argument to reboot(2).
# systemd's reboot works without systemd running as PID 1.
REBOOT_REAL=$(readlink -f "$(command -v reboot)" 2>/dev/null)
if [ -n "$REBOOT_REAL" ]; then
    copy_exec "$REBOOT_REAL"
    mkdir -p "${DESTDIR}/usr/sbin"
    ln -sf "$REBOOT_REAL" "${DESTDIR}/usr/sbin/reboot"
fi

exit 0
