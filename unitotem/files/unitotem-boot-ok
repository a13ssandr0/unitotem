#!/bin/bash
# Runs once per boot, After=multi-user.target: reaching it means the whole system came up. Health-gates the boot,
# clears the boot counter and confirms the A/B slot.
set -euo pipefail

# Every boot: unitotem-update runs the health gate (a failing boot reboots while the boot counter is set, so
# the initramfs fallback is reached without physical access) and, on A/B, confirms a trial slot.
# Runs last and does not abort the unit: a failure here is recorded in unitotem-update's own state.
if [ -x /usr/sbin/unitotem-update ]; then
    /usr/sbin/unitotem-update --json boot-ok || true
fi
