#!/bin/bash
# Runs once per boot, After=multi-user.target (see unitotem-boot-ok.service):
# reaching this point means the freshly-restored system came all the way up,
# not just that its kernel/initrd booted. Two independent jobs:
#   1. always clear the boot counter on the boot FAT partition (the
#      "boots but userspace dies" fallback layer resets on every good boot,
#      trial or not - see the OTA plan, fallback guarantee section);
#   2. if this specific boot was a trial one (unitotem.ota.bootcount=1 on
#      the cmdline, set by ota-engine.sh's set-trial-boot), also promote it
#      to the permanent default - past this point a reboot no longer lands
#      back on the resident fallback.
set -euo pipefail

BOOTFS_LABEL=FIRMWARE
[ -d /sys/firmware/efi ] && BOOTFS_LABEL=EFI

# A/B images keep no boot counter on the FAT (see ota-engine.sh, cmd_init_premount): nothing to clear, and not
# touching that partition on a normal boot is the point.
BOOTFS_DEV=""
grep -q 'unitotem.slot=' /proc/cmdline || BOOTFS_DEV=$(blkid -L "$BOOTFS_LABEL" -o device 2>/dev/null || true)
if [ -n "$BOOTFS_DEV" ]; then
    mnt=/run/unitotem-bootfs
    mkdir -p "$mnt"
    # Reuse whatever mount of $BOOTFS_DEV already exists (normally
    # /boot/firmware via fstab) instead of an independent second mount -
    # same EBUSY/errors=remount-ro class of bug already fixed in
    # unitotem-ota-arm and deploy/ota-engine.sh's ota_mount_bootfs_rw.
    mounted=0
    if mountpoint -q "$mnt"; then
        mount -o remount,rw "$mnt" 2>/dev/null && mounted=1
    else
        existing=$(awk -v d="$BOOTFS_DEV" '$1==d{print $2; exit}' /proc/mounts)
        if [ -n "$existing" ]; then
            mount -o remount,rw "$existing" 2>/dev/null \
                && mount --bind "$existing" "$mnt" 2>/dev/null && mounted=1
        else
            mount -t vfat "$BOOTFS_DEV" "$mnt" 2>/dev/null && mounted=1
        fi
    fi
    if [ "$mounted" = 1 ]; then
        rm -f "$mnt/unitotem-ota.bootcount"
        sync
        umount "$mnt" 2>/dev/null || true
        [ -n "${existing:-}" ] && mount -o remount,ro "$existing" 2>/dev/null || true
    fi
fi

if grep -qw "unitotem.ota.bootcount=1" /proc/cmdline; then
    FIRMWARE=bios
    if [ -d /sys/firmware/efi ]; then
        FIRMWARE=uefi
    elif [ -r /proc/device-tree/model ] && grep -qi "raspberry pi" /proc/device-tree/model; then
        FIRMWARE=rpi
    fi

    if [ "$FIRMWARE" = rpi ]; then
        ROOTSRC=$(findmnt -no SOURCE / 2>/dev/null || true)
        PK=$(lsblk -no PKNAME "$ROOTSRC" 2>/dev/null || true)
        [ -n "$PK" ] && unitotem-ota-engine promote-default --firmware rpi --disk "/dev/$PK" --bootfs-part 1
    else
        unitotem-ota-engine promote-default --firmware "$FIRMWARE"
    fi
fi

# A/B layout (unitotem.slot= on the cmdline): confirmation is gated on the manager answering its
# health check, and a trial slot that does not come up healthy reboots into the previous slot.
# Runs last and does not abort the unit: a failure here is recorded in unitotem-update's own state.
if grep -q 'unitotem.slot=' /proc/cmdline && [ -x /usr/sbin/unitotem-update ]; then
    /usr/sbin/unitotem-update --json boot-ok || true
fi
