#!/usr/bin/env python3
"""unitotem-wifi-roam - move a Wi-Fi client to a clearly stronger access point of the same network.

The Raspberry Pi 4 Wi-Fi driver (brcmfmac) refuses the signal-strength notification wpa_supplicant's background scan relies on, and its
firmware roaming engine is off, so the supplicant never leaves the access point it first picked. Run from a timer: when the link is up and
weaker than GOOD_DBM, scan, and if another access point of the same SSID is at least MARGIN_DB stronger, ask the supplicant to roam to it
(`wpa_cli roam`, the supplicant's own re-association). Access points that failed to take the client are left alone for IGNORE_S.

Optional settings in /etc/unitotem/wifi-roam.conf (KEY=VALUE, not shipped): ENABLED=1, GOOD_DBM=-55, MARGIN_DB=10, MIN_INTERVAL_S=300, IGNORE_S=900.
Without the file the defaults apply.
Exit code is always 0 (a timer job).
"""
import json, os, re, subprocess, sys, syslog, time

CONF = os.environ.get("UNITOTEM_WIFI_ROAM_CONF", "/etc/unitotem/wifi-roam.conf")
STATE = os.environ.get("UNITOTEM_WIFI_ROAM_STATE", "/run/unitotem-wifi-roam.json")   # /run: forgotten at every boot
DEFAULTS = {"ENABLED": 1, "GOOD_DBM": -55, "MARGIN_DB": 10, "MIN_INTERVAL_S": 300, "IGNORE_S": 900}


def settings():
    cfg = dict(DEFAULTS)
    try:
        for line in open(CONF):
            m = re.match(r"^\s*([A-Z_]+)\s*=\s*(-?\d+)\s*$", line)
            if m and m.group(1) in cfg:
                cfg[m.group(1)] = int(m.group(2))
    except OSError:
        pass
    return cfg


def wpa(iface, *args):
    r = subprocess.run(["wpa_cli", "-i", iface, *args], capture_output=True, text=True, timeout=20)
    return r.stdout.strip()


def parse_status(text):
    return dict(l.split("=", 1) for l in text.splitlines() if "=" in l)


def parse_scan(text):
    """[(bssid, level, ssid)] from `wpa_cli scan_results` (tab separated; the SSID is the last column and may be empty)."""
    out = []
    for line in text.splitlines()[1:]:
        f = line.split("\t")
        if len(f) >= 5 and re.match(r"^[0-9a-f:]{17}$", f[0]):
            try: out.append((f[0], int(f[2]), f[4]))
            except ValueError: pass
    return out


def pick(current_bssid, current_dbm, ssid, scan, cfg, ignored, now):
    """The BSSID to roam to, or None. Needs a candidate of the same SSID at least MARGIN_DB above the current level, not recently failed."""
    best = None
    for bssid, level, name in scan:
        if name != ssid or bssid == current_bssid or ignored.get(bssid, 0) > now:
            continue
        if level >= current_dbm + cfg["MARGIN_DB"] and (best is None or level > best[1]):
            best = (bssid, level)
    return best[0] if best else None


def load_state():
    try: return json.load(open(STATE))
    except (OSError, ValueError): return {}


def save_state(st):
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f: json.dump(st, f)
    os.replace(tmp, STATE)


def log(msg):
    syslog.syslog(syslog.LOG_INFO, msg)


def wireless_interfaces():
    base = "/sys/class/net"
    return [i for i in sorted(os.listdir(base)) if os.path.isdir(os.path.join(base, i, "wireless"))]


def run_iface(iface, cfg, now):
    st = load_state()
    pend = st.get("pending")
    if pend:                                   # a roam we asked for earlier: did it land?
        if parse_status(wpa(iface, "status")).get("bssid") != pend["to"]:
            st.setdefault("ignore", {})[pend["to"]] = now + cfg["IGNORE_S"]
            log("%s: roam to %s did not take effect, leaving it alone for %d s" % (iface, pend["to"], cfg["IGNORE_S"]))
        st.pop("pending")
    status = parse_status(wpa(iface, "status"))
    if status.get("wpa_state") != "COMPLETED" or not status.get("ssid"):
        save_state(st); return
    if now - st.get("last_roam", 0) < cfg["MIN_INTERVAL_S"]:
        save_state(st); return
    poll = parse_status(wpa(iface, "signal_poll"))
    try: cur = int(poll["RSSI"])
    except (KeyError, ValueError):
        save_state(st); return
    if cur >= cfg["GOOD_DBM"]:                # strong enough: no scan, no interruption
        save_state(st); return
    wpa(iface, "scan"); time.sleep(6)
    ignored = {b: t for b, t in st.get("ignore", {}).items() if t > now}
    target = pick(status.get("bssid", ""), cur, status["ssid"], parse_scan(wpa(iface, "scan_results")), cfg, ignored, now)
    st["ignore"] = ignored
    if target:
        log("%s: %s at %d dBm, roaming to %s" % (iface, status["bssid"], cur, target))
        wpa(iface, "roam", target)
        st["last_roam"] = now; st["pending"] = {"to": target}
    save_state(st)


def main():
    cfg = settings()
    if not cfg["ENABLED"]:
        return 0
    for iface in wireless_interfaces():
        try: run_iface(iface, cfg, time.time())
        except (OSError, subprocess.SubprocessError) as e:
            log("%s: %s" % (iface, e))
    return 0


if __name__ == "__main__":
    sys.exit(main())
