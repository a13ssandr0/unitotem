#!/bin/sh
exec tail -n +3 "$0"
# UniTotem A/B: two static entries, one per ROOT slot, found by filesystem label (set per slot by unitotem-update).
# Installed at /etc/grub.d/10_unitotem_ab. 'saved_entry' in grubenv picks the default; grub-reboot sets a one-shot
# trial entry that GRUB clears before booting, so a crash during a trial returns to the default slot.
# unitotem-grub-level: 2   (raise when devices must pick up a change: unitotem-update copies the image's grub.cfg over
# the ESP's only when the shipped level is HIGHER, so a rollback never downgrades the bootloader config)
# Low resolution for every OTA entry (readable from afar): GRUB sets the firmware framebuffer to the first existing
# mode of gfxmode, gfxpayload=keep hands it to the kernel, nomodeset keeps DRM drivers from switching to native size.
# 640x480 first so firmware without it lands on the next smallest.
# Self-healing: if the chosen slot cannot be loaded GRUB tries the OTHER slot, then the resident OTA fallback.
# ${default} is the entry being booted (saved_entry or the trial's next_entry), so the alternative is the other slot.
# GRUB reads the `fallback` list as entry NUMBERS only (names/ids are silently dropped): 0 slot A, 1 slot B, 4 the
# OTA fallback (bottom, after the two *-recover entries). Keep the entry order below in step with this.
if [ "${default}" = slot-a ]; then
    set fallback="1 4"
elif [ "${default}" = slot-b ]; then
    set fallback="0 4"
else
    set fallback="4"
fi
function unitotem_lowres {
    insmod all_video
    insmod gfxterm
    set gfxmode=640x480x32,640x480,800x600x32,800x600,1024x768x32,1024x768,auto
    terminal_output gfxterm
    set gfxpayload=keep
}
menuentry 'UniTotem slot A' --id slot-a {
    insmod part_gpt
    insmod ext2
    search --no-floppy --set=root --label ROOT_A
    linux /vmlinuz root=LABEL=ROOT_A ro quiet splash loglevel=3 console=tty0 console=ttyS0,115200n8 rd.systemd.show_status=false systemd.show_status=false unitotem.slot=a
    initrd /initrd.img
}
menuentry 'UniTotem slot B' --id slot-b {
    insmod part_gpt
    insmod ext2
    search --no-floppy --set=root --label ROOT_B
    linux /vmlinuz root=LABEL=ROOT_B ro quiet splash loglevel=3 console=tty0 console=ttyS0,115200n8 rd.systemd.show_status=false systemd.show_status=false unitotem.slot=b
    initrd /initrd.img
}
menuentry 'UniTotem slot A (OTA recovery)' --id slot-a-recover {
    insmod part_gpt
    insmod ext2
    unitotem_lowres
    search --no-floppy --set=root --label ROOT_A
    linux /vmlinuz root=LABEL=ROOT_A ro quiet nomodeset fbcon=font:TER16x32 unitotem.ota=recover unitotem.slot=a
    initrd /initrd.img
}
menuentry 'UniTotem slot B (OTA recovery)' --id slot-b-recover {
    insmod part_gpt
    insmod ext2
    unitotem_lowres
    search --no-floppy --set=root --label ROOT_B
    linux /vmlinuz root=LABEL=ROOT_B ro quiet nomodeset fbcon=font:TER16x32 unitotem.ota=recover unitotem.slot=b
    initrd /initrd.img
}
# The resident fallback on the ESP. Deliberately LAST: when grubenv is unreadable (a torn write) GRUB
# falls back to entry 0, and a working slot is a far better outcome than a fallback that waits for a host.
# Deploys select it explicitly through saved_entry=ota-recovery, so its position does not matter there. During a deploy saved_entry points here, and the system under test is
# booted one-shot through next_entry, so any failure of that boot lands in the fallback by itself.
menuentry 'UniTotem OTA fallback' --id ota-recovery {
    insmod part_gpt
    insmod fat
    unitotem_lowres
    search --no-floppy --set=root --label EFI
    linux /unitotem/recovery-vmlinuz nomodeset quiet loglevel=3 fbcon=font:TER16x32 unitotem.ota=1 console=tty0 console=ttyS0,115200
    initrd /unitotem/recovery-initrd.img
}
