#!/bin/bash
set -e

# The units that actually own the screen on this image: the manager (and its viewer) and the Wayland compositor.
#
# systemctl stop, not pkill: unitotem-compositor.service is Restart=always, so a killed process comes straight back.
UNITOTEM_UNITS="unitotem-manager.service unitotem-compositor.service"

_enter() {
    echo "[unitotem-maintenance] Stopping the kiosk..."
    local u failed=""
    for u in $UNITOTEM_UNITS; do
        systemctl stop "$u" 2>/dev/null || true
    done
    # Verify the units really stopped: an update must not run while the kiosk holds the display.
    for u in $UNITOTEM_UNITS; do
        if systemctl is-active --quiet "$u"; then
            failed="${failed} ${u}"
        fi
    done
    if [ -n "$failed" ]; then
        echo "[unitotem-maintenance] ERROR: could not stop:${failed}" >&2
        echo "[unitotem-maintenance] Aborting: updating with the kiosk running is not safe." >&2
        exit 1
    fi

    echo "[unitotem-maintenance] Remounting rootfs read-write..."
    mount -o remount,rw /
    # /var/lib/dpkg is a bind mount onto ROOT (see unitotem/files/overlayfs-hook.sh) with its own
    # flags: it stays read-only when / is remounted rw, and dpkg could not update its database.
    mountpoint -q /var/lib/dpkg && mount -o remount,rw /var/lib/dpkg
    mount -o remount,size=1G /var/cache

    # The package lists live on the DATA overlay and an OTA resets them: without a refresh
    # installs fail with "Unable to locate package".
    echo "[unitotem-maintenance] Refreshing package lists..."
    apt-get update -qq || echo "[unitotem-maintenance] WARNING: apt-get update failed, the package lists may be incomplete" >&2

    echo "[unitotem-maintenance] Ready."
    echo "  /etc  /root       -> overlay on DATA (always persistent)"
    echo "  /home             -> bind from DATA (always persistent)"
    echo "  /usr  /lib  /bin  -> rootfs (now writable)"
    echo ""
    echo "Run: apt-get update && apt-get upgrade"
    echo "When done: unitotem-maintenance exit [--initramfs]"
}

_exit() {
    local regen_initramfs=0
    [ "$1" = "--initramfs" ] && regen_initramfs=1

    if [ $regen_initramfs -eq 1 ]; then
        echo "[unitotem-maintenance] Regenerating initramfs..."
        update-initramfs -u -k all
    fi

    # A failed update-grub leaves the old boot menu: abort without rebooting, so the admin can fix it and run exit again.
    if command -v update-grub &>/dev/null; then
        if ! update-grub; then
            echo "[unitotem-maintenance] ERROR: update-grub failed, not rebooting. Fix the error and run: unitotem-maintenance exit" >&2
            exit 1
        fi
    fi

    echo "[unitotem-maintenance] Remounting rootfs read-only..."
    sync
    # The bind mount carries its own flags and must be remounted separately.
    mountpoint -q /var/lib/dpkg && mount -o remount,ro /var/lib/dpkg 2>/dev/null || true
    mount -o remount,ro / 2>/dev/null || true

    echo "[unitotem-maintenance] Rebooting in 5 seconds..."
    sleep 5
    systemctl reboot
}

case "$1" in
    enter) _enter ;;
    exit)  _exit "${2:-}" ;;
    *)
        echo "Usage: $0 enter | exit [--initramfs]"
        exit 1
        ;;
esac
