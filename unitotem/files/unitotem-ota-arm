#!/bin/bash
# Arms OTA mode from a running, already-deployed UniTotem system and
# reboots into it: writes the self-clearing flag file the system's initramfs
# (unitotem/files/ota-init-premount) checks for, plus the network hints the fallback needs to
# reach back out. remote-deploy.sh's deploy of an already-UniTotem target is one
# `ssh_t unitotem-ota-arm ...` call (other targets use arm_grub/arm_rpi in deploy/remote-deploy.sh).
set -euo pipefail

HOST="" PORT="9700" WIPE_DATA=0

while [ $# -gt 0 ]; do
    case "$1" in
        --host) HOST="$2"; shift 2 ;;
        --port) PORT="$2"; shift 2 ;;
        --wipe-data) WIPE_DATA=1; shift ;;
        *) echo "unknown option: $1" >&2; exit 1 ;;
    esac
done

BOOTFS_LABEL=FIRMWARE
[ -d /sys/firmware/efi ] && BOOTFS_LABEL=EFI
BOOTFS_DEV=$(blkid -L "$BOOTFS_LABEL" -o device 2>/dev/null) \
    || { echo "boot partition ($BOOTFS_LABEL) not found" >&2; exit 1; }

mnt=/run/unitotem-bootfs
mkdir -p "$mnt"
# Reuse the existing mount of $BOOTFS_DEV (normally /boot/firmware) instead of a second mount at
# $mnt: a second vfat mount silently comes up read-only when the first one is read-only
# (see ota_mount_bootfs_rw in deploy/ota-engine.sh).
if mountpoint -q "$mnt"; then
    mount -o remount,rw "$mnt" 2>/dev/null || true
else
    existing=$(awk -v d="$BOOTFS_DEV" '$1==d{print $2; exit}' /proc/mounts)
    if [ -n "$existing" ]; then
        mount -o remount,rw "$existing" || { echo "remount rw of $existing failed" >&2; exit 1; }
        mount --bind "$existing" "$mnt" || { echo "bind mount of $existing on $mnt failed" >&2; exit 1; }
    else
        mount -t vfat "$BOOTFS_DEV" "$mnt" || { echo "mount of $BOOTFS_DEV failed" >&2; exit 1; }
    fi
fi

{
    [ -n "$HOST" ] && echo "OTA_HOST=${HOST}"
    echo "OTA_CTRL_PORT=${PORT}"
} > "$mnt/unitotem-ota.conf"

echo "UNITOTEM_OTA_WIPE_DATA=${WIPE_DATA}" > "$mnt/unitotem-ota.request"

# Raspberry with tryboot: show the deploy screen at a low resolution (it is a text UI, unreadable at
# native size on large monitors). The reboot goes through tryboot.txt (a copy of config.txt plus a
# command line forcing 640x480 on both HDMI connectors), which the firmware reads for ONE boot only:
# config.txt and the slot's cmdline.txt are never touched, so the next plain boot is the normal one.
TRYBOOT=0
if [ -d /proc/device-tree/chosen/bootloader ] && [ -f "$mnt/config.txt" ]; then
    prefix=$(sed -n 's/^os_prefix=//p' "$mnt/config.txt" | tail -1)
    if [ -f "$mnt/${prefix}cmdline.txt" ]; then
        { read -r base < "$mnt/${prefix}cmdline.txt"; printf '%s video=HDMI-A-1:640x480@60 video=HDMI-A-2:640x480@60\n' "$base" > "$mnt/${prefix}cmdline-ota.txt"; } \
          && { cat "$mnt/config.txt"; printf '\n[all]\ncmdline=cmdline-ota.txt\n'; } > "$mnt/tryboot.txt.new" \
          && mv -f "$mnt/tryboot.txt.new" "$mnt/tryboot.txt" && TRYBOOT=1
    fi
fi

sync
umount "$mnt" 2>/dev/null || true

echo "Armed. Rebooting..."
sync
# setsid, not just nohup: nohup only ignores SIGHUP, and the login session's cgroup-level kill on
# close would still reap the reboot. The reboot is also delayed so this script exits and the SSH
# session closes cleanly before sshd goes down (otherwise ssh reports a false failure to the caller).
if [ "$TRYBOOT" = 1 ]; then
    # "0 tryboot" is what makes the firmware read tryboot.txt instead of config.txt on the next boot.
    setsid nohup sh -c 'sleep 5; exec systemctl reboot --reboot-argument="0 tryboot"' >/dev/null 2>&1 < /dev/null &
else
    setsid nohup sh -c 'sleep 5; exec reboot' >/dev/null 2>&1 < /dev/null &
fi
sleep 1
