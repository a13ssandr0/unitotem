# Whitelist of paths re-imported from DATA's old /etc overlay after an OTA (read by ota-engine.sh migrate-etc-overlay).
# Additive only: the new image's /etc wins; never list structural files (fstab, units, initramfs-tools config, PAM).
# ssh/ssh_host_* is NOT listed: unitotem-ssh-hostkey.service restores the keys from DATA on every boot.
OTA_PRESERVE_LIST_VERSION=1

hostname
hosts
machine-id
NetworkManager/system-connections/*
netplan/*
localtime
timezone
vconsole.conf
default/keyboard
unitotem*
unitotem*/**
ssl/unitotem.pem
