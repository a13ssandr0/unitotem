[Unit]
Description=UniTotem - uploaded media, crontab and browser profile persisted on DATA
After=local-fs.target
Before=cron.service unitotem-manager.service
RequiresMountsFor=/mnt/data

[Service]
Type=oneshot
ExecStart=/usr/sbin/unitotem-persist-paths
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
