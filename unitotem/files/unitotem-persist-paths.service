[Unit]
Description=UniTotem - uploaded media, crontab, browser profile and home directories persisted on DATA
After=local-fs.target
Before=cron.service unitotem-manager.service ssh.service systemd-user-sessions.service
RequiresMountsFor=/mnt/data

[Service]
Type=oneshot
ExecStart=/usr/sbin/unitotem-persist-paths
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
