#!/usr/bin/env python3
"""unitotem-update - check/fetch/apply whole-image updates (see docs/system/ab-updates.md).

Commands: status, check, fetch, apply, confirm, boot-ok, rollback, cancel, repair, policy, auto, reboot.
Two ROOT slots (A/B); the boot backend is GRUB on the ESP (amd64) or the firmware's tryboot (Raspberry Pi).
Without a recognised backend the slot-switch commands exit 2 "backend-unsupported".

Exit codes: 0 ok / update available   10 nothing to do   11 (reserved: changes need acceptance)
            12 operation already running   13 no rollback available   2 failed   127 (shell) command absent.
Everything is JSON with --json; progress for long operations goes to /run/unitotem-update.progress as ONE json
line rewritten atomically. `fetch` runs detached (systemd-run) unless --foreground, so a manager restart
does not interrupt it; poll `status`.
"""
import argparse, datetime, fcntl, glob, hashlib, json, os, re, shutil, signal, ssl, subprocess, sys, tempfile, time
import urllib.request, urllib.error
sys.path.insert(0, "/usr/lib/unitotem")          # unitotem_identity (the account merge)

CONF_DEFAULTS = {
    "UPDATE_BASE_URL": "https://github.com/a13ssandr0/unitotem",
    "UPDATE_CHANNEL": "stable",
    "UPDATE_KEYS_DIR": "/usr/share/unitotem/update-keys",
    "UPDATE_STATE_DIR": "/mnt/data/unitotem/update",
    "UPDATE_VERSION_FILE": "/usr/share/unitotem/release-version",
    "UPDATE_GRUBENV": "/boot/efi/unitotem-grub/grub/grubenv",
    "UPDATE_ESP_MOUNT": "/boot/efi",                         # amd64: where the ESP (grubenv) is mounted
    "UPDATE_BOOTFS": "/boot/firmware",                       # Raspberry Pi: the FAT partition the firmware reads
    "UPDATE_BACKEND": "",                                    # "grub" | "rpi"; empty = detect
    "UPDATE_DT_BOOTLOADER": "/proc/device-tree/chosen/bootloader",  # exists on boards with the EEPROM bootloader (tryboot)
    "UPDATE_CRASHPOINT": "",                                 # test hook: freeze at the named point (power-cut tests)
    "UPDATE_REBOOT_CMD": "",                                 # test hook: replaces the real reboot
    "UPDATE_DATA": "/mnt/data",
    "UPDATE_ETC_CURRENT": "/etc",                 # the running system's /etc (source of the local accounts to carry over)
    "UPDATE_CMDLINE": "/proc/cmdline",
    "UPDATE_RUN_DIR": "/run",
    "UPDATE_SYS_DIR": "/sys",                     # sysfs and procfs roots: where the I/O settings of an image write are applied
    "UPDATE_VM_DIR": "/proc/sys/vm",
    "UPDATE_HEALTH_URL": "https://localhost/health",   # empty = no health gate
    "UPDATE_HEALTH_TIMEOUT": "180",
    "UPDATE_AUTOREPAIR": "1",                     # rebuild a damaged other slot from the running one after a plain boot
}
TIMEOUT = 30


class Fail(Exception):
    def __init__(self, code, msg, rc=2):
        super().__init__(msg); self.code = code; self.rc = rc


def load_conf():
    conf = dict(CONF_DEFAULTS)
    path = os.environ.get("UNITOTEM_UPDATE_CONF", "/etc/unitotem/update.conf")
    if os.path.isfile(path):
        for line in open(path):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1); conf[k.strip()] = v.strip().strip('"')
    for k in conf:  # environment wins: lets tests redirect everything without touching /etc
        if "UNITOTEM_" + k in os.environ:
            conf[k] = os.environ["UNITOTEM_" + k]
    return conf


def crashpoint(conf, name):
    """Power-cut test hook. When UPDATE_CRASHPOINT names this point the process announces it on the serial
    console and then blocks forever, so a test harness can kill the VM at exactly this moment and see what
    the disk looks like. A no-op unless configured."""
    if conf.get("UPDATE_CRASHPOINT") != name:
        return
    # One-shot: strip the key from the persistent config first, so the boot after the "power cut" does not
    # freeze at the same point again. Synced, so the stripped file is part of the state the test inherits.
    cf = os.environ.get("UNITOTEM_UPDATE_CONF", "/etc/unitotem/update.conf")
    try:
        lines = [l for l in open(cf).read().splitlines() if not l.startswith("UPDATE_CRASHPOINT=")]
        _atomic_write(cf, "\n".join(lines) + "\n"); os.sync()
    except OSError:
        pass
    try:
        with open("/dev/ttyS0", "w") as f: f.write(f"\nCRASHPOINT {name}\n")
    except OSError:
        pass
    sys.stderr.write(f"CRASHPOINT {name}\n"); sys.stderr.flush()
    time.sleep(10 ** 6)


def vkey(v):
    return [int(x) if x.isdigit() else x for x in v.replace("-", ".").split(".")]


def current_version(conf):
    try:
        return open(conf["UPDATE_VERSION_FILE"]).read().strip() or "0"
    except OSError:
        return "0"


def get(url):
    try:
        with urllib.request.urlopen(url, timeout=TIMEOUT) as r:
            return r.read()
    except (urllib.error.URLError, OSError) as e:
        raise Fail("network", f"{url}: {e}")


def verify(pub_pem, data, sig):
    with tempfile.TemporaryDirectory() as d:
        paths = []
        for name, content, mode in (("pub", pub_pem, "w"), ("data", data, "wb"), ("sig", sig, "wb")):
            p = os.path.join(d, name)
            with open(p, mode) as f: f.write(content)
            paths.append(p)
        r = subprocess.run(["openssl", "pkeyutl", "-verify", "-pubin", "-inkey", paths[0], "-rawin",
                            "-in", paths[1], "-sigfile", paths[2]], capture_output=True)
        return r.returncode == 0


def state_path(conf, name):
    return os.path.join(conf["UPDATE_STATE_DIR"], name)


def event(conf, text):
    """Forensic trail of what touched the persistent state, on DATA next to it (bounded to ~64 KB). Written
    best-effort and never allowed to break an operation; it exists so that a power-cut finding can be explained."""
    try:
        path = state_path(conf, "events.log")
        if os.path.exists(path) and os.path.getsize(path) > 65536:
            os.replace(path, path + ".old")
        with open(path, "a") as f:
            f.write(f"{time.strftime('%H:%M:%S', time.gmtime())} pid={os.getpid()} {' '.join(sys.argv[1:])[:60]} {text}\n")
    except OSError:
        pass


def read_state(conf, name, default=None):
    try:
        return json.load(open(state_path(conf, name)))
    except FileNotFoundError:
        if name in ("slots.json", "pending.json"): event(conf, f"read {name}: missing")
        return default
    except (OSError, ValueError) as e:
        event(conf, f"read {name}: UNREADABLE ({type(e).__name__})")
        return default


def write_state(conf, name, obj):
    os.makedirs(conf["UPDATE_STATE_DIR"], exist_ok=True)
    tmp = state_path(conf, name) + ".tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f); f.flush(); os.fsync(f.fileno())
    os.replace(tmp, state_path(conf, name))
    event(conf, f"write {name}: {json.dumps(obj)[:200]}")
    try:
        fd = os.open(conf["UPDATE_STATE_DIR"], os.O_RDONLY); os.fsync(fd); os.close(fd)
    except OSError:
        pass


def fetch_trusted(conf):
    """Return (manifest, base) after verifying keys.json against the root key and the manifest against it."""
    if conf["UPDATE_CHANNEL"] != "stable":
        raise Fail("channel-unsupported", "only the stable channel is supported")
    base = conf["UPDATE_BASE_URL"].rstrip("/") + "/releases/latest/download/"
    try:
        root_pub = open(os.path.join(conf["UPDATE_KEYS_DIR"], "root.pub")).read()
    except OSError as e:
        raise Fail("no-root-key", f"root key missing: {e}")
    keys_raw, keys_sig = get(base + "keys.json"), get(base + "keys.json.sig")
    if not verify(root_pub, keys_raw, keys_sig):
        raise Fail("bad-keys-signature", "keys.json is not signed by the root key")
    keys = json.loads(keys_raw)
    seen = read_state(conf, "keys-seq.json", {}).get("seq", 0)
    if keys["seq"] < seen:
        raise Fail("keys-rollback", f"keys.json seq {keys['seq']} < already seen {seen}")
    man_raw, man_sig = get(base + "manifest.json"), get(base + "manifest.json.sig")
    if not any(verify(k["pub"], man_raw, man_sig) for k in keys["keys"]):
        raise Fail("bad-manifest-signature", "manifest is not signed by any authorised key")
    manifest = json.loads(man_raw)
    if manifest.get("min_updater", 1) > 1:
        raise Fail("updater-too-old", f"unitotem-update >= {manifest['min_updater']} required")
    # Only after everything verified: remember the key-list generation, so an old signed list can't come back.
    if keys["seq"] > seen:
        try: write_state(conf, "keys-seq.json", {"seq": keys["seq"]})
        except OSError: pass
    return manifest


# Inspired by Android A/B: two root slots, one-shot trial boot, confirm or roll back
# ---------------------------------------------------------------------------
# A/B plumbing (GRUB and Raspberry backends)
# ---------------------------------------------------------------------------
def cur_slot(conf):
    try:
        for tok in open(conf["UPDATE_CMDLINE"]).read().split():
            if tok.startswith("unitotem.slot=") and tok[-1] in "ab":
                return tok[-1]
    except OSError:
        pass
    return None


def other_slot(s):
    return "b" if s == "a" else "a"


def label(slot):
    return "ROOT_" + slot.upper()


def run_out(*cmd, check=True):
    r = subprocess.run(cmd, capture_output=True, text=True)
    if check and r.returncode:
        raise Fail("command-failed", f"{' '.join(cmd)}: {r.stderr.strip() or r.stdout.strip()}")
    return r.stdout.strip()


class io_friendly:
    """Keep the system usable while an image is written to a slow disk (SD card, USB stick): the I/O scheduler bfq serves the
    synchronous reads of the manager and sshd ahead of the stream of writes, and a small cap on dirty pages makes the writes go
    out steadily instead of as bursts of hundreds of MB that fill the card for seconds. Everything is put back by restore();
    the values to put back are kept in a run-time file, so a killed run is undone by the next one (a reboot undoes it anyway).
    NVMe and virtual disks keep their settings. Failures are logged and never stop the update."""
    DIRTY = {"dirty_background_bytes": 16 << 20, "dirty_bytes": 64 << 20}
    # The kernel keeps a ratio or a byte value per limit, never both: writing one form zeroes the other, and the bytes cannot be
    # set back to 0 while the ratios are 0. So the form that was active is written back, dirty_ratio before dirty_background_ratio.
    KEYS = ("dirty_background_bytes", "dirty_bytes", "dirty_background_ratio", "dirty_ratio")
    SLOW = re.compile(r"mmcblk\d+|sd[a-z]+")

    def __init__(self, conf, dev):
        self.conf, self.dev, self.disk, self.saved = conf, dev, None, None
        self.state = os.path.join(conf["UPDATE_RUN_DIR"], "unitotem-update-io.json")

    def _disk(self):
        part = os.path.basename(os.path.realpath(self.dev))
        link = os.path.join(self.conf["UPDATE_SYS_DIR"], "class/block", part)
        if os.path.exists(os.path.join(link, "partition")):
            return os.path.basename(os.path.dirname(os.path.realpath(link)))
        return part

    def _write(self, path, value):
        with open(path, "w") as f: f.write(str(value))

    def _put_back(self, saved):
        sysd, vmd = self.conf["UPDATE_SYS_DIR"], self.conf["UPDATE_VM_DIR"]
        vm = saved.get("vm", {})
        if vm.get("dirty_bytes", "0") != "0":
            order = ("dirty_bytes", "dirty_background_bytes")
        else:
            order = ("dirty_ratio", "dirty_background_ratio")
        errors = []
        for k in order:
            if k in vm:
                try: self._write(os.path.join(vmd, k), vm[k])
                except OSError as e: errors.append(f"{k}: {e}")
        if saved.get("sched"):
            try: self._write(os.path.join(sysd, "block", saved["disk"], "queue/scheduler"), saved["sched"])
            except OSError as e: errors.append(f"scheduler: {e}")
        if errors:
            raise OSError("; ".join(errors))

    def apply(self):
        try:
            if os.path.exists(self.state):                       # an earlier run died before restoring
                self._put_back(json.load(open(self.state))); os.unlink(self.state)
            disk = self._disk()
            if not self.SLOW.fullmatch(disk):
                return
            sysd, vmd = self.conf["UPDATE_SYS_DIR"], self.conf["UPDATE_VM_DIR"]
            sched_path = os.path.join(sysd, "block", disk, "queue/scheduler")
            text = open(sched_path).read()
            cur = re.search(r"\[([^\]]+)\]", text)
            has_bfq = "bfq" in text.replace("[", " ").replace("]", " ").split()
            saved = {"disk": disk, "sched": cur.group(1) if cur and has_bfq else None,
                     "vm": {k: open(os.path.join(vmd, k)).read().strip() for k in self.KEYS}}
            _atomic_write(self.state, json.dumps(saved))
            self.saved, self.disk = saved, disk
            if saved["sched"] and saved["sched"] != "bfq":
                self._write(sched_path, "bfq")
            # writing the byte values makes them the active limits (the kernel zeroes the ratios)
            for k in ("dirty_bytes", "dirty_background_bytes"):
                self._write(os.path.join(vmd, k), self.DIRTY[k])
            event(self.conf, f"update I/O: {disk} scheduler bfq, dirty pages capped at {self.DIRTY['dirty_bytes'] >> 20} MiB")
        except Exception as e:
            event(self.conf, f"update I/O tuning skipped: {e}")

    def restore(self):
        if not self.saved: return
        try:
            self._put_back(self.saved); os.unlink(self.state)
            event(self.conf, f"update I/O: {self.disk} settings restored")
        except Exception as e:
            event(self.conf, f"update I/O restore failed: {e}")
        self.saved = None


def backend(conf):
    if conf["UPDATE_BACKEND"]:
        return conf["UPDATE_BACKEND"]
    if os.path.exists(conf["UPDATE_GRUBENV"]):
        return "grub"
    if os.path.exists(os.path.join(conf["UPDATE_BOOTFS"], "config.txt")):
        return "rpi"
    return None


def need_backend(conf):
    if cur_slot(conf) is None:
        raise Fail("not-ab", "this system was not booted from an A/B slot")
    be = backend(conf)
    if be is None:
        raise Fail("backend-unsupported", "no known boot backend (neither GRUB A/B nor Raspberry firmware)")
    if be == "rpi" and not os.path.isdir(conf["UPDATE_DT_BOOTLOADER"]):
        # Without the EEPROM bootloader there is no tryboot: no firmware-level one-shot, so a power cut
        # during a trial could leave the board on the new slot with nothing to bring it back.
        raise Fail("backend-unsupported", "this Raspberry board has no tryboot (EEPROM bootloader): A/B update not supported")
    return be


def _atomic_write(path, text):
    tmp = path + ".new"
    with open(tmp, "w") as f:
        f.write(text); f.flush(); os.fsync(f.fileno())
    os.replace(tmp, path)


def _rpi_prefix(text, slot):
    """config.txt text with os_prefix pointing at SLOT (inserted under the first [all] if absent)."""
    import re
    line = f"os_prefix=slot{slot}/"
    if re.search(r"(?m)^os_prefix=.*$", text):
        return re.sub(r"(?m)^os_prefix=.*$", line, text, count=1)
    if re.search(r"(?m)^\[all\]\s*$", text):
        return re.sub(r"(?m)^\[all\]\s*$", "[all]\n" + line, text, count=1)
    return line + "\n" + text


def be_default_slot(conf):
    be = backend(conf)
    if be == "grub":
        return grubenv_get(conf, "saved_entry").replace("slot-", "") or None
    import re
    try:
        m = re.search(r"(?m)^os_prefix=slot([ab])/", open(os.path.join(conf["UPDATE_BOOTFS"], "config.txt")).read())
        return m.group(1) if m else None
    except OSError:
        return None


def be_arm_trial(conf, slot):
    """One-shot boot of SLOT. grub: next_entry (GRUB clears it before booting). Raspberry: tryboot.txt, which the
    firmware reads only on a boot requested with the tryboot flag - a plain reboot ignores it."""
    if backend(conf) == "grub":
        grubenv(conf, "set", f"next_entry=slot-{slot}")
        return
    bf = conf["UPDATE_BOOTFS"]
    cfg = open(os.path.join(bf, "config.txt")).read()
    with bootfs_rw(bf):
        _atomic_write(os.path.join(bf, "tryboot.txt"), _rpi_prefix(cfg, slot))


def be_set_default(conf, slot):
    if backend(conf) == "grub":
        grubenv(conf, "set", f"saved_entry=slot-{slot}")
        grubenv(conf, "unset", "next_entry")
        return
    bf = conf["UPDATE_BOOTFS"]
    # Promote FROM the trial config when there is one: after a first deploy config.txt is still the fallback's
    # (kernel=recovery8.img) and tryboot.txt is the only complete description of the real system; in steady state
    # tryboot.txt is config.txt plus the new os_prefix, so the result is the same either way.
    trial = os.path.join(bf, "tryboot.txt")
    src = trial if os.path.exists(trial) else os.path.join(bf, "config.txt")
    cfg = open(src).read()
    with bootfs_rw(bf):
        _atomic_write(os.path.join(bf, "config.txt"), _rpi_prefix(cfg, slot))
        try: os.unlink(trial)
        except OSError: pass


def be_reboot(conf, trial=False, delay=3):
    if conf["UPDATE_REBOOT_CMD"]:
        subprocess.Popen(conf["UPDATE_REBOOT_CMD"], shell=True, env=dict(os.environ, UNITOTEM_REBOOT_TRIAL="1" if trial else "0"))
        return
    cmd = ["systemctl", "reboot"]
    if trial and backend(conf) == "rpi":
        cmd += ["--reboot-argument=0 tryboot"]        # the argument the Pi firmware reads to honour tryboot.txt
    subprocess.Popen(["systemd-run", f"--on-active={delay}", "--quiet"] + cmd)


class bootfs_rw:
    """The boot FAT is mounted read-only (fstab), so every write goes through here: remount rw, do the write, sync,
    remount ro. A no-op where PATH is not a mount point (tests; a system whose fstab predates the ro mount)."""
    def __init__(self, path):
        self.path = path; self.on = False

    def __enter__(self):
        if os.path.ismount(self.path):
            r = subprocess.run(["mount", "-o", "remount,rw", self.path], capture_output=True, text=True)
            if r.returncode:
                raise Fail("bootfs-rw", f"cannot remount {self.path} read-write: {r.stderr.strip()}")
            self.on = True
        return self

    def __exit__(self, *e):
        if self.on:
            subprocess.run(["sync"])
            subprocess.run(["mount", "-o", "remount,ro", self.path], capture_output=True)


def grubenv(conf, op, *kv):
    if op in ("set", "unset"):
        with bootfs_rw(conf["UPDATE_ESP_MOUNT"]):
            return run_out("grub-editenv", conf["UPDATE_GRUBENV"], op, *kv)
    return run_out("grub-editenv", conf["UPDATE_GRUBENV"], op, *kv)


def grubenv_get(conf, key):
    for line in grubenv(conf, "list").splitlines():
        if line.startswith(key + "="):
            return line.split("=", 1)[1]
    return ""


def slots_state(conf):
    st = read_state(conf, "slots.json", {})
    for s_ in "ab":
        st.setdefault(s_, {"version": None, "valid": False})
    return st


def progress(conf, **kw):
    path = os.path.join(conf["UPDATE_RUN_DIR"], "unitotem-update.progress")
    tmp = path + ".tmp"
    try:
        with open(tmp, "w") as f: json.dump(kw, f)
        os.replace(tmp, path)
    except OSError:
        pass


def read_progress(conf):
    try:
        return json.load(open(os.path.join(conf["UPDATE_RUN_DIR"], "unitotem-update.progress")))
    except (OSError, ValueError):
        return None


class Lock:
    """One long operation at a time; the pid file lets `cancel` find it."""
    def __init__(self, conf):
        self.path = os.path.join(conf["UPDATE_RUN_DIR"], "unitotem-update.lock")
        self.f = None

    def __enter__(self):
        self.f = open(self.path, "a+")
        try:
            fcntl.flock(self.f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            raise Fail("busy", "another update operation is running", rc=12)
        self.f.seek(0); self.f.truncate(); self.f.write(str(os.getpid())); self.f.flush()
        return self

    def __exit__(self, *e):
        try: os.unlink(self.path)
        except OSError: pass
        self.f.close()


def op_running(conf):
    path = os.path.join(conf["UPDATE_RUN_DIR"], "unitotem-update.lock")
    try:
        with open(path, "a+") as f:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB); fcntl.flock(f, fcntl.LOCK_UN)
                return None
            except OSError:
                f.seek(0); return int(f.read().strip() or 0)
    except (OSError, ValueError):
        return None


def set_last_result(conf, **kw):
    kw["at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    write_state(conf, "last-result.json", kw)


def prepare_overlays(conf, new_slot, old_slot, new_root_mnt):
    """Give the new slot its own overlay upper dirs on DATA: /etc starts from the whitelist
    (ota-preserve.list of the NEW image) imported from the current slot's /etc, /root is carried over
    whole, /var starts empty (persistent things live under DATA/unitotem/persist). The current slot's
    uppers are left untouched, which is what makes a rollback land on its own state."""
    data = conf["UPDATE_DATA"]
    for d in ("etc", "root", "var"):
        for kind in ("upper", "work"):
            shutil.rmtree(os.path.join(data, kind, f"{d}.{new_slot}"), ignore_errors=True)
            os.makedirs(os.path.join(data, kind, f"{d}.{new_slot}"))
    plist = os.path.join(new_root_mnt, "etc/unitotem/ota-preserve.list")
    # Keep the new image's whitelist: `apply` runs without that slot mounted and re-imports with it.
    try: shutil.copy2(plist, state_path(conf, "preserve.list"))
    except OSError: pass
    n = import_whitelist(conf, new_slot, old_slot, plist)
    merge_identity_into(conf, new_slot, new_root_mnt)
    old_root = os.path.join(data, "upper", f"root.{old_slot}")
    if os.path.isdir(old_root):
        shutil.copytree(old_root, os.path.join(data, "upper", f"root.{new_slot}"), symlinks=True, dirs_exist_ok=True)
    return n


def merge_identity_into(conf, new_slot, new_root_mnt=None):
    """Local accounts across the update: the new slot's passwd/shadow/group/gshadow = the new image's + the local part of the running
    system's (see unitotem/files/unitotem_identity.py for the rules). Re-run at `apply` from the image files saved at `fetch` (that slot
    is not mounted then). Never raises and never fails the update: on any problem the new slot just gets the image's own files, and
    that is logged and shown in `status` (identity_merge)."""
    data = conf["UPDATE_DATA"]
    dest = os.path.join(data, "upper", f"etc.{new_slot}")
    base_dir = state_path(conf, "identity-base")
    try:
        import unitotem_identity as ident
        if new_root_mnt:
            shutil.rmtree(base_dir, ignore_errors=True)
            os.makedirs(base_dir)
            for n in ident.FILES:
                try: shutil.copy2(os.path.join(new_root_mnt, "etc", n), os.path.join(base_dir, n))
                except OSError: pass
        res = ident.apply_merge(base_dir, conf["UPDATE_ETC_CURRENT"], dest)
    except Exception as e:                                   # the module itself is missing/broken
        res = {"ok": False, "detail": f"identity merge not run ({e}): the new slot uses the image's own account files", "log": []}
    res["slot"] = new_slot
    res["at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    try: write_state(conf, "identity-merge.json", res)
    except OSError: pass
    try: event(conf, f"identity merge slot {new_slot}: {'ok' if res['ok'] else 'FAILED'}: {res['detail'][:160]}")
    except Exception: pass
    if not res["ok"]:
        print(f"WARNING: {res['detail']}", file=sys.stderr)
    return res


def import_whitelist(conf, new_slot, old_slot, plist):
    """Copy the whitelisted /etc paths from the OLD slot's overlay upper into the NEW slot's. Run again at
    `apply`, so settings changed between the download and the switch are not silently left behind."""
    data = conf["UPDATE_DATA"]
    old_etc = os.path.join(data, "upper", f"etc.{old_slot}")
    new_etc = os.path.join(data, "upper", f"etc.{new_slot}")
    n = 0
    if os.path.isfile(plist):
        for line in open(plist):
            pat = line.strip()
            if not pat or pat.startswith("#") or "=" in pat:
                continue
            for src in glob.glob(os.path.join(old_etc, pat)):
                rel = os.path.relpath(src, old_etc)
                dst = os.path.join(new_etc, rel)
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                if os.path.isdir(src) and not os.path.islink(src):
                    shutil.copytree(src, dst, symlinks=True, dirs_exist_ok=True)
                else:
                    # Copy beside, then rename: a power cut leaves the old file or the new one, never half.
                    tmp = dst + ".unitotem-new"
                    shutil.copy2(src, tmp, follow_symlinks=False)
                    os.replace(tmp, dst)
                n += 1
    return n


