def cmd_status(a, conf):
    cur = cur_slot(conf)
    out = {"layout": 2 if cur else 1, "ab": bool(cur), "current_version": current_version(conf),
           "slot": cur, "other_slot": other_slot(cur) if cur else None, "trial": False,
           "pending_confirm": False, "rollback_available": False, "op": None,
           "last_result": read_state(conf, "last-result.json"), "base_url": conf["UPDATE_BASE_URL"]}
    pid = op_running(conf)
    if pid:
        out["op"] = {"pid": pid, "progress": read_progress(conf)}
    if cur:
        st = slots_state(conf)
        pend = read_state(conf, "pending.json")
        out["trial"] = bool(pend and pend.get("slot") == cur)
        out["pending_confirm"] = out["trial"]
        o = other_slot(cur)
        out["other_version"] = st[o].get("version")
        out["rollback_available"] = bool(st[o].get("valid") and st[o].get("confirmed") and not pid)
        out["armed"] = pend if (pend and pend.get("slot") != cur) else None
        out["staged"] = bool(out["armed"] and out["armed"].get("staged"))
        out["auto"] = {"policy": auto_policy(conf), "state": read_state(conf, "auto-state.json", {}) or {}}
        out["identity_merge"] = read_state(conf, "identity-merge.json")
        try:
            out["default_slot"] = be_default_slot(conf)
        except Fail:
            out["default_slot"] = None
    return 0, out


def cmd_check(a, conf):
    m = fetch_trusted(conf)
    cur = current_version(conf)
    avail = vkey(m["version"]) > vkey(cur)
    total = sum(p["size"] for p in m["parts"])
    out = {"available": avail, "current_version": cur, "version": m["version"], "channel": m["channel"],
           "arch": m.get("arch"), "layout": m["layout"], "size": total,
           "needs_layout_migration": m["layout"] != (2 if cur_slot(conf) else 1)}
    return (0 if avail else 10), out


class Cancelled(Exception):
    pass


def rpi_install_bootfiles(conf, cur, new, manifest, base):
    """Raspberry: the firmware reads kernel, initramfs, dtbs and overlays from the FAT partition, not from
    ROOT, so a slot is only bootable once its own boot files sit in <bootfs>/slot<new>/. They travel as a
    separate release asset (the image's slot directory, tar+xz). The firmware proper (start*.elf, fixup*.dat)
    is shared and NOT replaced here."""
    part = next((p for p in manifest["parts"] if p.get("role") == "bootfiles"), None)
    if not part:
        raise Fail("no-bootfiles-part", "the manifest has no part with role=bootfiles")
    bf = conf["UPDATE_BOOTFS"]
    tmp = os.path.join(bf, f"slot{new}.new")
    shutil.rmtree(tmp, ignore_errors=True)
    os.makedirs(tmp)
    h = hashlib.sha256(); done = 0
    xz = subprocess.Popen(["xz", "-dc", "-T1"], stdin=subprocess.PIPE, stdout=subprocess.PIPE)
    # --no-same-owner/-permissions: the destination is a FAT, which has no owners; tar as root otherwise fails every
    # file with "Cannot change ownership" and exits 2.
    tar = subprocess.Popen(["tar", "--no-same-owner", "--no-same-permissions", "-C", tmp, "-xf", "-"], stdin=xz.stdout)
    xz.stdout.close()
    try:
        with urllib.request.urlopen(base + part["file"], timeout=TIMEOUT) as r:
            while True:
                chunk = r.read(1 << 20)
                if not chunk: break
                h.update(chunk); done += len(chunk); xz.stdin.write(chunk)
        xz.stdin.close()
    except (urllib.error.URLError, OSError) as e:
        xz.kill(); tar.kill(); shutil.rmtree(tmp, ignore_errors=True)
        raise Fail("network", f"boot files download interrupted: {e}")
    xz.wait(); tar.wait()
    if xz.returncode or tar.returncode:
        shutil.rmtree(tmp, ignore_errors=True)
        raise Fail("bootfiles-failed", f"xz rc={xz.returncode} tar rc={tar.returncode}")
    if done != part["size"] or h.hexdigest() != part["sha256"]:
        shutil.rmtree(tmp, ignore_errors=True)
        raise Fail("bad-checksum", "boot files sha256/size does not match the manifest")
    for need in ("kernel8.img", "initramfs8"):
        if not os.path.isfile(os.path.join(tmp, need)) or os.path.getsize(os.path.join(tmp, need)) == 0:
            shutil.rmtree(tmp, ignore_errors=True)
            raise Fail("bad-bootfiles", f"{need} missing or empty in the boot files")
    # cmdline.txt: this slot's own root=, derived from the slot we are running so console/quiet options stay.
    import re
    src = os.path.join(bf, f"slot{cur}", "cmdline.txt")
    try:
        cmd = open(src).read().strip()
    except OSError:
        shutil.rmtree(tmp, ignore_errors=True)
        raise Fail("no-cmdline", f"{src} not readable")
    cmd = re.sub(r"root=LABEL=\S+", f"root=LABEL={label(new)}", cmd)
    cmd = re.sub(r"unitotem\.slot=\S+", f"unitotem.slot={new}", cmd)
    if f"unitotem.slot={new}" not in cmd:
        cmd += f" unitotem.slot={new}"
    with open(os.path.join(tmp, "cmdline.txt"), "w") as f:
        f.write(cmd + "\n"); f.flush(); os.fsync(f.fileno())
    final = os.path.join(bf, f"slot{new}")
    old = final + ".old"
    shutil.rmtree(old, ignore_errors=True)
    if os.path.exists(final):
        os.rename(final, old)
    os.rename(tmp, final)
    shutil.rmtree(old, ignore_errors=True)
    subprocess.run(["sync"])


def do_fetch(a, conf):
    need_backend(conf)
    cur = cur_slot(conf); new = other_slot(cur)
    with Lock(conf):
        def on_term(*_): raise Cancelled()
        signal.signal(signal.SIGTERM, on_term)
        dev = None; iof = None
        st = slots_state(conf)
        try:
            progress(conf, op="fetch", phase="check", state="running", percent=0)
            m = fetch_trusted(conf)
            if m["layout"] != 2:
                raise Fail("layout-mismatch", f"the release is for layout {m['layout']}, this system is layout 2")
            if vkey(m["version"]) <= vkey(current_version(conf)) and not a.force:
                raise Fail("not-newer", f"{m['version']} is not newer than {current_version(conf)}", rc=10)
            part = next((p for p in m["parts"] if p.get("role") == "root"), None)
            if not part:
                raise Fail("no-root-part", "the manifest has no part with role=root")
            # By GPT partition name, not filesystem label: a slot that lost power mid-write has a neutral or
            # stale label, and must still be findable to be rewritten.
            dev = run_out("blkid", "-t", f"PARTLABEL={label(new)}", "-o", "device", check=False).splitlines()
            dev = dev[0] if dev else run_out("blkid", "-L", label(new), check=False)
            if not dev:
                raise Fail("no-slot-device", f"partition {label(new)} not found")
            if subprocess.run(["findmnt", "-S", dev], capture_output=True).returncode == 0:
                raise Fail("slot-mounted", f"{dev} is mounted: refusing to write to it")
            # Point of no return for the old contents of the inactive slot: from here it is not a
            # valid rollback target until the write has been verified.
            # The slot we are running from is by definition a system that boots: record it, so it is a
            # legitimate rollback target after the update whether or not a boot-ok ever ran on it.
            st[cur] = {"version": current_version(conf), "valid": True, "prepared": True, "confirmed": True}
            st[new] = {"version": None, "valid": False}
            write_state(conf, "slots.json", st)
            crashpoint(conf, "fetch_after_invalidate")
            try: os.unlink(state_path(conf, "pending.json"))
            except OSError: pass
            base = conf["UPDATE_BASE_URL"].rstrip("/") + "/releases/latest/download/"
            total = part["size"]; done = 0; h = hashlib.sha256()
            iof = io_friendly(conf, dev); iof.apply()
            xz = subprocess.Popen(["xz", "-dc", "-T1"], stdin=subprocess.PIPE, stdout=subprocess.PIPE)   # one thread: the disk is the limit, the other cores stay free
            pc = subprocess.Popen(["partclone.restore", "-C", "-s", "-", "-o", dev], stdin=xz.stdout,
                                  stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
            xz.stdout.close()
            t0 = time.monotonic(); last = 0
            try:
                with urllib.request.urlopen(base + part["file"], timeout=TIMEOUT) as r:
                    while True:
                        chunk = r.read(1 << 20)
                        if not chunk: break
                        h.update(chunk); done += len(chunk)
                        xz.stdin.write(chunk)
                        if done * 2 >= total: crashpoint(conf, "fetch_mid_write")
                        if time.monotonic() - last > 1:
                            last = time.monotonic()
                            rate = done / max(last - t0, 1e-3)
                            progress(conf, op="fetch", phase="write", state="running",
                                     percent=int(done * 100 / total), bytes=done, total=total,
                                     eta_s=int((total - done) / rate) if rate else None)
                xz.stdin.close()
            except (urllib.error.URLError, OSError) as e:
                xz.kill(); pc.kill()
                raise Fail("network", f"download interrupted: {e}")
            xz.wait(); err = pc.communicate()[1].decode(errors="replace")
            if xz.returncode or pc.returncode:
                raise Fail("write-failed", f"xz rc={xz.returncode} partclone rc={pc.returncode}: {err[-300:]}")
            crashpoint(conf, "fetch_after_write")
            progress(conf, op="fetch", phase="verify", state="running", percent=100, bytes=done, total=total)
            if done != total or h.hexdigest() != part["sha256"]:
                raise Fail("bad-checksum", "downloaded asset sha256/size does not match the manifest")
            run_out("e2fsck", "-fn", dev)
            # partclone copies the label and UUID with the data: give this slot its own identity.
            run_out("tune2fs", "-L", label(new), "-U", "random", dev)
            crashpoint(conf, "fetch_after_relabel")
            mnt = tempfile.mkdtemp(prefix="unitotem-slot-")
            run_out("mount", "-o", "ro", dev, mnt)
            try:
                ver = open(os.path.join(mnt, "usr/share/unitotem/release-version")).read().strip()
                if ver != m["version"]:
                    raise Fail("version-mismatch", f"the written image reports {ver}, the manifest says {m['version']}")
                if not os.path.exists(os.path.join(mnt, "usr/lib/systemd/systemd")):
                    raise Fail("bad-image", "systemd missing in the written slot")
                progress(conf, op="fetch", phase="arm", state="running", percent=100)
                if backend(conf) == "rpi":
                    with bootfs_rw(conf["UPDATE_BOOTFS"]):
                        rpi_install_bootfiles(conf, cur, new, m, base)
                imported = prepare_overlays(conf, new, cur, mnt)
            finally:
                subprocess.run(["umount", mnt]); os.rmdir(mnt)
            crashpoint(conf, "fetch_before_valid")
            # Everything the flag vouches for must be on disk BEFORE the flag is: flush, then write it.
            os.sync()
            st[new] = {"version": m["version"], "valid": True, "prepared": True}
            write_state(conf, "slots.json", st)
            crashpoint(conf, "fetch_after_valid")
            set_last_result(conf, op="fetch", result="ok", version=m["version"], slot=new, etc_imported=imported)
            progress(conf, op="fetch", phase="arm", state="done", percent=100, version=m["version"])
            return 0, {"fetched": True, "version": m["version"], "slot": new, "etc_imported": imported}
        except Cancelled:
            st[new] = {"version": None, "valid": False}; write_state(conf, "slots.json", st)
            set_last_result(conf, op="fetch", result="cancelled")
            progress(conf, op="fetch", state="cancelled")
            return 2, {"error": "operation cancelled", "error_code": "cancelled"}
        except Fail as e:
            set_last_result(conf, op="fetch", result="failed", error_code=e.code, error=str(e))
            progress(conf, op="fetch", state="failed", error=str(e), error_code=e.code)
            raise
        finally:
            if iof: iof.restore()


def cmd_fetch(a, conf):
    need_backend(conf)
    if a.foreground:
        return do_fetch(a, conf)
    if op_running(conf):
        raise Fail("busy", "another update operation is running", rc=12)
    cmd = [sys.executable, os.path.abspath(__file__), "--json", "fetch", "--foreground"] + (["--force"] if a.force else [])
    # lowest CPU and idle I/O priority: the kiosk keeps playing while ~3 GB are written
    run_out("systemd-run", "--unit", "unitotem-update-fetch", "--collect", "--quiet", "-p", "Nice=19", "-p", "IOSchedulingClass=idle", *cmd)
    return 0, {"started": True, "unit": "unitotem-update-fetch"}


def slot_check(conf, new, st):
    # Do not trust the flag alone: an interruption can leave it set over data that is not what it says. A
    # read-only fsck and the label are cheap next to booting a half-written slot, and a failure here just
    # means "fetch again" - the operation is repeated, never assumed done.
    dev = run_out("blkid", "-t", f"PARTLABEL={label(new)}", "-o", "device", check=False).splitlines()
    dev = dev[0] if dev else ""
    if (not dev or run_out("blkid", "-s", "LABEL", "-o", "value", dev, check=False) != label(new)
            or subprocess.run(["e2fsck", "-fn", dev], capture_output=True).returncode != 0):
        st[new] = {"version": None, "valid": False}
        write_state(conf, "slots.json", st)
        raise Fail("slot-not-verified", f"slot {new} fails the check before activation: run fetch again")


def cmd_apply(a, conf):
    need_backend(conf)
    cur = cur_slot(conf); new = other_slot(cur)
    if op_running(conf):
        raise Fail("busy", "an operation is running", rc=12)
    st = slots_state(conf)
    if not (st[new].get("valid") and st[new].get("prepared")):
        raise Fail("nothing-fetched", f"slot {new} holds no verified release (run fetch)")
    slot_check(conf, new, st)
    crashpoint(conf, "apply_start")
    write_state(conf, "pending.json", {"slot": new, "from": cur, "from_version": current_version(conf), "version": st[new]["version"],
                                       "armed_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())})
    # A Raspberry trial only exists for a boot requested with the tryboot flag, so arming without the
    # reboot would leave a tryboot.txt that nothing consumes: refuse instead of pretending it is armed.
    if backend(conf) == "rpi" and not a.reboot and not getattr(a, "stage", False):
        raise Fail("needs-reboot", "on Raspberry the trial boot needs an immediate reboot: use apply --reboot")
    # One-shot: GRUB clears next_entry before booting it (Raspberry: the firmware reads tryboot.txt only on the
    # tryboot boot), so a crash/power cut during the trial lands back on the current slot with no software involved.
    imported = import_whitelist(conf, new, cur, state_path(conf, "preserve.list"))
    merge_identity_into(conf, new)        # again: an account created or a password changed since the download must not be left behind
    crashpoint(conf, "apply_after_pending")
    be_arm_trial(conf, new)
    crashpoint(conf, "apply_after_arm")
    set_last_result(conf, op="apply", result="armed", version=st[new]["version"], slot=new)
    if a.reboot:
        be_reboot(conf, trial=True)
        return 0, {"armed": True, "slot": new, "rebooting": True}
    return 0, {"armed": True, "slot": new, "rebooting": False}


def confirm_now(conf):
    cur = cur_slot(conf)
    pend = read_state(conf, "pending.json")
    if not pend or pend.get("slot") != cur:
        raise Fail("nothing-to-confirm", "no trial boot in progress on this slot")
    crashpoint(conf, "confirm_start")
    be_set_default(conf, cur)
    crashpoint(conf, "confirm_after_default")
    st = slots_state(conf)
    st[cur] = {"version": pend["version"], "valid": True, "prepared": True, "confirmed": True}
    if pend.get("from") in st:
        # It was running right before the switch, so it is a working system whatever bookkeeping said before.
        prev = st[pend["from"]]
        st[pend["from"]] = {"version": prev.get("version") or pend.get("from_version"), "valid": True,
                            "prepared": True, "confirmed": True}
    write_state(conf, "slots.json", st)
    try: os.unlink(state_path(conf, "pending.json"))
    except OSError: pass
    set_last_result(conf, op="confirm", result="ok", version=pend["version"], slot=cur)
    return {"confirmed": True, "slot": cur, "version": pend["version"]}


def cmd_confirm(a, conf):
    need_backend(conf)
    res = confirm_now(conf)
    try: sync_esp_grubcfg(conf)
    except Exception as e: event(conf, f"ESP grub.cfg sync failed: {e}")
    return 0, res


def health_ok(conf):
    url = conf["UPDATE_HEALTH_URL"]
    if not url:
        return True
    ctx = ssl.create_default_context(); ctx.check_hostname = False; ctx.verify_mode = ssl.CERT_NONE
    try:
        with urllib.request.urlopen(url, timeout=5, context=ctx) as r:
            return r.status == 200
    except (urllib.error.URLError, OSError, ValueError):
        return False


def cmd_boot_ok(a, conf):
    """Called by unitotem-boot-ok on every boot. On the first boot of a trial slot: wait for the
    health endpoint, then confirm; if it never answers, record that and reboot - next_entry was
    one-shot, so the reboot lands on the previous (still default) slot."""
    cur = cur_slot(conf)
    if cur is None:
        return 0, {"ab": False}
    pend = read_state(conf, "pending.json")
    if not pend:
        # Plain boot: remember that this slot holds a system that has actually come up, which is what
        # makes it a legitimate rollback target later (a freshly fetched slot is valid but never ran).
        st = slots_state(conf)
        ver = current_version(conf)
        if not (st[cur].get("confirmed") and st[cur].get("version") == ver):
            st[cur] = {"version": ver, "valid": True, "prepared": True, "confirmed": True}
            write_state(conf, "slots.json", st)
        # A manual rollback is "armed" when requested and only done once the previous slot has actually come up.
        lr = read_state(conf, "last-result.json") or {}
        if lr.get("op") == "rollback" and lr.get("result") == "armed" and lr.get("slot") == cur:
            set_last_result(conf, op="rollback", result="ok", slot=cur, version=ver)
        note_failover(conf)
        try: sync_esp_grubcfg(conf)
        except Exception as e: event(conf, f"ESP grub.cfg sync failed: {e}")
        # Self-healing: if the other slot held a system and no longer passes its check, rebuild it from this one (detached, idle priority).
        if conf.get("UPDATE_AUTOREPAIR", "1") == "1":
            try: cmd_repair(argparse.Namespace(foreground=False, auto=True, force=False), conf)
            except Exception as e: event(conf, f"repair not started: {e}")
        return 0, {"trial": False}
    if pend.get("slot") != cur and pend.get("staged") and not pend.get("trial_requested"):
        # armed by the automatic policy and never started (no tryboot reboot requested yet; on GRUB the one-shot is still in grubenv)
        if backend(conf) == "rpi" or grubenv_get(conf, "next_entry") == f"slot-{pend['slot']}":
            return 0, {"trial": False, "staged": True}
    if pend.get("slot") != cur:
        # We are on the old slot although a trial was armed: the trial slot did not come back.
        try: os.unlink(state_path(conf, "pending.json"))
        except OSError: pass
        st = slots_state(conf)
        st[pend["slot"]]["confirmed"] = False
        write_state(conf, "slots.json", st)
        set_last_result(conf, op="trial", result="rolled-back", reason="trial-did-not-confirm",
                        version=pend.get("version"))
        return 0, {"trial": False, "rolled_back": True}
    crashpoint(conf, "bootok_health_wait")
    # monotonic, not wall clock: a Raspberry has no RTC, so its clock jumps forward by years when NTP answers,
    # which would expire the health deadline early.
    deadline = time.monotonic() + int(conf["UPDATE_HEALTH_TIMEOUT"])
    while time.monotonic() < deadline:
        if health_ok(conf):
            res = confirm_now(conf)
            try: sync_esp_grubcfg(conf)          # a confirmed system is the only one allowed to touch the bootloader config
            except Exception as e: event(conf, f"ESP grub.cfg sync failed: {e}")
            return 0, res
        time.sleep(3)
    set_last_result(conf, op="trial", result="rolled-back", reason="health-timeout", version=pend.get("version"))
    try: os.unlink(state_path(conf, "pending.json"))
    except OSError: pass
    # Plain reboot on purpose, also on Raspberry: without the tryboot flag the firmware ignores tryboot.txt and
    # boots config.txt, i.e. the previous slot.
    be_reboot(conf, delay=0)
    return 2, {"error": "the system did not answer the health check: going back to the previous slot",
               "error_code": "health-timeout"}


def cmd_rollback(a, conf):
    need_backend(conf)
    cur = cur_slot(conf); old = other_slot(cur)
    if op_running(conf):
        raise Fail("busy", "an operation is running", rc=12)
    st = slots_state(conf)
    if not st[old].get("valid"):
        raise Fail("no-rollback", "the previous slot holds no valid system", rc=13)
    crashpoint(conf, "rollback_start")
    be_set_default(conf, old)
    crashpoint(conf, "rollback_after_default")
    try: os.unlink(state_path(conf, "pending.json"))
    except OSError: pass
    set_last_result(conf, op="rollback", result="armed", slot=old, version=st[old].get("version"))
    if a.reboot:
        be_reboot(conf)
    return 0, {"rollback": True, "slot": old, "rebooting": bool(a.reboot)}


