# self-repair: a damaged slot is rebuilt from the working one
# ---------------------------------------------------------------------------
def bootfs_dir(conf):
    return conf["UPDATE_BOOTFS"] if backend(conf) == "rpi" else conf["UPDATE_ESP_MOUNT"]


def slot_sound(conf, slot):
    """Is SLOT bootable as it stands? Same bar as slot_check plus, on a Raspberry, the boot files the firmware reads from the FAT.
    Read-only: never repairs, never writes."""
    dev = run_out("blkid", "-t", f"PARTLABEL={label(slot)}", "-o", "device", check=False).splitlines()
    dev = dev[0] if dev else ""
    if not dev or run_out("blkid", "-s", "LABEL", "-o", "value", dev, check=False) != label(slot):
        return False, "label"
    if subprocess.run(["e2fsck", "-fn", dev], capture_output=True).returncode != 0:
        return False, "fsck"
    # a clean filesystem is not a system: a freshly formatted slot (what a host recovery leaves in the slot it did not fill) passes fsck
    mnt = tempfile.mkdtemp(prefix="unitotem-slotcheck-")
    try:
        if subprocess.run(["mount", "-o", "ro", dev, mnt], capture_output=True).returncode != 0:
            return False, "mount"
        try:
            has = all(os.path.getsize(os.path.join(mnt, f)) > 0 for f in ("usr/share/unitotem/release-version", "usr/lib/systemd/systemd"))
        except OSError:
            has = False
        subprocess.run(["umount", mnt])
        if not has:
            return False, "empty"
    finally:
        try: os.rmdir(mnt)
        except OSError: pass
    if backend(conf) == "rpi":
        for need in ("kernel8.img", "initramfs8", "cmdline.txt"):
            f = os.path.join(conf["UPDATE_BOOTFS"], f"slot{slot}", need)
            if not os.path.isfile(f) or os.path.getsize(f) == 0:
                return False, f"bootfile:{need}"
    return True, "ok"


def rpi_clone_bootfiles(conf, cur, new):
    """Copy slot<cur>/ over slot<new>/ on the FAT (kernel, initramfs, dtbs, overlays) with the new slot's own root=/unitotem.slot=."""
    import re
    bf = conf["UPDATE_BOOTFS"]
    src = os.path.join(bf, f"slot{cur}")
    tmp = os.path.join(bf, f"slot{new}.new")
    shutil.rmtree(tmp, ignore_errors=True)
    shutil.copytree(src, tmp, symlinks=True)
    cmd = open(os.path.join(tmp, "cmdline.txt")).read().strip()
    cmd = re.sub(r"root=LABEL=\S+", f"root=LABEL={label(new)}", cmd)
    cmd = re.sub(r"unitotem\.slot=\S+", f"unitotem.slot={new}", cmd)
    with open(os.path.join(tmp, "cmdline.txt"), "w") as f:
        f.write(cmd + "\n"); f.flush(); os.fsync(f.fileno())
    final = os.path.join(bf, f"slot{new}")
    old = final + ".old"
    shutil.rmtree(old, ignore_errors=True)
    if os.path.exists(final):
        os.rename(final, old)
    os.rename(tmp, final)
    shutil.rmtree(old, ignore_errors=True)
    subprocess.run(["sync"])


def do_repair(a, conf):
    """Rebuild the OTHER slot as a copy of the one we are running whenever it is not a sound system (damaged, empty after a recovery,
    half-fetched): simple rule, the running slot is by definition good. Does nothing when the other slot is sound."""
    need_backend(conf)
    cur = cur_slot(conf); new = other_slot(cur)
    st = slots_state(conf)
    ok, why = slot_sound(conf, new)
    if ok and not a.force:
        return 0, {"repaired": False, "reason": "other slot is sound"}
    iof = None
    with Lock(conf):
        try:
            progress(conf, op="repair", phase="check", state="running", percent=0)
            okc, whyc = slot_sound(conf, new)         # again under the lock: another operation may have just rebuilt it
            if okc and not a.force:
                return 0, {"repaired": False, "reason": "other slot is sound"}
            ver = current_version(conf)
            cdev = run_out("blkid", "-t", f"PARTLABEL={label(cur)}", "-o", "device", check=False).splitlines()
            ndev = run_out("blkid", "-t", f"PARTLABEL={label(new)}", "-o", "device", check=False).splitlines()
            if not cdev or not ndev:
                raise Fail("no-slot-device", "slot partitions not found")
            cdev, ndev = cdev[0], ndev[0]
            if subprocess.run(["findmnt", "-S", ndev], capture_output=True).returncode == 0:
                raise Fail("slot-mounted", f"{ndev} is mounted: refusing to write to it")
            event(conf, f"repair: slot {new} ({whyc}) <- copy of slot {cur} ({ver})")
            iof = io_friendly(conf, ndev); iof.apply()
            st[new] = {"version": None, "valid": False}
            write_state(conf, "slots.json", st)
            progress(conf, op="repair", phase="write", state="running", percent=10)
            # partclone copies only the used blocks; label and UUID travel with them and are reset below like in fetch
            with tempfile.TemporaryFile() as serr_f, tempfile.TemporaryFile() as derr_f:
                src = subprocess.Popen(["partclone.extfs", "-c", "-F", "-s", cdev, "-o", "-"], stdout=subprocess.PIPE, stderr=serr_f)
                dst = subprocess.Popen(["partclone.restore", "-C", "-s", "-", "-o", ndev], stdin=src.stdout,
                                       stdout=subprocess.DEVNULL, stderr=derr_f)
                src.stdout.close()
                dst.wait(); src.wait()
                serr_f.seek(0); derr_f.seek(0)
                tail = (derr_f.read() + serr_f.read()).decode(errors="replace")[-300:]
            if src.returncode or dst.returncode:
                raise Fail("write-failed", f"partclone read rc={src.returncode} write rc={dst.returncode}: {tail}")
            progress(conf, op="repair", phase="verify", state="running", percent=80)
            # The copy carries the source's label AND UUID, and e2fsck/blkid then confuse it with the mounted original (e2fsck can fail with rc 8 on the
            # duplicate), so the new identity comes FIRST. -f: tune2fs otherwise refuses to change the UUID of a copy of a used filesystem
            # ("requires a freshly checked filesystem"); the real fsck follows right after. It is OUR new copy, so a fsck that fixes it
            # is exactly right (rc 0/1 = clean/fixed, anything else = failed copy).
            run_out("tune2fs", "-f", "-U", "random", "-L", label(new), ndev)
            rc = subprocess.run(["e2fsck", "-fy", ndev], capture_output=True).returncode
            if rc > 1:
                raise Fail("bad-copy", f"e2fsck on the copy returned {rc}")
            run_out("e2fsck", "-fn", ndev)
            mnt = tempfile.mkdtemp(prefix="unitotem-slot-")
            run_out("mount", "-o", "ro", ndev, mnt)
            try:
                got = open(os.path.join(mnt, "usr/share/unitotem/release-version")).read().strip()
                if got != ver:
                    raise Fail("version-mismatch", f"the copy reports {got}, the running system {ver}")
                if backend(conf) == "rpi":
                    with bootfs_rw(conf["UPDATE_BOOTFS"]):
                        rpi_clone_bootfiles(conf, cur, new)
                prepare_overlays(conf, new, cur, mnt)
            finally:
                subprocess.run(["umount", mnt]); os.rmdir(mnt)
            os.sync()
            st[new] = {"version": ver, "valid": True, "prepared": True, "confirmed": True}
            write_state(conf, "slots.json", st)
            set_last_result(conf, op="repair", result="ok", version=ver, slot=new, cause=whyc)
            progress(conf, op="repair", phase="done", state="done", percent=100, version=ver)
            return 0, {"repaired": True, "slot": new, "version": ver, "cause": whyc}
        except Fail as e:
            set_last_result(conf, op="repair", result="failed", error_code=e.code, error=str(e))
            progress(conf, op="repair", state="failed", error=str(e), error_code=e.code)
            raise
        finally:
            if iof: iof.restore()


def cmd_repair(a, conf):
    need_backend(conf)
    if a.foreground:
        return do_repair(a, conf)
    if op_running(conf):
        return 0, {"repaired": False, "reason": "another operation is running"}
    cmd = [sys.executable, os.path.abspath(__file__), "--json", "repair", "--foreground"] + (["--auto"] if a.auto else []) + (["--force"] if a.force else [])
    # idle class and lowest CPU priority: this runs next to the kiosk page and must never be noticed
    run_out("systemd-run", "--unit", "unitotem-update-repair", "--collect", "--quiet", "-p", "Nice=19", "-p", "IOSchedulingClass=idle",
            "-p", "RuntimeMaxSec=3600", *cmd)
    return 0, {"started": True, "unit": "unitotem-update-repair"}


def _grub_level(text):
    import re
    m = re.search(r"(?m)^# unitotem-grub-level:\s*(\d+)", text)
    return int(m.group(1)) if m else 0


def sync_esp_grubcfg(conf):
    """The ESP (GRUB's grub.cfg) is outside both slots, so an update never refreshes it: a device installed with an older bootloader
    config would keep it forever. The image ships its own copy; once a system has booted and been confirmed, copy it over when its
    `unitotem-grub-level` is higher. Written beside and renamed, verified before the rename, never run on a trial boot."""
    if backend(conf) != "grub":
        return None
    src = conf.get("UPDATE_ESP_GRUBCFG", "/usr/share/unitotem/esp-grub.cfg")
    dst = os.path.join(conf["UPDATE_ESP_MOUNT"], "unitotem-grub", "grub", "grub.cfg")
    try:
        new = open(src).read(); old = open(dst).read()
    except OSError:
        return None
    if _grub_level(new) <= _grub_level(old):
        return None
    # sanity: it must still describe both slots and the OTA fallback, or it is not a config we may put in charge of the boot
    for need in ("--id slot-a", "--id slot-b", "--id ota-recovery"):
        if need not in new:
            event(conf, f"grub.cfg sync refused: the image's copy lacks '{need}'")
            return None
    tmp = dst + ".new"
    with bootfs_rw(conf["UPDATE_ESP_MOUNT"]):
        with open(tmp, "w") as f:
            f.write(new); f.flush(); os.fsync(f.fileno())
        if open(tmp).read() != new:
            os.unlink(tmp)
            raise OSError("grub.cfg copy did not verify")
        os.replace(tmp, dst)
    event(conf, f"ESP grub.cfg updated: level {_grub_level(old)} -> {_grub_level(new)}")
    return {"from": _grub_level(old), "to": _grub_level(new)}


def note_failover(conf):
    """The initramfs switched slots because the chosen one was unusable (guard file on the boot partition). We are up on the other
    slot, so the guard has done its job: record what happened and remove it."""
    guard = os.path.join(bootfs_dir(conf), "unitotem-ota.failover")
    try:
        what = open(guard).read().strip()
    except OSError:
        return
    try:
        set_last_result(conf, op="failover", result="ok", detail=what, slot=cur_slot(conf))
        event(conf, f"failover {what}: the previous slot was unusable, running on the other one")
    except Exception:
        pass
    try:
        with bootfs_rw(bootfs_dir(conf)):
            os.unlink(guard)
    except OSError:
        pass


# ---------------------------------------------------------------------------
# automatic updates (policy on the device; the manager's settings page only sets it)
# ---------------------------------------------------------------------------
AUTO_MODES = ("off", "download", "stage", "reboot", "scheduled")
#   off        never touches anything by itself
#   download   fetch as soon as a newer release is found, nothing else
#   stage      fetch, then arm it: the new system starts at the NEXT reboot (not forced)
#   reboot     fetch, arm and reboot at once
#   scheduled  fetch, arm, and reboot only inside the daily window that starts at `time` (HH:MM, local time)
AUTO_DEFAULT = {"mode": "off", "time": "04:00"}
AUTO_CHECK_EVERY = 6 * 3600       # at most this often asks the server (the timer ticks every 10 minutes)
AUTO_SETTLE_S = 600               # after boot: let boot-ok, repair and the manager settle first
AUTO_WINDOW_S = 3600              # scheduled reboot: how long after `time` the reboot is still allowed (a missed tick, a busy device)


def auto_policy(conf):
    pol = dict(AUTO_DEFAULT); pol.update(read_state(conf, "auto.json", {}) or {})
    if pol["mode"] not in AUTO_MODES: pol["mode"] = "off"
    return pol


def _valid_time(t):
    import re
    m = re.fullmatch(r"([01]\d|2[0-3]):([0-5]\d)", t or "")
    return (int(m.group(1)), int(m.group(2))) if m else None


def cmd_policy(a, conf):
    pol = auto_policy(conf)
    if a.set_mode is not None or a.time is not None:
        mode = a.set_mode if a.set_mode is not None else pol["mode"]
        t = a.time if a.time is not None else pol["time"]
        if mode not in AUTO_MODES:
            raise Fail("bad-mode", f"allowed modes: {', '.join(AUTO_MODES)}", rc=2)
        if _valid_time(t) is None:
            raise Fail("bad-time", "time must be written as HH:MM (00:00-23:59)", rc=2)
        pol = {"mode": mode, "time": t}
        write_state(conf, "auto.json", pol)
    return 0, {"policy": pol, "auto": read_state(conf, "auto-state.json", {}) or {}}


def _uptime_s():
    try: return float(open("/proc/uptime").read().split()[0])
    except OSError: return 1e9


def _staged(conf, st=None):
    """The armed update waiting for a reboot (pending.json for the OTHER slot), or None."""
    cur = cur_slot(conf)
    pend = read_state(conf, "pending.json")
    return pend if (cur and pend and pend.get("slot") != cur) else None


def auto_arm(conf):
    """Arm the downloaded update without rebooting. Same steps as `apply`, plus `staged` so a boot of the OLD slot before the trial boot is
    not mistaken for a failed trial."""
    cur = cur_slot(conf); new = other_slot(cur)
    st = slots_state(conf)
    if not (st[new].get("valid") and st[new].get("prepared")):
        raise Fail("nothing-fetched", f"slot {new} holds no verified release")
    slot_check(conf, new, st)
    write_state(conf, "pending.json", {"slot": new, "from": cur, "from_version": current_version(conf), "version": st[new]["version"],
                                       "armed_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "staged": True})
    import_whitelist(conf, new, cur, state_path(conf, "preserve.list"))
    merge_identity_into(conf, new)
    be_arm_trial(conf, new)
    set_last_result(conf, op="apply", result="armed", version=st[new]["version"], slot=new, staged=True)
    event(conf, f"auto: armed {st[new]['version']} on slot {new} (staged)")


def auto_refresh(conf):
    """A staged update may wait for days: account changes made meanwhile must still reach the new slot, so redo the two merges."""
    pend = _staged(conf)
    if not pend: return
    cur = cur_slot(conf); new = pend["slot"]
    import_whitelist(conf, new, cur, state_path(conf, "preserve.list"))
    merge_identity_into(conf, new)


def do_reboot_now(conf):
    """Reboot into the staged update when there is one (the Raspberry needs the tryboot flag on the reboot request itself)."""
    pend = _staged(conf)
    if pend:
        pend["trial_requested"] = True
        write_state(conf, "pending.json", pend)
        be_reboot(conf, trial=True, delay=3)
    else:
        be_reboot(conf, trial=False, delay=3)
    return bool(pend)


def cmd_reboot(a, conf):
    need_backend(conf)
    return 0, {"rebooting": True, "into_update": do_reboot_now(conf)}


def _in_window(now, hhmm):
    h, m = _valid_time(hhmm)
    start = now.replace(hour=h, minute=m, second=0, microsecond=0)
    if now < start:                                   # the window that began yesterday may still be open after midnight
        start = start - datetime.timedelta(days=1)
    return 0 <= (now - start).total_seconds() < AUTO_WINDOW_S, start.date().isoformat()


def cmd_auto(a, conf):
    """One tick of the automatic update policy (run by unitotem-update-auto.timer, idempotent, never blocks for long)."""
    need_backend(conf)
    pol = auto_policy(conf)
    ast = read_state(conf, "auto-state.json", {}) or {}
    def done(**kw):
        ast.update(kw); ast["tick_at"] = int(time.time()); write_state(conf, "auto-state.json", ast)
        return 0, {"policy": pol, "state": kw}
    mode = pol["mode"]
    if mode == "off":
        return 0, {"policy": pol, "state": {"action": "off"}}
    if op_running(conf):
        return 0, {"policy": pol, "state": {"action": "busy"}}
    cur = cur_slot(conf)
    if cur is None:
        return 0, {"policy": pol, "state": {"action": "not-ab"}}
    pend = read_state(conf, "pending.json")
    if pend and pend.get("slot") == cur:
        return 0, {"policy": pol, "state": {"action": "trial-running"}}      # boot-ok decides, not us
    if _uptime_s() < AUTO_SETTLE_S and not a.now:
        return 0, {"policy": pol, "state": {"action": "settling"}}

    staged = _staged(conf)
    if staged:
        auto_refresh(conf)
        if mode == "reboot":
            event(conf, "auto: rebooting into the staged update")
            do_reboot_now(conf)
            return done(action="rebooting", version=staged.get("version"))
        if mode == "scheduled":
            import datetime as _dt
            ok, day = _in_window(_dt.datetime.now(), pol["time"])
            if ok and ast.get("last_scheduled_day") != day:
                ast["last_scheduled_day"] = day
                event(conf, f"auto: scheduled reboot into the staged update ({day} {pol['time']})")
                do_reboot_now(conf)
                return done(action="rebooting", version=staged.get("version"), last_scheduled_day=day)
            return done(action="waiting-for-schedule", version=staged.get("version"), at=pol["time"])
        return done(action="staged", version=staged.get("version"))         # download/stage: it waits for whoever reboots

    # nothing armed: is there something downloaded, or something to download?
    st = slots_state(conf); new = other_slot(cur)
    downloaded = bool(st[new].get("valid") and st[new].get("prepared") and st[new].get("version")
                      and vkey(st[new]["version"]) > vkey(current_version(conf)))
    if not downloaded:
        now = time.time()
        if now < ast.get("retry_after", 0) and not a.now:
            return done(action="backoff")
        if now - ast.get("checked_at", 0) < AUTO_CHECK_EVERY and not a.now and ast.get("available") is False:
            return done(action="idle")
        try:
            rc, chk = cmd_check(argparse.Namespace(), conf)
        except Fail as e:
            ast["fail"] = ast.get("fail", 0) + 1
            return done(action="check-failed", error=str(e), retry_after=now + min(86400, 3600 * 2 ** min(ast["fail"], 5)))
        ast["checked_at"] = int(now); ast["available"] = bool(chk["available"]); ast["version"] = chk["version"]
        if not chk["available"]:
            ast["fail"] = 0
            return done(action="up-to-date")
        if chk.get("needs_layout_migration"):
            return done(action="needs-manual", reason="layout migration")        # never automatic
        try:
            do_fetch(argparse.Namespace(force=False), conf)
        except Fail as e:
            ast["fail"] = ast.get("fail", 0) + 1
            return done(action="fetch-failed", error=str(e), retry_after=now + min(86400, 3600 * 2 ** min(ast["fail"], 5)))
        ast["fail"] = 0
        st = slots_state(conf)
    if mode == "download":
        return done(action="downloaded", version=st[new].get("version"))
    auto_arm(conf)                                                           # stage / reboot / scheduled
    if mode == "reboot":
        do_reboot_now(conf)
        return done(action="rebooting", version=st[new].get("version"))
    return done(action="staged", version=st[new].get("version"))


def cmd_cancel(a, conf):
    pid = op_running(conf)
    if not pid:
        return 10, {"cancelled": False, "reason": "no operation running"}
    os.kill(pid, signal.SIGTERM)
    return 0, {"cancelled": True, "pid": pid}


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--json", action="store_true")
    sp = ap.add_subparsers(dest="cmd", required=True)
    for n in ("status", "check", "confirm", "boot-ok", "cancel"):
        sp.add_parser(n)
    f = sp.add_parser("fetch"); f.add_argument("--foreground", action="store_true"); f.add_argument("--force", action="store_true")
    f.add_argument("--accept-changes", help="accepted and ignored: the current slot is never modified")
    po = sp.add_parser("policy"); po.add_argument("--set-mode", dest="set_mode", choices=AUTO_MODES); po.add_argument("--time")
    au = sp.add_parser("auto"); au.add_argument("--now", action="store_true", help="skip the settle delay and the check rate limit")
    sp.add_parser("reboot")
    r = sp.add_parser("repair"); r.add_argument("--foreground", action="store_true"); r.add_argument("--auto", action="store_true")
    r.add_argument("--force", action="store_true", help="copy even when the other slot passes the check")
    for n in ("apply", "rollback"):
        x = sp.add_parser(n); x.add_argument("--reboot", action="store_true"); x.add_argument("--stage", action="store_true", help="apply: arm without rebooting (Raspberry too)")
    a = ap.parse_args()
    conf = load_conf()
    table = {"status": cmd_status, "check": cmd_check, "fetch": cmd_fetch, "apply": cmd_apply, "confirm": cmd_confirm,
             "boot-ok": cmd_boot_ok, "rollback": cmd_rollback, "cancel": cmd_cancel, "repair": cmd_repair, "policy": cmd_policy, "auto": cmd_auto, "reboot": cmd_reboot}
    try:
        rc, out = table[a.cmd](a, conf)
    except Fail as e:
        rc, out = e.rc, {"error": str(e), "error_code": e.code}
    except Cancelled:
        rc, out = 2, {"error": "operation cancelled", "error_code": "cancelled"}
    if a.json:
        print(json.dumps(out))
    else:
        for k, v in out.items(): print(f"{k}: {v}")
    return rc


if __name__ == "__main__":
    sys.exit(main())
