# iocharset=iso8859-1 explicit: avoids depending on the on-demand nls_ascii module load
# (see unitotem/files/fstab-arm64).
# ro + nofail: see unitotem/files/fstab-arm64 (same reasoning for the ESP).
LABEL=EFI   /boot/efi  vfat  defaults,noatime,ro,nofail,x-systemd.device-timeout=15s,iocharset=iso8859-1        0 2
LABEL=BOOT  /boot      ext4  defaults,noatime                           0 2
LABEL=ROOT  /          ext4  defaults,noatime,ro                        0 1
tmpfs       /tmp       tmpfs defaults,noatime,nosuid,nodev,size=256M    0 0
tmpfs       /run       tmpfs defaults,noatime,nosuid,nodev,mode=0755    0 0
# Pure churn, nothing worth keeping across a reboot: these stay tmpfs although /var is overlaid, so apt archives and
# scratch files never reach the SD card.
tmpfs       /var/cache tmpfs defaults,noatime,nosuid,nodev,size=512M    0 0
tmpfs       /var/tmp   tmpfs defaults,noatime,nosuid,nodev,size=64M     0 0
# No per-directory tmpfs allowlist for /var: a blanket tmpfs over /var/lib would hide dpkg's build-time database and
# /var/unitotem-venv, which must stay readable. The DATA overlay (unitotem/files/overlayfs-hook.sh) keeps the lower
# layer visible and diverts only writes, and covers everything else, notably /var/log/journal.
