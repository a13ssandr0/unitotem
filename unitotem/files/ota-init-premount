#!/bin/sh
# initramfs-tools init-premount script: entry point for the whole OTA
# mechanism. Runs before mountroot, so it can freely inspect ROOT/DATA
# without anything being mounted yet, and - if it decides to enter OTA mode
# - never lets mountroot/local-bottom/switch_root happen at all (see
# deploy/ota-engine.sh's serve-fallback, which blocks in the foreground on
# dropbear rather than returning).
# plymouth first: this script can take seconds (udev settle, fsck of the root slot) and the boot splash must already be on
# screen while it runs - without this the initramfs ran it BEFORE plymouthd was started (measured: splash only at ~10 s).
PREREQ="plymouth"
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac

# kernel-log breadcrumbs (dmesg timestamps) so the cost of this step shows up in boot-time measurements
echo "unitotem-initramfs: ota init-premount start" > /dev/kmsg 2>/dev/null || true
/usr/sbin/unitotem-ota-engine init-premount
rc=$?
echo "unitotem-initramfs: ota init-premount end rc=$rc" > /dev/kmsg 2>/dev/null || true
exit $rc
