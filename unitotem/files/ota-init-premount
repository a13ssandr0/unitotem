#!/bin/sh
# initramfs-tools init-premount script: entry point of the OTA mechanism. It runs before mountroot,
# so ROOT/DATA can be inspected unmounted, and when it enters OTA mode mountroot/local-bottom/
# switch_root never happen (deploy/ota-engine.sh's serve-fallback blocks in the foreground on dropbear).
# plymouth first: this step can take seconds (udev settle, fsck of the root slot) and the splash must
# already be on screen while it runs.
PREREQ="plymouth"
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac

# kernel-log breadcrumbs (dmesg timestamps) so the cost of this step shows up in boot-time measurements
echo "unitotem-initramfs: ota init-premount start" > /dev/kmsg 2>/dev/null || true
/usr/sbin/unitotem-ota-engine init-premount
rc=$?
echo "unitotem-initramfs: ota init-premount end rc=$rc" > /dev/kmsg 2>/dev/null || true
exit $rc
