# iocharset=iso8859-1 explicit: without it, vfat falls back to the kernel's
# default ("ascii") iocharset, which needs the separate nls_ascii module loaded on demand; when that
# load fails boot-firmware.mount fails ("FAT-fs: IO charset ascii not found") and boot drops to the
# emergency shell. The initramfs module set is handled separately (manual_add_modules in
# unitotem/files/ota-hook).
# ro + nofail: the FAT holds the firmware and bootloader and is the one partition without a journal, so it is not
# mounted writable at runtime (the tools that must write it - unitotem-update, unitotem-boot-ok, unitotem-ota-arm -
# remount it rw for the moment they need), and a damaged one must not stop the boot: the kiosk does not need it to run.
LABEL=FIRMWARE /boot/firmware vfat  defaults,noatime,ro,nofail,x-systemd.device-timeout=15s,iocharset=iso8859-1 0 2
LABEL=ROOT     /              ext4  defaults,noatime,ro                 0 1
tmpfs          /tmp           tmpfs defaults,noatime,nosuid,nodev,size=256M  0 0
tmpfs          /run           tmpfs defaults,noatime,nosuid,nodev,mode=0755  0 0
# /var/cache and /var/tmp stay tmpfs although /var is overlaid: they are pure churn (apt archives, scratch files)
# and routing them to the SD card would only add wear. Everything else under /var is writable via the DATA overlay
# (unitotem/files/overlayfs-hook.sh).
tmpfs          /var/cache     tmpfs defaults,noatime,nosuid,nodev,size=512M  0 0
tmpfs          /var/tmp       tmpfs defaults,noatime,nosuid,nodev,size=64M   0 0
# No per-directory tmpfs allowlist for /var (NetworkManager, dhcp, systemd, haproxy): with the overlay in place it
# would hide the persistence those directories need.
