# Last-resort NetworkManager profile: a wired interface ALWAYS has an active connection and so an IPv6 link-local
# address ("ssh root@fe80::...%iface" rescue channel), because NM sets disable_ipv6=1 on interfaces with no connection.
# ipv4 method=auto (not disabled): NM auto-generates "Wired connection" only for devices matching NO profile, so this
# profile must provide DHCP itself. may-fail=true on ipv4 with ipv6 link-local keeps the connection active without DHCP.
# interface-name is unset (matches end0, eth0, enp*); autoconnect-priority is strongly negative so any real profile
# (user-configured or written by apply-network) wins.
[connection]
id=unitotem-fallback
type=ethernet
autoconnect=true
autoconnect-priority=-999

[ethernet]

[ipv4]
method=auto
may-fail=true

[ipv6]
method=link-local
may-fail=true

[proxy]
