[Unit]
Description=UniTotem - periodic network reachability check

[Timer]
# The first check is delayed: right after boot NetworkManager needs time to complete DHCP, and
# checking at once would count a normal situation as a failure.
OnBootSec=5min
OnUnitActiveSec=1min
AccuracySec=10s
Unit=unitotem-net-watchdog.service

[Install]
WantedBy=timers.target
