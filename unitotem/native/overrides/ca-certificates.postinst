#! /bin/sh
# Native build replacement (docs/system/build.md, Native arm64 build). The original writes /etc/ca-certificates.conf from
# the answers of its config script (not run by the native build) and runs update-ca-certificates on the builder. Here the
# new-file state is written under DPKG_ROOT with every certificate of /usr/share/ca-certificates enabled (the trust_new
# default). /etc/ssl/certs is made by nb-finalize (update-ca-certificates --fresh --sysroot).

set -e

R="${DPKG_ROOT:?DPKG_ROOT is not set}"

case "$1" in
    configure)
        LOCAL="${R}/usr/local/share/ca-certificates"
        if [ ! -e "$LOCAL" ]; then
            if mkdir -m "$(stat -L -c %a "${R}/usr/local")" "$LOCAL" 2>/dev/null; then
                chgrp "$(stat -L -c %g "${R}/usr/local")" "$LOCAL"
            fi
        fi
        CONF="${R}/etc/ca-certificates.conf"
        if [ ! -e "$CONF" ]; then
            {
                cat << 'EOF_CONF'
# This file lists certificates that you wish to use or to ignore to be
# installed in /etc/ssl/certs.
# update-ca-certificates(8) will update /etc/ssl/certs by reading this file.
#
# This is autogenerated by dpkg-reconfigure ca-certificates.
# Certificates should be installed under /usr/share/ca-certificates
# and files with extension '.crt' is recognized as available certs.
#
# line begins with # is comment.
# line begins with ! is certificate filename to be deselected.
#
EOF_CONF
                (cd "${R}/usr/share/ca-certificates" && find . -type f -name '*.crt' | sed -e 's#^\./##' | LC_ALL=C sort)
            } > "$CONF"
            chmod 0644 "$CONF"
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure|triggered)
        ;;
    *)
        echo "$0: didn't understand being called with \`$1'" >&2
        exit 0
        ;;
esac

exit 0
