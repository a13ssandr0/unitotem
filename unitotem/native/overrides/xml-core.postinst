#!/bin/sh
# Native build replacement (docs/system/build.md, Native arm64 build). Inspired by xml-core (GPL): the same update-xmlcatalog
# calls and the same directories, with every absolute path under DPKG_ROOT. update-xmlcatalog is the package's perl script,
# run on the host with its catalog paths rebased (nb_update_xmlcatalog); the catalog URIs written inside the files are unchanged.
set -e

R="${DPKG_ROOT}"

# nb_count PATTERN COUNT FILE: the rebase below must find exactly its lines, else stop.
nb_count() {
    [ "$(grep -c -F -- "$1" "$3")" = "$2" ] || { echo "xml-core: $1 not found $2 time(s) in $3" >&2; exit 1; }
}

# nb_update_xmlcatalog ARGS: update-xmlcatalog from the target tree, catalog files under DPKG_ROOT.
nb_update_xmlcatalog() {
    f="$R/usr/sbin/update-xmlcatalog"
    nb_count "= '/var/lib/xml-core';" 1 "$f"
    nb_count "= '/etc/xml';" 1 "$f"
    nb_count "= '/usr/share/xml-core/catalog.header';" 1 "$f"
    nb_count "= '/usr/share/xml-core/catalog.footer';" 1 "$f"
    nb_count '$catalog = $local;' 1 "$f"
    nb_count '-f $local' 2 "$f"
    sed -e "s|= '/var/lib/xml-core';|= \$ENV{NB_TARGET} . '/var/lib/xml-core';|" \
        -e "s|= '/etc/xml';|= \$ENV{NB_TARGET} . '/etc/xml';|" \
        -e "s|= '/usr/share/xml-core/catalog.header';|= \$ENV{NB_TARGET} . '/usr/share/xml-core/catalog.header';|" \
        -e "s|= '/usr/share/xml-core/catalog.footer';|= \$ENV{NB_TARGET} . '/usr/share/xml-core/catalog.footer';|" \
        -e 's|\$catalog = \$local;|$catalog = $ENV{NB_TARGET} . $local;|' \
        -e 's|-f \$local|-f $ENV{NB_TARGET} . $local|g' \
        "$f" | NB_TARGET="$R" perl - "$@"
}

if [ "$1" = "configure" ]; then
	nb_update_xmlcatalog --sort --add --type system --id "http://www.oasis-open.org/committees/entity/release/1.0/catalog.dtd" --package xml-core --local /usr/share/xml/schema/xml-core/catalog.xml
	nb_update_xmlcatalog --sort --add --type public --id "-//OASIS//DTD XML Catalogs V1.0//EN" --package xml-core --local /usr/share/xml/schema/xml-core/catalog.xml
	nb_update_xmlcatalog --sort --add --type system --id "http://globaltranscorp.org/oasis/catalog/xml/tr9401.dtd" --package xml-core --local /usr/share/xml/schema/xml-core/catalog.xml
	nb_update_xmlcatalog --sort --add --type public --id "-//GlobalTransCorp//DTD XML Catalogs V1.0-Based Extension V1.0//EN" --package xml-core --local /usr/share/xml/schema/xml-core/catalog.xml

	nb_update_xmlcatalog --sort --add --type system --id "http://www.oasis-open.org/committees/entity/release/1.0/catalog.dtd" --package xml-core --root
	nb_update_xmlcatalog --sort --add --type public --id "-//OASIS//DTD XML Catalogs V1.0//EN" --package xml-core --root
	nb_update_xmlcatalog --sort --add --type system --id "http://globaltranscorp.org/oasis/catalog/xml/tr9401.dtd" --package xml-core --root
	nb_update_xmlcatalog --sort --add --type public --id "-//GlobalTransCorp//DTD XML Catalogs V1.0-Based Extension V1.0//EN" --package xml-core --root

fi

## ----------------------------------------------------------------------
## dh_usrlocal: the directories the package creates under /usr/local (root:root 0755, or staff 02775 when the image has
## /etc/staff-group-for-usr-local)
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ]; then
    mode=0755
    gid=0
    if [ -e "$R/etc/staff-group-for-usr-local" ]; then
        mode=02775
        gid=$(awk -F: '$1 == "staff" { print $3; exit }' "$R/etc/group")
    fi
    for d in /usr/local/share /usr/local/share/xml /usr/local/share/xml/declaration /usr/local/share/xml/entities \
             /usr/local/share/xml/misc /usr/local/share/xml/schema
    do
        if [ ! -e "$R$d" ]; then
            if mkdir "$R$d" 2>/dev/null; then
                if chown "0:$gid" "$R$d"; then
                    chmod "$mode" "$R$d" || true
                fi
            fi
        fi
    done
fi

exit 0
