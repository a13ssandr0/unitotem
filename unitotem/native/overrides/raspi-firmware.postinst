#!/bin/sh
# Native build: the package's postinst copies the firmware blobs with absolute paths and runs the kernel hook, which needs the
# target's tools. Same copy here, relative to DPKG_ROOT; the kernel hook part is nb_kernel_post (common.sh).
set -e
if [ "$1" = configure ]; then
    mkdir -p "${DPKG_ROOT}/boot/firmware"
    cp -r "${DPKG_ROOT}"/usr/lib/raspi-firmware/* "${DPKG_ROOT}/boot/firmware/"
fi
exit 0
