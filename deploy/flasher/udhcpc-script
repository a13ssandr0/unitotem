#!/bin/sh
# Minimal udhcpc lease script for the flasher initrd. The packaged
# /etc/udhcpc/default.script shells out to "busybox ifconfig/ip/awk" and
# resolvconf, none of which this initrd carries (see hook) - this replaces
# it with the one thing actually needed: bring the interface up with the
# offered lease. No DNS/resolvconf - the flasher only ever talks to a
# numeric host/IP, never resolves a name.
case "$1" in
    bound|renew)
        prefix=$(awk -v m="$subnet" 'BEGIN{
            n=split(m,o,".");b=0
            for(i=1;i<=4;i++){v=o[i]+0;while(v){b+=v%2;v=int(v/2)}}
            print b
        }')
        ip addr flush dev "$interface" 2>/dev/null
        ip addr add "${ip}/${prefix:-24}" dev "$interface"
        ip link set "$interface" up
        router1="${router%% *}"
        if [ -n "$router1" ]; then
            ip route replace default via "$router1" dev "$interface"
        fi
        ;;
    deconfig)
        ip addr flush dev "$interface" 2>/dev/null
        ip link set "$interface" up
        ;;
esac
exit 0
