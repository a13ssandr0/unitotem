#!/bin/bash
# initramfs-tools init-premount script: the entire remote-deploy flash logic.
#
# Runs BEFORE any root filesystem is mounted (init-premount fires ahead of
# the "local" boot script that would otherwise mount root by root=), so the
# disk being overwritten is never open/busy - `dd` on the whole device is
# always safe here, on any kernel. Bash (not the usual /bin/sh) is used
# deliberately: `set -o pipefail` is required to catch failures in the
# receive/decompress/dd pipelines, and this initrd already ships a
# near-complete Debian toolset (see deploy/flasher/hook), so there is no
# minimality reason to fight dash here.
#
# Driven entirely by kernel cmdline parameters set by deploy/remote-deploy.sh
# when it arms the one-shot boot entry - see that script's ARM_* functions
# for the exact contract. Every failure path ends in either a rollback (see
# fail()) or, if it already committed to overwriting the disk, a clear error
# and a reboot; it never silently drops the machine into an unreachable
# state without at least trying to bring the old system back.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac

set -Eeuo pipefail   # -E: propagate the ERR trap into functions (almost all logic below lives in one)
. /scripts/functions 2>/dev/null || true

log()  { echo "unitotem-flash: $*"; echo "unitotem-flash: $*" > /dev/kmsg 2>/dev/null || true; }
warn() { log "ATTENZIONE: $*"; }

CMDLINE="$(cat /proc/cmdline)"

cmdline_get() {
    local tok
    for tok in $CMDLINE; do
        case "$tok" in
            "$1="*) printf '%s\n' "${tok#*=}"; return 0 ;;
        esac
    done
    return 1
}

pdev_target() {
    case "$1" in
        *nvme*|*mmcblk*) echo "${1}p${2}" ;;
        *)                echo "${1}${2}" ;;
    esac
}

# /dev/sda3 -> 3 ; /dev/nvme0n1p3 -> 3 (longest prefix ending in a non-digit
# stripped, POSIX parameter expansion, no external tools needed)
partnum_of() { printf '%s\n' "${1##*[!0-9]}"; }

# e2fsck's exit code is a bitmask, not a plain success/failure boolean: 0 =
# clean, 1 = errors found and corrected, 2 = ditto + reboot suggested (moot,
# this fs isn't mounted as anyone's root right now). Only >=4 means errors
# were left uncorrected - that's the actual failure case.
run_e2fsck() {
    local rc=0
    e2fsck -fy "$1" || rc=$?
    [ "$rc" -lt 4 ] || fail "e2fsck ha rilevato errori non corretti su $1 (rc=$rc)"
}

# ---------------------------------------------------------------------------
# Failure handling: rolls back what can be rolled back, then reboots. Called
# on every explicit error path; also wired as a global ERR trap below.
# ---------------------------------------------------------------------------
FIRMWARE=""; BOOTDISK_ID=""; BOOTPART=""; DEBUG=0

rollback_rpi() {
    local bd mnt=/mnt/bootfix
    [ -n "$BOOTDISK_ID" ] && [ -n "$BOOTPART" ] || { warn "rollback: bootdisk/bootpart mancanti, impossibile ripristinare"; return 1; }
    bd=$(resolve_disk "$BOOTDISK_ID") || return 1
    mkdir -p "$mnt"
    mount -t vfat "$(pdev_target "$bd" "$BOOTPART")" "$mnt" 2>/dev/null || { warn "rollback: mount partizione di boot fallito"; return 1; }
    # "test && action" as a bare statement aborts the whole script under set
    # -e when the test is merely false (a normal outcome here, e.g. a second
    # rollback attempt after the backup was already consumed) - `if` is the
    # form that stays exempt regardless. Same reasoning applies everywhere
    # else below that used to read "[ cond ] && action" without a trailing
    # "|| ...".
    if [ -f "$mnt/config.txt.unitotem-bak" ];  then mv -f "$mnt/config.txt.unitotem-bak"  "$mnt/config.txt";  fi
    if [ -f "$mnt/cmdline.txt.unitotem-bak" ]; then mv -f "$mnt/cmdline.txt.unitotem-bak" "$mnt/cmdline.txt"; fi
    rm -f "$mnt/unitotem-flash-vmlinuz" "$mnt/unitotem-flash-initrd.img"
    sync
    umount "$mnt" 2>/dev/null || true
    log "rollback rpi: config.txt/cmdline.txt originali ripristinati"
}

fail() {
    log "ERRORE: $*"
    if [ "$DEBUG" = 1 ]; then
        log "unitotem.debug=1: shell di emergenza (il sistema NON verrà riavviato automaticamente)"
        setsid sh -c 'exec sh </dev/console >/dev/console 2>&1' || true
        exit 1
    fi
    # however rollback_rpi goes (it's already internally tolerant), fail()
    # must always reach the reboot below - never let this abort the function.
    if [ "$FIRMWARE" = rpi ]; then rollback_rpi || true; fi
    # GRUB (uefi/bios): grub-reboot's saved one-shot entry already reverts to
    # the previous default on the very next boot - nothing to undo here.
    log "Riavvio in 10s per tornare al sistema precedente..."
    sleep 10
    reboot -f
    sleep 30
    exit 1
}
trap 'fail "errore inatteso alla riga $LINENO"' ERR

resolve_disk() {
    local path="$1" tries=0 resolved
    while [ ! -e "$path" ] && [ "$tries" -lt 30 ]; do
        udevadm settle --timeout=2 2>/dev/null || true
        sleep 1
        tries=$((tries + 1))
    done
    [ -e "$path" ] || fail "dispositivo non trovato: $path"
    resolved=$(readlink -f "$path")

    # The by-id/by-path/by-partuuid symlink can win the race against the
    # partition device node it points to - seen in testing: the symlink
    # resolved to e.g. /dev/vda2 while that node didn't exist yet, and a
    # plain "-e" check on the symlink doesn't catch this since it's
    # checking the *link*, already alive, not this specific target. Wait
    # for the resolved block device itself too.
    tries=0
    while [ ! -b "$resolved" ] && [ "$tries" -lt 15 ]; do
        udevadm settle --timeout=2 2>/dev/null || true
        sleep 1
        tries=$((tries + 1))
    done
    [ -b "$resolved" ] || fail "dispositivo non pronto dopo la risoluzione: $resolved (da $path)"
    echo "$resolved"
}

# ---------------------------------------------------------------------------
# Manifest: KEY=VALUE lines, blank line terminated. Whitelists both key names
# and value charset before eval'ing the assignment - matters for net mode,
# where this header arrives over the network unauthenticated.
# ---------------------------------------------------------------------------
read_manifest_lines() {
    local line key val
    while IFS= read -r line; do
        if [ -z "$line" ]; then break; fi
        key=${line%%=*}
        val=${line#*=}
        case "$key" in
            UNITOTEM_ARCH|UNITOTEM_COMP|UNITOTEM_RAW_SIZE|UNITOTEM_COMP_SIZE|\
            UNITOTEM_COMP_SHA256|UNITOTEM_IMAGE_NAME|UNITOTEM_DATA_PART|UNITOTEM_HAS_ESP)
                case "$val" in *[!A-Za-z0-9_.-]*) continue ;; esac
                eval "$key=\"\$val\""
                ;;
        esac
    done
}

decompress_pipe() {
    case "$UNITOTEM_COMP" in
        xz)   unxz -dc ;;
        zstd) unzstd -dc ;;
        *)    fail "compressione sconosciuta nel manifest: $UNITOTEM_COMP" ;;
    esac
}

# ---------------------------------------------------------------------------
# Mode: ram - copy the (still xz/zstd-compressed) image into a tmpfs, then
# decompress straight into dd. Used whenever MemAvailable comfortably covers
# the compressed size.
# ---------------------------------------------------------------------------
do_ram() {
    local srcpart srcdir mnt=/mnt/src work=/mnt/work img

    srcpart=$(resolve_disk "$(cmdline_get unitotem.srcpart)")
    srcdir=$(cmdline_get unitotem.srcdir); srcdir=${srcdir:-/root}

    mkdir -p "$mnt" "$work"
    mount -t ext4 -o ro "$srcpart" "$mnt" || fail "mount sorgente ($srcpart) fallito"

    [ -f "$mnt$srcdir/unitotem-deploy.manifest" ] || fail "manifest non trovato in $srcpart:$srcdir"
    read_manifest_lines < "$mnt$srcdir/unitotem-deploy.manifest"
    [ -n "${UNITOTEM_RAW_SIZE:-}" ] || fail "manifest incompleto"

    img="$mnt$srcdir/$(basename "$UNITOTEM_IMAGE_NAME")"
    [ -f "$img" ] || fail "immagine non trovata: $img"

    mount -t tmpfs -o "size=$((UNITOTEM_COMP_SIZE + 64 * 1024 * 1024))" tmpfs "$work" \
        || fail "mount tmpfs fallito (RAM insufficiente?)"
    log "Copio l'immagine in RAM ($(($UNITOTEM_COMP_SIZE / 1024 / 1024)) MiB)..."
    cp "$img" "$work/image.raw" || fail "copia in RAM fallita"
    umount "$mnt"

    STREAM_CMD="cat $work/image.raw"
}

# ---------------------------------------------------------------------------
# Mode: part - shrink the (unmounted) source root filesystem, shrink its
# partition table entry to match, carve a staging partition out of the freed
# tail space, copy the image there, unmount everything, then stream from the
# staging partition exactly as in ram mode. Requires the source root to be
# the last partition on the disk (true for the legacy pi-gen layout this
# targets: boot, then rootfs) so the freed space is contiguous and at the
# tail - anything else bails out towards --mode net rather than guess.
# ---------------------------------------------------------------------------
do_part_stage() {
    local srcpart oldroot_num last_num table
    local minblocks blocksize minbytes newsize_bytes newsize_sec
    local root_start_sec root_end_sec disk_total_sec avail_sec need_sec
    local write_boundary_sec stage_start_sec
    local stage_num stage_part srcdir

    srcpart=$(resolve_disk "$(cmdline_get unitotem.srcpart)")
    oldroot_num=$(partnum_of "$srcpart")
    [ -n "$oldroot_num" ] || fail "impossibile determinare il numero di partizione di $srcpart"

    last_num=$(parted -sm "$DISK" print 2>/dev/null | awk -F: '$1 ~ /^[0-9]+$/ {n=$1} END{print n+0}')
    [ "$last_num" = "$oldroot_num" ] || \
        fail "modo 'part': la root ($srcpart, partizione $oldroot_num) non è l'ultima del disco (ultima: $last_num) - non supportato, usare --mode net"

    srcdir=$(cmdline_get unitotem.srcdir); srcdir=${srcdir:-/root}
    mkdir -p /mnt/oldroot
    mount -t ext4 -o ro "$srcpart" /mnt/oldroot || fail "mount root sorgente fallito"
    [ -f "/mnt/oldroot$srcdir/unitotem-deploy.manifest" ] || fail "manifest non trovato in $srcpart:$srcdir"
    read_manifest_lines < "/mnt/oldroot$srcdir/unitotem-deploy.manifest"
    [ -n "${UNITOTEM_RAW_SIZE:-}" ] || fail "manifest incompleto"
    umount /mnt/oldroot

    run_e2fsck "$srcpart"
    minblocks=$(resize2fs -P "$srcpart" 2>/dev/null | awk -F': *' '/[Mm]inimum size/{print $2}')
    blocksize=$(dumpe2fs -h "$srcpart" 2>/dev/null | awk -F': *' '/Block size/{print $2}')
    [ -n "$minblocks" ] && [ -n "$blocksize" ] || fail "impossibile calcolare la dimensione minima del filesystem sorgente"
    minbytes=$((minblocks * blocksize))
    newsize_bytes=$((minbytes + minbytes / 5 + 200 * 1024 * 1024))   # +20% + 200MiB margin

    root_start_sec=$(parted -sm "$DISK" unit s print 2>/dev/null \
        | awk -F: -v n="$oldroot_num" '$1==n{gsub("s","",$2); print $2}')
    disk_total_sec=$(parted -sm "$DISK" unit s print 2>/dev/null \
        | awk -F: 'NR==2{gsub("s","",$2); print $2}')
    table=$(parted -sm "$DISK" print 2>/dev/null | awk -F: 'NR==2{print $6}')
    [ -n "$root_start_sec" ] && [ -n "$disk_total_sec" ] || fail "impossibile leggere la tabella delle partizioni di $DISK"

    newsize_sec=$(((newsize_bytes + 511) / 512))
    root_end_sec=$((root_start_sec + newsize_sec - 1))

    # The staging partition must start at or beyond the last sector `dd`
    # will overwrite (RAW_SIZE) - never merely "after the shrunk root".
    # Root is typically tiny next to a 12GiB image, so root_end_sec sits
    # well inside that range; parking staging right after root would put
    # it *under* the write head, corrupting the still-being-read source
    # mid-copy as dd catches up to it. When root is large enough that it
    # already extends past the boundary on its own, this is a no-op (stays
    # at root_end_sec+1, same as before).
    write_boundary_sec=$(((UNITOTEM_RAW_SIZE + 511) / 512))
    stage_start_sec=$((root_end_sec + 1))
    [ "$stage_start_sec" -ge "$write_boundary_sec" ] || stage_start_sec=$write_boundary_sec

    # Free space check BEFORE touching the partition table: the tail must
    # hold the compressed image plus margin, leaving 34 sectors for the GPT
    # backup header.
    avail_sec=$((disk_total_sec - stage_start_sec - 34))
    need_sec=$(((UNITOTEM_COMP_SIZE + 64 * 1024 * 1024 + 511) / 512))
    [ "$avail_sec" -ge "$need_sec" ] || \
        fail "spazio libero insufficiente dopo lo shrink (${avail_sec}s disponibili, ${need_sec}s necessari) - usare --mode net"

    resize2fs "$srcpart" "$((newsize_bytes / 1024))K" || fail "resize2fs (shrink) fallito"

    case "$table" in
        gpt)
            sgdisk -d "$oldroot_num" "$DISK" || fail "sgdisk -d fallito"
            sgdisk -n "${oldroot_num}:${root_start_sec}:${root_end_sec}" \
                   -t "${oldroot_num}:8300" -c "${oldroot_num}:ROOT" "$DISK" \
                || fail "sgdisk (shrink root) fallito"
            stage_num=$(( $(sgdisk -p "$DISK" 2>/dev/null | awk '$1 ~ /^[0-9]+$/{n=$1} END{print n+0}') + 1 ))
            sgdisk -n "${stage_num}:${stage_start_sec}:0" -t "${stage_num}:8300" -c "${stage_num}:UNISTAGE" "$DISK" \
                || fail "sgdisk (staging) fallito"
            ;;
        msdos)
            [ "$oldroot_num" -le 4 ] || fail "root su partizione logica: modo 'part' non supportato su questa tabella MBR"
            parted -s "$DISK" rm "$oldroot_num" || fail "parted rm fallito"
            parted -s "$DISK" unit s mkpart primary ext4 "${root_start_sec}s" "${root_end_sec}s" \
                || fail "parted mkpart (root) fallito"
            stage_num=$(parted -sm "$DISK" print 2>/dev/null | awk -F: '$1 ~ /^[0-9]+$/{n=$1} END{print n+1}')
            [ "$stage_num" -le 4 ] || fail "tabella MBR piena: nessuno slot per la partizione di staging, usare --mode net"
            parted -s "$DISK" unit s mkpart primary ext4 "${stage_start_sec}s" "100%" \
                || fail "parted mkpart (staging) fallito"
            ;;
        *)
            fail "tabella delle partizioni non riconosciuta su $DISK: '$table'"
            ;;
    esac

    partprobe "$DISK" 2>/dev/null || true
    partx -u "$DISK" 2>/dev/null || true
    udevadm settle --timeout=5 2>/dev/null || true

    stage_part=$(pdev_target "$DISK" "$stage_num")
    [ -b "$stage_part" ] || fail "partizione di staging non trovata: $stage_part"
    mkfs.ext4 -F -L UNISTAGE "$stage_part" || fail "mkfs.ext4 (staging) fallito"

    mkdir -p /mnt/oldroot /mnt/stage
    mount -t ext4 -o ro "$srcpart"  /mnt/oldroot || fail "mount root sorgente (post-shrink) fallito"
    mount -t ext4 "$stage_part"     /mnt/stage   || fail "mount staging fallito"

    log "Copio l'immagine nella partizione di staging..."
    cp "/mnt/oldroot$srcdir/$(basename "$UNITOTEM_IMAGE_NAME")" /mnt/stage/image.raw \
        || fail "copia immagine in staging fallita"

    umount /mnt/oldroot   # "smonta le altre partizioni" prima di procedere alla scrittura

    STREAM_CMD="cat /mnt/stage/image.raw"
}

# ---------------------------------------------------------------------------
# Mode: net - receive over netcat (listen or connect-back), decompressing
# and writing to disk as the stream arrives. The manifest header is peeled
# off the SAME stream via a FIFO so the raw-size safety check still runs
# before any byte reaches dd.
# ---------------------------------------------------------------------------
setup_network() {
    local cfg="$1" iface ipcidr gw
    iface=$(cmdline_get unitotem.netiface || true)
    [ -n "$iface" ] || iface=$(ip -o link show 2>/dev/null | awk -F': ' '$2!="lo"{print $2; exit}')
    [ -n "$iface" ] || fail "nessuna interfaccia di rete trovata"

    ip link set "$iface" up || fail "impossibile attivare l'interfaccia $iface"
    udevadm settle --timeout=5 2>/dev/null || true
    sleep 2

    if [ "$cfg" = dhcp ]; then
        udhcpc -i "$iface" -n -q -t 10 -s /etc/udhcpc/unitotem.script || fail "DHCP fallito su $iface"
    else
        ipcidr=$(echo "$cfg" | cut -d, -f1)
        gw=$(echo "$cfg"     | cut -d, -f2)
        [ -n "$ipcidr" ] || fail "unitotem.netcfg non valido: $cfg"
        ip addr add "$ipcidr" dev "$iface" || fail "assegnazione IP statico fallita"
        if [ -n "$gw" ]; then
            ip route add default via "$gw" dev "$iface" || warn "impossibile impostare il gateway"
        fi
    fi
    log "Rete pronta su $iface"
}

do_net_prepare() {
    local netmode addr port cfg
    netmode=$(cmdline_get unitotem.netmode); netmode=${netmode:-listen}
    addr=$(cmdline_get unitotem.netaddr || true)
    port=$(cmdline_get unitotem.netport); port=${port:-9700}
    cfg=$(cmdline_get unitotem.netcfg);   cfg=${cfg:-dhcp}

    setup_network "$cfg"

    case "$netmode" in
        listen)  STREAM_CMD="nc -l -p $port" ;;
        connect) [ -n "$addr" ] || fail "unitotem.netaddr richiesto in modalità connect"
                 STREAM_CMD="nc $addr $port" ;;
        *)       fail "unitotem.netmode non valido: $netmode" ;;
    esac
    log "In attesa dei dati (modo $netmode, porta $port)..."
}

write_image_net() {
    local fifo=/tmp/unitotem-net.fifo line key val disksize
    mkfifo "$fifo"
    eval "$STREAM_CMD" > "$fifo" &
    local ncpid=$!
    exec 9< "$fifo"

    while IFS= read -r -u9 -t 900 line; do
        if [ -z "$line" ]; then break; fi
        key=${line%%=*}; val=${line#*=}
        case "$key" in
            UNITOTEM_ARCH|UNITOTEM_COMP|UNITOTEM_RAW_SIZE|UNITOTEM_COMP_SIZE|\
            UNITOTEM_COMP_SHA256|UNITOTEM_IMAGE_NAME|UNITOTEM_DATA_PART|UNITOTEM_HAS_ESP)
                case "$val" in *[!A-Za-z0-9_.-]*) continue ;; esac
                eval "$key=\"\$val\""
                ;;
        esac
    done
    [ -n "${UNITOTEM_RAW_SIZE:-}" ] || fail "connessione di rete interrotta o header non ricevuto"

    disksize=$(blockdev --getsize64 "$DISK")
    [ "$disksize" -ge "$UNITOTEM_RAW_SIZE" ] || fail "disco troppo piccolo: $DISK ha $disksize byte, servono $UNITOTEM_RAW_SIZE"

    log "Ricevo e scrivo su $DISK ($UNITOTEM_RAW_SIZE byte, immagine ${UNITOTEM_IMAGE_NAME:-?})..."
    decompress_pipe <&9 | dd of="$DISK" bs=4M conv=fsync oflag=direct \
        || fail "ricezione/scrittura in rete fallita"
    exec 9<&-
    wait "$ncpid" 2>/dev/null || true
    rm -f "$fifo"
}

write_image_direct() {
    local disksize
    disksize=$(blockdev --getsize64 "$DISK")
    [ "$disksize" -ge "$UNITOTEM_RAW_SIZE" ] || fail "disco troppo piccolo: $DISK ha $disksize byte, servono $UNITOTEM_RAW_SIZE"

    log "Scrittura su $DISK ($UNITOTEM_RAW_SIZE byte, immagine ${UNITOTEM_IMAGE_NAME:-?})..."
    eval "$STREAM_CMD" | decompress_pipe | dd of="$DISK" bs=4M conv=fsync oflag=direct \
        || fail "scrittura dd fallita"
}

# ---------------------------------------------------------------------------
# Post-flash: repair the GPT (backup header belongs at the real end of the
# disk now, not at 12GiB) and grow the last partition (DATA) to fill the
# rest. Best-effort: a failure here leaves a working, just not fully
# expanded, system - warn and move on rather than treating it as fatal.
# ---------------------------------------------------------------------------
post_flash_expand() {
    local expand data_num data_start data_dev
    expand=$(cmdline_get unitotem.expand); expand=${expand:-1}
    [ "$expand" = 1 ] || { log "Espansione DATA disabilitata (unitotem.expand=0)"; return 0; }

    log "Riparo la GPT ed espando la partizione DATA..."
    sgdisk -e "$DISK" 2>/dev/null || warn "sgdisk -e fallito (continuo con l'header di backup nella posizione originale)"
    partprobe "$DISK" 2>/dev/null || true
    partx -u "$DISK" 2>/dev/null || true
    udevadm settle --timeout=5 2>/dev/null || true

    data_num="$UNITOTEM_DATA_PART"
    data_start=$(sgdisk -p "$DISK" 2>/dev/null | awk -v n="$data_num" '$1==n{print $2}')
    if [ -z "$data_start" ]; then
        warn "impossibile leggere l'inizio della partizione DATA, salto l'espansione"
        return 0
    fi

    if ! sgdisk -d "$data_num" "$DISK" 2>/dev/null || \
       ! sgdisk -n "${data_num}:${data_start}:0" -t "${data_num}:8300" -c "${data_num}:DATA" "$DISK" 2>/dev/null
    then
        warn "espansione della partizione DATA fallita, resta alla dimensione originale"
        return 0
    fi

    partprobe "$DISK" 2>/dev/null || true
    partx -u "$DISK" 2>/dev/null || true
    udevadm settle --timeout=5 2>/dev/null || true

    data_dev=$(pdev_target "$DISK" "$data_num")
    e2fsck -fy "$data_dev" >/dev/null 2>&1 || true
    resize2fs "$data_dev" >/dev/null 2>&1 || warn "resize2fs su DATA fallito (il sistema resta comunque avviabile)"
}

# ---------------------------------------------------------------------------
# Boot entry: make the freshly-written image the one that actually boots.
# ---------------------------------------------------------------------------
mount_new_system() {
    local root_dev
    root_dev=$(blkid -L ROOT 2>/dev/null)
    [ -n "$root_dev" ] || fail "partizione ROOT non trovata dopo la scrittura"
    mkdir -p /mnt
    mount -t ext4 "$root_dev" /mnt || fail "mount ROOT (nuovo sistema) fallito"
    mkdir -p /mnt/boot
    if [ "$UNITOTEM_HAS_ESP" = 1 ]; then
        mount -t ext4 "$(blkid -L BOOT)" /mnt/boot || fail "mount BOOT fallito"
        mkdir -p /mnt/boot/efi
        mount -t vfat "$(blkid -L EFI)" /mnt/boot/efi || fail "mount EFI fallito"
    fi
}

umount_new_system() {
    umount -lf /mnt/boot/efi 2>/dev/null || true
    umount -lf /mnt/boot     2>/dev/null || true
    umount -lf /mnt/dev      2>/dev/null || true
    umount -lf /mnt/proc     2>/dev/null || true
    umount -lf /mnt/sys      2>/dev/null || true
    umount -lf /mnt          2>/dev/null || true
}

install_bootloader_uefi() {
    mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>/dev/null || true
    mount_new_system
    if [ ! -f /mnt/boot/efi/EFI/BOOT/BOOTX64.EFI ]; then
        warn "EFI/BOOT/BOOTX64.EFI assente sull'immagine scritta, salto efibootmgr"
        umount_new_system
        return 0
    fi

    for n in $(efibootmgr 2>/dev/null | grep -E '^Boot[0-9A-Fa-f]{4}\*? UniTotem$' | cut -c5-8); do
        efibootmgr -Bb "$n" >/dev/null 2>&1 || true
    done

    if efibootmgr -c -d "$DISK" -p 1 -L "UniTotem" -l '\EFI\BOOT\BOOTX64.EFI' >/tmp/efiout 2>&1; then
        newnum=$(grep -E '^Boot[0-9A-Fa-f]{4}\*? UniTotem$' /tmp/efiout | cut -c5-8 | head -1)
        [ -n "$newnum" ] || newnum=$(efibootmgr 2>/dev/null | grep -E '^Boot[0-9A-Fa-f]{4}\*? UniTotem$' | cut -c5-8 | head -1)
        if [ -n "$newnum" ]; then
            others=$(efibootmgr 2>/dev/null | grep -E '^Boot[0-9A-Fa-f]{4} ' | cut -c5-8 | grep -v "^${newnum}$" | paste -sd, -)
            efibootmgr -o "${newnum}${others:+,$others}" >/dev/null 2>&1 \
                || warn "impossibile reimpostare il BootOrder (l'avvio removable resta comunque valido)"
        fi
    else
        cat /tmp/efiout
        warn "efibootmgr -c fallito (NVRAM piena o non scrivibile?) - l'immagine resta avviabile come dispositivo removable"
    fi
    umount_new_system
}

install_bootloader_bios() {
    mount_new_system
    mount --bind /dev  /mnt/dev
    mount --bind /proc /mnt/proc
    mount --bind /sys  /mnt/sys
    if ! chroot /mnt grub-install --target=i386-pc --boot-directory=/boot "$DISK" >/tmp/griout 2>&1; then
        cat /tmp/griout
        umount_new_system
        fail "grub-install --target=i386-pc fallito: l'immagine non ha il supporto BIOS (vedi Prerequisito nella documentazione di deploy)"
    fi
    umount_new_system
}

install_bootloader() {
    case "$FIRMWARE" in
        uefi) install_bootloader_uefi ;;
        bios) install_bootloader_bios ;;
        rpi)  log "Raspberry Pi: nessuna voce di boot da installare, il firmware legge direttamente config.txt/cmdline.txt" ;;
        *)    warn "firmware sconosciuto ($FIRMWARE), salto l'installazione della voce di boot" ;;
    esac
}

# ---------------------------------------------------------------------------
main() {
    udevadm settle --timeout=10 2>/dev/null || true
    # Every "mount" call below passes an explicit -t, which is the real
    # fix (confirmed in testing: without -t, this initrd's mount never
    # triggered the ext4 autoload and failed with a misleading ENOENT even
    # though both the source device and the mountpoint existed) - this is
    # just belt-and-suspenders so the modules are already resident.
    modprobe ext4 2>/dev/null || true
    modprobe vfat 2>/dev/null || true

    local mode disk_id
    mode=$(cmdline_get unitotem.mode || true)
    disk_id=$(cmdline_get unitotem.disk || true)
    FIRMWARE=$(cmdline_get unitotem.firmware || true)
    BOOTDISK_ID=$(cmdline_get unitotem.bootdisk || true)
    BOOTPART=$(cmdline_get unitotem.bootpart || true)
    DEBUG=$(cmdline_get unitotem.debug || true); DEBUG=${DEBUG:-0}

    if ! cmdline_get unitotem.flash >/dev/null; then
        # Not armed for a flash - leave the boot alone (shouldn't normally
        # happen, this initrd is only ever chainloaded with the flag set).
        exit 0
    fi

    [ -n "$mode" ] && [ -n "$disk_id" ] && [ -n "$FIRMWARE" ] || fail "parametri unitotem.* incompleti (mode/disk/firmware)"

    DISK=$(resolve_disk "$disk_id")
    log "Target: $DISK (modo=$mode firmware=$FIRMWARE)"

    case "$mode" in
        ram)
            do_ram
            write_image_direct
            ;;
        part)
            do_part_stage
            write_image_direct
            ;;
        net)
            do_net_prepare
            write_image_net
            ;;
        *)
            fail "unitotem.mode non valido: $mode"
            ;;
    esac

    log "Immagine scritta. Verifico e completo l'installazione..."
    sync
    blockdev --flushbufs "$DISK" 2>/dev/null || true
    partprobe "$DISK" 2>/dev/null || true
    partx -u "$DISK" 2>/dev/null || true
    udevadm settle --timeout=10 2>/dev/null || true

    # NOTE: blkid -L is disk-agnostic - if another UniTotem disk is attached
    # this can pick the wrong one. Known limitation, matches the rest of the
    # image's own label-based design (see kiosk/files/fstab-*).
    blkid -L ROOT >/dev/null 2>&1 && blkid -L DATA >/dev/null 2>&1 \
        || fail "verifica post-scrittura fallita: partizioni ROOT/DATA non trovate su $DISK"

    post_flash_expand
    install_bootloader

    log "Flash completato con successo. Riavvio."
    sync
    sleep 2
    reboot -f
    sleep 30
}

main "$@"
