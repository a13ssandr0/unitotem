FROM debian:bookworm

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        debootstrap \
        qemu-user-static \
        dosfstools \
        e2fsprogs \
        gdisk \
        parted \
        kpartx \
        util-linux \
        xz-utils \
        pigz \
        curl \
        ca-certificates \
        wget \
        gnupg2 \
        rsync \
        git \
        partclone \
        device-tree-compiler \
        initramfs-tools-core \
        cpio \
    && rm -rf /var/lib/apt/lists/*

COPY kiosk/ /kiosk/
COPY deploy/ota-engine.sh /kiosk/files/ota-engine.sh
COPY deploy/parts-lib.sh /kiosk/deploy-parts-lib.sh
RUN chmod +x /kiosk/*.sh /kiosk/files/ota-engine.sh /kiosk/deploy-parts-lib.sh

VOLUME ["/work", "/deploy"]
