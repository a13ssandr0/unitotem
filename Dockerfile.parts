FROM debian:bookworm

ARG DEBIAN_FRONTEND=noninteractive

# No qemu-user-static: partclone reads/writes filesystem content, not target code, so one
# container generates parts sets for both amd64 and arm64. bookworm, because the partclone
# version must match the one deploy/ota-engine.sh restores with (installed by
# unitotem/stage1-packages.sh).
RUN apt-get update && apt-get install -y --no-install-recommends \
        partclone \
        xz-utils \
        util-linux \
        fdisk \
        parted \
        e2fsprogs \
        dosfstools \
        coreutils \
        gdisk \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/parts-lib.sh /parts/parts-lib.sh
COPY deploy/make-parts-image.sh /parts/make-parts-image.sh
RUN chmod +x /parts/*.sh

VOLUME ["/scratch", "/deploy"]
