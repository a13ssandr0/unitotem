FROM debian:bookworm

ARG DEBIAN_FRONTEND=noninteractive

# zstd is needed on the build host: trixie's initramfs-tools defaults to COMPRESS=zstd, and
# stage3's boot-ability check must decompress the target initramfs.
RUN apt-get update && apt-get install -y --no-install-recommends \
        debootstrap \
        qemu-user-static \
        dosfstools \
        e2fsprogs \
        gdisk \
        parted \
        kpartx \
        util-linux \
        xz-utils \
        pigz \
        aria2 \
        zstd \
        curl \
        ca-certificates \
        wget \
        gnupg2 \
        rsync \
        git \
        partclone \
        device-tree-compiler \
        initramfs-tools-core \
        cpio \
        python3 \
    && rm -rf /var/lib/apt/lists/*

COPY unitotem/ /unitotem/
COPY deploy/ota-engine.sh /unitotem/files/ota-engine.sh
COPY deploy/parts-lib.sh /unitotem/deploy-parts-lib.sh
COPY tools/pkglock.py /unitotem/pkglock.py
RUN chmod +x /unitotem/*.sh /unitotem/files/ota-engine.sh /unitotem/deploy-parts-lib.sh /unitotem/pkglock.py

VOLUME ["/work", "/deploy"]
