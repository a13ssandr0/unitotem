FROM debian:bookworm

ARG DEBIAN_FRONTEND=noninteractive

# zstd: needed on the BUILD host, not inside the target chroot - trixie's
# initramfs-tools defaults to COMPRESS=zstd (bookworm was gzip), and
# unitotem/stage3-image.sh's own boot-ability check now has to be able to
# decompress whatever the target image actually produced to verify it.
RUN apt-get update && apt-get install -y --no-install-recommends \
        debootstrap \
        qemu-user-static \
        dosfstools \
        e2fsprogs \
        gdisk \
        parted \
        kpartx \
        util-linux \
        xz-utils \
        pigz \
        aria2 \
        zstd \
        curl \
        ca-certificates \
        wget \
        gnupg2 \
        rsync \
        git \
        partclone \
        device-tree-compiler \
        initramfs-tools-core \
        cpio \
    && rm -rf /var/lib/apt/lists/*

COPY unitotem/ /unitotem/
COPY deploy/ota-engine.sh /unitotem/files/ota-engine.sh
COPY deploy/parts-lib.sh /unitotem/deploy-parts-lib.sh
COPY tools/pkglock.py /unitotem/pkglock.py
RUN chmod +x /unitotem/*.sh /unitotem/files/ota-engine.sh /unitotem/deploy-parts-lib.sh /unitotem/pkglock.py

VOLUME ["/work", "/deploy"]
