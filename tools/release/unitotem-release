#!/usr/bin/env python3
"""Host-side release tooling: key generation, key-list signing, release assembly.

Signatures are raw Ed25519 produced/checked with `openssl pkeyutl -rawin`, so the
device needs nothing beyond the openssl it already ships. See AB-DESIGN.md
(release and signing keys).

  keygen      --dir D --name N            private key N.key (0600) + public N.pub
  sign-keys   --root-key K --pub P [--pub P ...] --seq N --out keys.json
  build-ab    --image IMG --version V --release-key K --keys-json F --out DIR [--channel ...]
              (A/B layout: ROOT_A of a raw image -> root.ext4.pc.xz, role=root)
  build       --parts DIR --version V --release-key K --keys-json F --out DIR [--channel stable|beta]
"""
import argparse, hashlib, json, os, shutil, subprocess, sys, time


def run(*cmd):
    subprocess.run(cmd, check=True)


def sign(key, path):
    run("openssl", "pkeyutl", "-sign", "-inkey", key, "-rawin", "-in", path, "-out", path + ".sig")


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def key_id(pub_pem_path):
    der = subprocess.run(["openssl", "pkey", "-pubin", "-in", pub_pem_path, "-outform", "DER"],
                         check=True, capture_output=True).stdout
    return hashlib.sha256(der).hexdigest()[:16]


def cmd_keygen(a):
    os.makedirs(a.dir, exist_ok=True)
    priv, pub = (os.path.join(a.dir, a.name + e) for e in (".key", ".pub"))
    if os.path.exists(priv):
        sys.exit(f"{priv} already exists: not overwriting it")
    old = os.umask(0o077)
    try:
        run("openssl", "genpkey", "-algorithm", "ED25519", "-out", priv)
    finally:
        os.umask(old)
    run("openssl", "pkey", "-in", priv, "-pubout", "-out", pub)
    print(f"{priv}\n{pub}  id={key_id(pub)}")


def cmd_sign_keys(a):
    keys = [{"id": key_id(p), "pub": open(p).read()} for p in a.pub]
    doc = {"schema": 1, "seq": a.seq, "keys": keys}
    with open(a.out, "w") as f:
        json.dump(doc, f, indent=1, sort_keys=True)
    sign(a.root_key, a.out)
    print(f"{a.out} (+.sig), {len(keys)} keys, seq={a.seq}")


def cmd_build(a):
    tag = "v" + a.version
    out = os.path.join(a.out, tag)
    os.makedirs(out, exist_ok=True)
    parts = []
    for name in sorted(os.listdir(a.parts)):
        src = os.path.join(a.parts, name)
        if name == "SHA256SUMS" or not os.path.isfile(src):
            continue
        dst = os.path.join(out, name)
        try:
            os.link(src, dst)
        except OSError:
            shutil.copy2(src, dst)
        parts.append({"file": name, "size": os.path.getsize(dst), "sha256": sha256(dst)})
    meta = dict(l.split("=", 1) for l in open(os.path.join(a.parts, "parts.manifest"))
                if "=" in l and l.startswith("UNITOTEM_") and l.split("=")[0].count("_") >= 1)
    manifest = {
        "schema": 1, "version": a.version, "channel": a.channel,
        "arch": meta.get("UNITOTEM_ARCH", "").strip(),
        "layout": a.layout, "min_updater": 1,
        "built": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "parts": parts,
    }
    mpath = os.path.join(out, "manifest.json")
    with open(mpath, "w") as f:
        json.dump(manifest, f, indent=1, sort_keys=True)
    sign(a.release_key, mpath)
    shutil.copy2(a.keys_json, os.path.join(out, "keys.json"))
    shutil.copy2(a.keys_json + ".sig", os.path.join(out, "keys.json.sig"))
    if a.channel != "stable":
        open(os.path.join(out, "PRERELEASE"), "w").close()
    print(f"{out}: {len(parts)} assets, {sum(p['size'] for p in parts)/1e6:.0f} MB")


def cmd_build_ab(a):
    import tempfile
    tag = "v" + a.version
    out = os.path.join(a.out, tag)
    os.makedirs(out, exist_ok=True)
    info = subprocess.run(["sgdisk", "-i", "2", a.image], check=True, capture_output=True, text=True).stdout
    first = int(next(l for l in info.splitlines() if l.startswith("First sector")).split(":")[1].split()[0])
    last = int(next(l for l in info.splitlines() if l.startswith("Last sector")).split(":")[1].split()[0])
    name = next(l for l in info.splitlines() if l.startswith("Partition name")).split("'")[1]
    if name != "ROOT_A":
        sys.exit(f"partition 2 is '{name}', expected ROOT_A: not an A/B image")
    with tempfile.TemporaryDirectory(dir=a.out) as td:
        raw = os.path.join(td, "rootA.img")
        run("dd", f"if={a.image}", f"of={raw}", "bs=512", f"skip={first}", f"count={last - first + 1}", "status=none")
        ver = subprocess.run(["debugfs", "-R", "cat /usr/share/unitotem/release-version", raw],
                             capture_output=True, text=True).stdout.strip()
        if ver != a.version:
            sys.exit(f"the image reports version '{ver}', requested '{a.version}' (rebuild with RELEASE_VERSION={a.version})")
        # The stream must not announce itself as a bootable slot. partclone copies the label and UUID along
        # with the data, so a device that loses power half-way through writing it would otherwise carry a second
        # filesystem labelled ROOT_A (same UUID as the real slot A) - and "root=LABEL=ROOT_A" or GRUB's
        # `search --label` may then pick the half-written copy. A neutral label that nothing boots by closes
        # that window; unitotem-update gives the slot its real label and a fresh UUID once the write verified.
        import uuid
        # tune2fs -U refuses a filesystem that was not freshly checked (an image straight out of the build was
        # mounted after its last check). The extracted copy is ours: check it (exit 1 = fixed, which is fine).
        if subprocess.run(["e2fsck", "-fp", raw], capture_output=True).returncode > 1:
            sys.exit("e2fsck of the ROOT_A image failed")
        run("tune2fs", "-L", "ROOT_NEW", "-U", str(uuid.uuid4()), raw)
        dst = os.path.join(out, "root.ext4.pc.xz")
        with open(dst, "wb") as f:
            pc = subprocess.Popen(["partclone.extfs", "-c", "-L", "/dev/null", "-s", raw, "-o", "-"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            xz = subprocess.Popen(["xz", "-T0", "-6"], stdin=pc.stdout, stdout=f)
            pc.stdout.close()
            if xz.wait() or pc.wait():
                sys.exit("partclone/xz failed")
    parts = [{"file": "root.ext4.pc.xz", "role": "root", "size": os.path.getsize(dst), "sha256": sha256(dst)}]
    if a.arch == "arm64":
        # Raspberry: the slot's kernel/initramfs/dtbs/overlays live on the FAT partition (p1), in slota/.
        # Ship them as their own asset; the device re-targets cmdline.txt for the slot it installs them in.
        info1 = subprocess.run(["sgdisk", "-i", "1", a.image], check=True, capture_output=True, text=True).stdout
        f1 = int(next(l for l in info1.splitlines() if l.startswith("First sector")).split(":")[1].split()[0])
        l1 = int(next(l for l in info1.splitlines() if l.startswith("Last sector")).split(":")[1].split()[0])
        with tempfile.TemporaryDirectory(dir=a.out) as td:
            fat = os.path.join(td, "fw.img")
            run("dd", f"if={a.image}", f"of={fat}", "bs=512", f"skip={f1}", f"count={l1 - f1 + 1}", "status=none")
            os.makedirs(os.path.join(td, "x"))
            run("mcopy", "-s", "-n", "-i", fat, "::slota", os.path.join(td, "x"))
            bf = os.path.join(out, "bootfiles.tar.xz")
            with open(bf, "wb") as f:
                tr = subprocess.Popen(["tar", "--owner=0", "--group=0", "--numeric-owner", "-C", os.path.join(td, "x", "slota"), "-cf", "-", "."], stdout=subprocess.PIPE)
                xz2 = subprocess.Popen(["xz", "-T0", "-6"], stdin=tr.stdout, stdout=f); tr.stdout.close()
                if xz2.wait() or tr.wait():
                    sys.exit("tar/xz of the boot files failed")
        parts.append({"file": "bootfiles.tar.xz", "role": "bootfiles", "size": os.path.getsize(bf), "sha256": sha256(bf)})
    manifest = {"schema": 1, "version": a.version, "channel": a.channel, "arch": a.arch, "layout": 2, "min_updater": 1,
                "built": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "parts": parts}
    mpath = os.path.join(out, "manifest.json")
    with open(mpath, "w") as f:
        json.dump(manifest, f, indent=1, sort_keys=True)
    sign(a.release_key, mpath)
    shutil.copy2(a.keys_json, os.path.join(out, "keys.json"))
    shutil.copy2(a.keys_json + ".sig", os.path.join(out, "keys.json.sig"))
    if a.channel != "stable":
        open(os.path.join(out, "PRERELEASE"), "w").close()
    print(f"{out}: root.ext4.pc.xz {parts[0]['size']/1e6:.0f} MB")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(required=True)
    p = sp.add_parser("keygen"); p.add_argument("--dir", required=True); p.add_argument("--name", required=True); p.set_defaults(f=cmd_keygen)
    p = sp.add_parser("sign-keys"); p.add_argument("--root-key", required=True); p.add_argument("--pub", action="append", required=True)
    p.add_argument("--seq", type=int, required=True); p.add_argument("--out", required=True); p.set_defaults(f=cmd_sign_keys)
    p = sp.add_parser("build"); p.add_argument("--parts", required=True); p.add_argument("--version", required=True)
    p.add_argument("--release-key", required=True); p.add_argument("--keys-json", required=True); p.add_argument("--out", required=True)
    p.add_argument("--channel", default="stable", choices=["stable", "beta"]); p.add_argument("--layout", type=int, default=1)
    p.set_defaults(f=cmd_build)
    p = sp.add_parser("build-ab"); p.add_argument("--image", required=True); p.add_argument("--version", required=True)
    p.add_argument("--release-key", required=True); p.add_argument("--keys-json", required=True); p.add_argument("--out", required=True)
    p.add_argument("--channel", default="stable", choices=["stable", "beta"]); p.add_argument("--arch", default="amd64")
    p.set_defaults(f=cmd_build_ab)
    a = ap.parse_args(); a.f(a)


main()
