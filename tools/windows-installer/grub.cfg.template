# UniTotem OTA environment started from Windows (generated by Install-UniTotem.ps1).
set timeout=0
insmod part_gpt
insmod fat
search --no-floppy --file --set=root @DIR@/unitotem-vmlinuz
linux @DIR@/unitotem-vmlinuz nomodeset quiet loglevel=3 fbcon=font:TER16x32 unitotem.ota=1 console=tty0 console=ttyS0,115200@AUTHKEY@
initrd @DIR@/unitotem-initrd.img
boot
