FROM debian:bookworm

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        qemu-user-static \
        xz-utils \
        curl \
        ca-certificates \
        gnupg2 \
        cpio \
    && rm -rf /var/lib/apt/lists/*

COPY kiosk/common.sh /kiosk/common.sh
COPY deploy/flasher-image.sh /kiosk/flasher-image.sh
COPY deploy/flasher/ /kiosk/flasher/
RUN chmod +x /kiosk/flasher-image.sh /kiosk/flasher/hook /kiosk/flasher/unitotem-flash

VOLUME ["/work", "/deploy"]
